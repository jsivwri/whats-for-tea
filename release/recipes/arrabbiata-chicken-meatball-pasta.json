  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Prepare the garlic",
      "blocks": [
        "Boil the kettle. Peel and finely chop or grate the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "arrabbiata-chicken-meatball-pasta-1",
