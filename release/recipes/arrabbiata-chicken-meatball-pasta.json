      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Shape the meatballs",
      "blocks": [
        "Mix chicken mince, one third of the garlic, breadcrumbs, half the stock mix, salt and pepper. Shape into five meatballs per person."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "arrabbiata-chicken-meatball-pasta-2",
        "path": "media/arrabbiata-chicken-meatball-pasta-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of raw meatballs on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Brown the meatballs",
      "blocks": [
        "Heat olive oil in a wide pan on high. Fry the meatballs for 2 minutes each side until lightly browned. Set aside and keep the pan. Use two pans or cook in batches for three or more servings."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the meatballs",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "arrabbiata-chicken-meatball-pasta-3",
        "path": "media/arrabbiata-chicken-meatball-pasta-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of lightly browned chicken meatballs in pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Start the sauce",
      "blocks": [
        "Reduce the pan to medium. Add remaining garlic and chilli flakes and cook for 30 seconds. Add tomato paste and chopped tomatoes and cook 2–3 minutes until slightly reduced."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Start the sauce",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "arrabbiata-chicken-meatball-pasta-4",
        "path": "media/arrabbiata-chicken-meatball-pasta-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of red tomato sauce",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Cook the pasta and meatballs",
      "blocks": [
        "Add remaining stock mix, {{pasta-water}} boiled water, {{sugar}} sugar and the pasta. Stir in the browned meatballs and bring to a boil. Reduce to medium-low, cover and cook 12–15 minutes until the pasta is tender and chicken cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the pasta and meatballs",
          "seconds": [
            720,
            900
          ]
        }
      ],
