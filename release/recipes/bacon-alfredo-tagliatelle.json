      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Add the garlic",
      "blocks": [
        "Reboil the kettle. Peel and slice the garlic, add it to the bacon and cook for 1 minute without burning it."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Add the garlic",
          "seconds": [
            60
          ]
        }
      ],
