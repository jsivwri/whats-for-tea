  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get started",
      "blocks": [
        "Preheat the oven to 220°C / 200°C fan / gas mark 7. Bring a large saucepan of water with {{potato-salt}} salt to the boil.",
        "Chop the potatoes into 2 cm chunks, peeling first if you prefer. Trim the beans and peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "bangers-mash-leek-chive-1-sketch",
        "path": "media/bangers-mash-leek-chive-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Get started",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Roasting time",
      "blocks": [
        "Put the sausages on a baking tray. Toss the beans with a drizzle of oil, half the grated garlic, salt and pepper on a sheet of foil. Seal the foil into a parcel and add it to the tray.",
        "Roast on the middle shelf for 20–25 minutes until golden and cooked through. Turn the sausages halfway. Wash hands and equipment after handling raw meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the sausages and beans",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
      "image": {
        "id": "bangers-mash-leek-chive-2-sketch",
        "path": "media/bangers-mash-leek-chive-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Roasting time",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Make your mash",
      "blocks": [
        "Boil the potatoes for 15–20 minutes, until a knife slips through easily. Drain and return to the pan off the heat.",
        "Mash until smooth, adding a knob of butter and a splash of milk if available. Season with salt and pepper, cover and keep warm."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the potatoes",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "bangers-mash-leek-chive-3-sketch",
        "path": "media/bangers-mash-leek-chive-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Make your mash",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Finish the prep",
      "blocks": [
        "Roughly chop the chives. Trim the leek, removing the root and dark green leafy part, then halve lengthways and thinly slice."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "bangers-mash-leek-chive-4-sketch",
        "path": "media/bangers-mash-leek-chive-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Finish the prep",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make your leek and chive sauce",
      "blocks": [
        "Heat a drizzle of oil in a large saucepan over medium-high heat. Add the leek, season and cook for 4–6 minutes until softened, stirring occasionally. Add the remaining garlic and fry for 1 minute.",
        "Add the crème fraîche, chicken stock paste, chives and {{sauce-water}} water. Simmer for 2–3 minutes and season with pepper."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the leek",
          "seconds": [
            240,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "bangers-mash-leek-chive-5-sketch",
        "path": "media/bangers-mash-leek-chive-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Make your leek and chive sauce",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Spring has sprung",
      "blocks": [
        "Serve the sausages with the mash and roasted green beans. Drizzle over the leek and chive sauce."
      ],
      "notes": [],
      "timers": [],
