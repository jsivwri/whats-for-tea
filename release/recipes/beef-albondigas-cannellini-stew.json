  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the garlic and mix the mince",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Wrap half the unpeeled garlic with a drizzle of oil in foil and roast for 10–12 minutes until soft. Peel and grate or press the rest. Mix the spice and herb blend, breadcrumbs, {{crumb-salt}} salt, {{crumb-water}} water, beef, pepper and half the grated garlic."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the garlic",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "beef-albondigas-cannellini-stew-1-sketch",
        "path": "media/beef-albondigas-cannellini-stew-1-sketch.webp",
        "alt": "Roast the garlic and mix the mince",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Bake the meatballs and toast the ciabatta",
      "blocks": [
        "Shape into five even meatballs per serving. Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through. Slice the ciabatta 1 cm thick, drizzle with olive oil and season. Bake on a tray on the middle shelf for 8–10 minutes until golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        },
        {
          "id": "timer-2",
          "label": "Toast the ciabatta",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "beef-albondigas-cannellini-stew-2-sketch",
        "path": "media/beef-albondigas-cannellini-stew-2-sketch.webp",
        "alt": "Bake the meatballs and toast the ciabatta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the tomatoes and beans",
      "blocks": [
        "Drain and rinse the beans. Halve, peel and thinly slice the red onion. Halve the tomatoes and grate the flesh into a bowl, discarding the skins. Add {{tomato-oil}} olive oil, {{tomato-sugar}} sugar, salt and pepper. Set aside. Heat oil in a large frying pan over medium-high. Fry the onion for 4–5 minutes until the onion softens."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the onion",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "beef-albondigas-cannellini-stew-3-sketch",
        "path": "media/beef-albondigas-cannellini-stew-3-sketch.webp",
        "alt": "Prepare the tomatoes and beans",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Simmer the beans",
      "blocks": [
        "Add paprika and the remaining grated garlic to the onion and fry for 1 minute. Add the vinegar and let it evaporate for 30 seconds. Stir in the beans, passata, red wine stock paste, {{sugar}} sugar and {{sauce-water}} water. Bring to a boil and simmer for 4–5 minutes until thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bean stew",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "beef-albondigas-cannellini-stew-4-sketch",
        "path": "media/beef-albondigas-cannellini-stew-4-sketch.webp",
        "alt": "Simmer the beans",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the stew and tomato topping",
      "blocks": [
        "Squeeze the cooled roast garlic out of its skin, mash and stir into the grated tomato. Add the cooked meatballs to the beans and simmer for 2–3 more minutes. Season and thin with a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the meatballs in the stew",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "beef-albondigas-cannellini-stew-5-sketch",
        "path": "media/beef-albondigas-cannellini-stew-5-sketch.webp",
        "alt": "Finish the stew and tomato topping",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Spoon the grated tomato onto the toast. Divide the stew between bowls, top with rocket and drizzle with olive oil. Serve the pan con tomate alongside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "beef-albondigas-cannellini-stew-6-sketch",
        "path": "media/beef-albondigas-cannellini-stew-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
