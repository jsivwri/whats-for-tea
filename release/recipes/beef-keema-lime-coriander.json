  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Brown the onions and beef",
      "blocks": [
        "Peel and finely slice the onion. Heat a drizzle of oil in a wide pan with a matching lid over medium-high heat. Add the onion with a pinch of salt and sugar and fry for about 3 minutes until it starts to soften. Increase the heat to high and fry the beef mince for another 4–5 minutes, breaking it up with a wooden spoon."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the onion",
          "seconds": [
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Brown the beef",
          "seconds": [
            240,
            300
          ]
        }
      ],
