    {
      "number": 3,
      "id": "step-3",
      "heading": "Add the carrots and aromatics",
      "blocks": [
        "Stir the carrots, ginger and garlic into the beef and cook for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
