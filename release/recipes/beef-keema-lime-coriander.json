        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Divide the keema between bowls, scatter with the reserved coriander leaves and serve with lime wedges."
      ],
