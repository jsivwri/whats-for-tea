      "steps": [
        {
          "id": "step-1",
          "number": 1,
          "heading": "Roast the aubergine",
          "blocks": [
            "Preheat the oven to 220°C / 200°C fan / gas mark 7. Grate the cheese. Peel and grate or press the garlic.",
            "Trim the aubergine and cut it into rounds about 1 cm thick. Toss on a large tray with a drizzle of oil, mixed herbs, salt and pepper. Spread in one layer.",
            "Roast on the top shelf for 20–25 minutes, turning halfway, until soft and golden."
          ],
          "notes": [],
          "timers": [
            {
              "id": "timer-1",
              "label": "Roast aubergine",
              "seconds": [
                1200,
                1500
              ]
            }
          ],
          "image": {
            "id": "beef-moussaka-1",
            "path": "media/beef-moussaka-1.webp",
            "width": 620,
            "height": 371,
            "alt": "Card photograph for step 1",
            "credit": "Green Chef recipe card"
          }
        },
        {
          "id": "step-2",
          "number": 2,
          "heading": "Boil the potatoes",
          "blocks": [
            "Meanwhile, boil a large saucepan of water with {{potato-salt}} salt. Peel the potato and slice into 1 cm rounds.",
            "Simmer the slices for 8–12 minutes, until you can slip a knife through easily. Drain in a colander and set aside."
          ],
          "notes": [],
          "timers": [
            {
              "id": "timer-1",
              "label": "Simmer potatoes",
              "seconds": [
                480,
                720
              ]
            }
          ],
          "image": {
            "id": "beef-moussaka-2",
            "path": "media/beef-moussaka-2.webp",
            "width": 620,
            "height": 406,
            "alt": "Card photograph for step 2",
            "credit": "Green Chef recipe card"
          },
          "quantities": {
            "potato-salt": {
              "2": "½ tsp",
              "4": "½ tsp"
            }
          }
        },
        {
          "id": "step-3",
          "number": 3,
          "heading": "Brown the pork",
          "blocks": [
            "Heat a drizzle of oil in a large frying pan over medium-high heat. Fry the porkmince for 5–6 minutes until browned, breaking it up with a spoon. Season with salt and pepper."
          ],
          "notes": [
            "Wash hands and equipment after handling raw meat. It is cooked when there is no pink in the middle. The card uses the same browning method for pork mince."
          ],
          "timers": [
            {
              "id": "timer-1",
              "label": "Brown mince",
              "seconds": [
                300,
                360
              ]
            }
          ],
          "image": {
            "id": "beef-moussaka-3",
            "path": "media/beef-moussaka-3.webp",
            "width": 620,
            "height": 388,
            "alt": "Card photograph for step 3",
            "credit": "Green Chef recipe card"
          }
        },
        {
          "id": "step-4",
          "number": 4,
          "heading": "Finish the sauce",
          "blocks": [
            "When the porkis cooked, stir in the garlic for 30 seconds.",
            "Add the passata, cinnamon, beef stock paste, {{line-12}} sugar and {{line-13}} water. Simmer for 4–5 minutes until slightly thickened.",
            "Remove the tender, golden aubergine from the oven and preheat the grill to high."
          ],
          "notes": [],
          "timers": [
            {
              "id": "garlic",
              "label": "Cook garlic",
              "seconds": [
                30
              ]
            },
            {
              "id": "timer-1",
              "label": "Thicken sauce",
              "seconds": [
                240,
                300
              ]
            }
          ],
          "image": {
            "id": "beef-moussaka-4",
            "path": "media/beef-moussaka-4.webp",
            "width": 620,
            "height": 413,
            "alt": "Card photograph for step 4",
            "credit": "Green Chef recipe card"
          }
        },
        {
          "id": "step-5",
          "number": 5,
          "heading": "Layer and grill",
          "blocks": [
            "Spoon half the porkmixture into an ovenproof dish. Layer on the roasted aubergine, then the remaining porkmixture. Add the potato slices and spread over the crème fraîche.",
            "Scatter over the cheddar and season with pepper. Grill for 5–6 minutes until the cheese is golden and bubbling.",
            "Meanwhile put rocket on the serving plates, drizzle with olive oil and season with salt and pepper."
          ],
          "notes": [],
          "timers": [
            {
              "id": "timer-1",
              "label": "Grill the topping",
              "seconds": [
                300,
                360
              ]
            }
          ],
          "image": {
            "id": "beef-moussaka-5",
            "path": "media/beef-moussaka-5.webp",
            "width": 620,
            "height": 458,
            "alt": "Card photograph for step 5",
            "credit": "Green Chef recipe card"
          }
        },
        {
          "id": "step-6",
          "number": 6,
          "heading": "Serve the moussaka",
          "blocks": [
            "Divide the porkmoussaka between the plates and serve with the rocket salad."
          ],
          "notes": [],
          "timers": [],
          "image": {
            "id": "beef-moussaka-6",
            "path": "media/beef-moussaka-6.webp",
            "width": 620,
            "height": 466,
            "alt": "Card photograph for step 6",
            "credit": "Green Chef recipe card"
          }
        }
      ]
    }
