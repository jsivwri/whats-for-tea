  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Boil a kettle. Peel and finely chop or grate the garlic. Peel and finely chop the onion. Peel, trim and finely dice the carrots. Grate the mushrooms."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "beef-mushroom-bolognese-1",
        "path": "media/beef-mushroom-bolognese-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped carrots onion and grated mushrooms on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Soften the vegetables",
      "blocks": [
        "Heat olive oil in a wide pan over medium-high heat. Add onion, carrot and mushrooms with salt and pepper and cook 3–4 minutes until starting to soften."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the vegetables",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "beef-mushroom-bolognese-2",
        "path": "media/beef-mushroom-bolognese-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of diced vegetables softening in a frying pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Brown the mince",
      "blocks": [
        "Add the mince and turn the heat up to high. Break it up with a spoon and cook 3–4 minutes until browned all over."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the mince",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "beef-mushroom-bolognese-3",
        "path": "media/beef-mushroom-bolognese-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of browned mince and vegetables in pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Cook the pasta",
      "blocks": [
        "Add the pasta to boiling salted water and cook 10–12 minutes until it has a slight bite. Drain, return it to the pot and reboil half a kettle."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the pasta",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "beef-mushroom-bolognese-4",
        "path": "media/beef-mushroom-bolognese-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of boiled tortiglioni pasta in colander",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Mix the stock",
      "blocks": [
        "Dissolve the beef stock mix and soy sauce in {{stock-water}} boiled water."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "beef-mushroom-bolognese-5",
        "path": "media/beef-mushroom-bolognese-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of glass jug of dark stock",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Simmer the bolognese",
      "blocks": [
        "Stir garlic and oregano into the mince for 1 minute. Add the chopped tomatoes and stock, season, bring to a boil and cook 4–5 minutes until thickened and the mince is cooked through with no pink remaining."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bolognese",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
