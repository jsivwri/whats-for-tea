  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the vegetables and set out the ingredients. If your casserole cannot go on the hob, start in a wide pan, then transfer to an ovenproof dish and cover tightly with foil."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Brown the beef",
      "blocks": [
        "Heat the oven to 200°C / 180°C fan / gas mark 6 and boil the kettle. Heat a little vegetable oil in a wide hob-safe casserole over high heat. Add the diced beef and cracked black pepper and cook for 2 minutes, until lightly browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the beef",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "beef-peposo-2",
        "path": "media/beef-peposo-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of diced beef browning in casserole",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Prepare the leek and garlic",
      "blocks": [
        "Halve the leeks lengthways, rinse away any grit, then trim and slice finely. Peel and finely chop or grate the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "beef-peposo-3",
        "path": "media/beef-peposo-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of sliced leek and chopped garlic on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Add the vegetables",
      "blocks": [
        "Stir {{flour}} flour and the garlic into the browned beef. Add the sliced leek."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "beef-peposo-4",
        "path": "media/beef-peposo-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of sliced leeks added to diced beef",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Bake the beef",
      "blocks": [
        "Add the red wine paste, tomato paste, beef stock mix, {{beef-water}} boiled water and bay leaves. Bring to a boil over high heat, cover and bake for 45–50 minutes, until the beef is tender and the sauce is rich."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the beef",
          "seconds": [
            2700,
            3000
          ]
        }
      ],
      "image": {
        "id": "beef-peposo-5",
        "path": "media/beef-peposo-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of beef and leeks in red wine stock with bay leaf",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Bake the saffron orzo",
      "blocks": [
        "After the beef has had 35 minutes, reboil the kettle. Mix the orzo and saffron with {{orzo-water}} boiled water in an ovenproof dish. Seal with foil and bake for 15–18 minutes until cooked."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the saffron orzo",
          "seconds": [
            900,
            1080
          ]
        }
      ],
      "image": {
        "id": "beef-peposo-6",
        "path": "media/beef-peposo-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of rectangular baking dish of yellow saffron orzo",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Rest and season",
      "blocks": [
        "Season the beef with salt and rest, covered, for 3–4 minutes. Discard the bay leaves. Mix a pinch of salt and a knob of butter through the orzo."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Rest and season",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "beef-peposo-7",
        "path": "media/beef-peposo-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of casserole with lid on",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve",
      "blocks": [
        "Spoon the peposo over the saffron butter orzo."
      ],
