  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the vegetables. Use a hob-safe ovenproof casserole with a lid, or start in a wide pan and transfer to an ovenproof dish."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Brown the beef",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil the kettle. Heat vegetable oil in the casserole over high heat and brown the beef for 2–3 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the beef",
          "seconds": [
            120,
            180
          ]
        }
      ],
