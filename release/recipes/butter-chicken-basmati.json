  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the rice",
      "blocks": [
        "Pour {{rice-water}} water into a medium saucepan with a tight-fitting lid. Stir in the rice and {{rice-salt}} salt and bring to the boil.",
        "Turn the heat down to medium, cover and cook for 10 minutes. Remove from the heat and leave covered for another 10 minutes or until ready to serve."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam the rice off the heat",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "butter-chicken-basmati-1-sketch",
        "path": "media/butter-chicken-basmati-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Cook the rice",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Build the flavour",
      "blocks": [
        "Peel and grate or press the garlic. Heat a drizzle of oil in a medium saucepan over medium-high heat. Cook the korma paste, tomato purée and garlic, stirring, for 1 minute until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "butter-chicken-basmati-2-sketch",
        "path": "media/butter-chicken-basmati-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Build the flavour",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Poach the chicken",
      "blocks": [
        "Pour in {{sauce-water}} water. Stir through the diced chicken, stock paste and {{sugar}} sugar. Bring to a boil, then simmer for 9–11 minutes until the chicken is cooked through and the sauce has thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the chicken",
          "seconds": [
            540,
            660
          ]
        }
      ],
      "image": {
        "id": "butter-chicken-basmati-3-sketch",
        "path": "media/butter-chicken-basmati-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Poach the chicken",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Butter and cream time",
      "blocks": [
        "Stir through the peas, crème fraîche and {{butter}} butter. Cook for 1–2 minutes until the butter melts and everything is piping hot."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Heat the peas and cream",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "butter-chicken-basmati-4-sketch",
        "path": "media/butter-chicken-basmati-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Butter and cream time",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Finishing touches",
      "blocks": [
        "Fluff the rice with a fork. Add a splash of water to the curry if it is too thick. Season with salt and pepper if needed."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "butter-chicken-basmati-5-sketch",
        "path": "media/butter-chicken-basmati-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Finishing touches",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve up",
      "blocks": [
        "Divide the rice between bowls and spoon over the butter chicken. Sprinkle with flaked almonds."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "butter-chicken-basmati-6-sketch",
