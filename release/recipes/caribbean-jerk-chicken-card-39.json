  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the wedges",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 2 cm wedges. Toss with oil, salt and pepper and spread in one layer on one or more baking trays. Roast on the top shelf for 25–35 minutes until golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the wedges",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "caribbean-jerk-chicken-card-39-1-sketch",
        "path": "media/caribbean-jerk-chicken-card-39-1-sketch.webp",
        "alt": "Roast the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Marinate the chicken",
      "blocks": [
        "Mix the thighs with the jerk seasoning, {{marinade-oil}} olive oil, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "caribbean-jerk-chicken-card-39-2-sketch",
        "path": "media/caribbean-jerk-chicken-card-39-2-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Roast the chicken",
      "blocks": [
        "Lay the chicken on a lined tray, drizzle with oil and season. Roast on the middle shelf for 16–18 minutes until browned and cooked through. With 5 minutes left, drizzle over the mango chutney and return to the oven."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken",
          "seconds": [
            960,
            1080
          ]
        },
        {
          "id": "timer-2",
          "label": "Set the mango glaze",
          "seconds": [
            300
          ]
        }
      ],
      "image": {
        "id": "caribbean-jerk-chicken-card-39-3-sketch",
        "path": "media/caribbean-jerk-chicken-card-39-3-sketch.webp",
        "alt": "Roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Dress the wedges",
      "blocks": [
        "Zest and wedge the limes. Mix the zest, {{honey}} honey and {{dressing-oil}} olive oil. Season to taste. Toss the wedges with the dressing for the last 5 minutes of roasting."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish the wedges",
          "seconds": [
            300
          ]
        }
      ],
      "image": {
        "id": "caribbean-jerk-chicken-card-39-4-sketch",
        "path": "media/caribbean-jerk-chicken-card-39-4-sketch.webp",
        "alt": "Dress the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the slaw",
      "blocks": [
        "Stir together the mayonnaise, {{sugar}} sugar and a squeeze of lime juice. Toss through the coleslaw mix. Taste and adjust the seasoning and lime juice. Stir in the rocket just before serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "caribbean-jerk-chicken-card-39-5-sketch",
        "path": "media/caribbean-jerk-chicken-card-39-5-sketch.webp",
        "alt": "Make the slaw",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the chicken among plates and spoon over any glaze left on the tray. Serve with wedges, slaw and any remaining lime wedges."
      ],
      "notes": [],
      "timers": [],
