  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the chips",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Cut the unpeeled potatoes into 1 cm chips. Toss with oil, salt and pepper and spread in one layer, using two trays if needed.",
        "Bake on the middle shelf for 30–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chips",
          "seconds": [
            1800,
            2100
          ]
