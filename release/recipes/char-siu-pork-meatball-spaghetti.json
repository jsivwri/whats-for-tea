  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get prepared",
      "blocks": [
        "Heat the oven to 220°C (200°C fan, gas 7). Bring a large saucepan of water with {{pasta-salt}} salt to a boil for the spaghetti. Peel and grate or press the garlic.",
        "Mix the breadcrumbs with {{crumb-salt}} salt, {{crumb-water}} water and half the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "char-siu-pork-meatball-spaghetti-1-sketch",
        "path": "media/char-siu-pork-meatball-spaghetti-1-sketch.webp",
        "alt": "Get prepared",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Shape and bake the meatballs",
      "blocks": [
        "Add the pork mince to the breadcrumbs, season with pepper and mix well. Roll into five even meatballs per serving. Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "char-siu-pork-meatball-spaghetti-2-sketch",
        "path": "media/char-siu-pork-meatball-spaghetti-2-sketch.webp",
        "alt": "Shape and bake the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the spaghetti",
      "blocks": [
        "Boil the spaghetti for 8 minutes until tender. Drain, return to the saucepan and toss with a little oil to prevent sticking."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the spaghetti",
          "seconds": [
            480
          ]
        }
      ],
      "image": {
        "id": "char-siu-pork-meatball-spaghetti-3-sketch",
        "path": "media/char-siu-pork-meatball-spaghetti-3-sketch.webp",
        "alt": "Cook the spaghetti",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Pickle the radishes",
      "blocks": [
        "Trim and thinly slice the radishes. Toss them with rice vinegar, {{pickle-sugar}} sugar and a pinch of salt, and set aside. Heat a drizzle of oil over medium heat and fry the ginger purée and remaining garlic for 30 seconds."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "char-siu-pork-meatball-spaghetti-4-sketch",
        "path": "media/char-siu-pork-meatball-spaghetti-4-sketch.webp",
        "alt": "Pickle the radishes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the char siu sauce",
      "blocks": [
        "Add the passata, {{sauce-water}} water and soy sauce to the ginger. Bring to a boil and simmer for 4–5 minutes until thickened. Stir in the char siu paste, {{butter}} butter and cooked meatballs and simmer for 1 minute until piping hot. Take off the heat, toss through the spaghetti and season to taste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the sauce",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Warm the meatballs in the sauce",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "char-siu-pork-meatball-spaghetti-5-sketch",
        "path": "media/char-siu-pork-meatball-spaghetti-5-sketch.webp",
        "alt": "Make the char siu sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the spaghetti and meatballs among bowls. Toss the baby leaves with the pickled radishes and a drizzle of oil. Season and serve alongside."
      ],
      "notes": [],
      "timers": [],
