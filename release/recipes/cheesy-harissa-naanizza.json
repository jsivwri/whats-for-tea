  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Fry the onion and mushrooms",
      "blocks": [
        "Heat the oven to 240°C (220°C fan, gas 9). Halve, peel and thinly slice the onion. Peel and grate or press the garlic. Stir-fry the onion and mushrooms in a large frying pan over high heat for 5–6 minutes until softened. Season, add the garlic and fry for another minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the onion and mushrooms",
          "seconds": [
            300,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the garlic",
          "seconds": [
            60
          ]
        }
      ],
