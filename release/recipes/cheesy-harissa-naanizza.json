      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the sauce",
      "blocks": [
        "Mix the tomato purée, harissa and {{sauce-water}} water in a bowl. Season to taste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "cheesy-harissa-naanizza-2-sketch",
        "path": "media/cheesy-harissa-naanizza-2-sketch.webp",
        "alt": "Make the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Build the naan pizzas",
      "blocks": [
        "Grate the Cheddar. Lay the naans on a large baking tray and spread the harissa sauce over them, leaving a 1 cm border."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "cheesy-harissa-naanizza-3-sketch",
        "path": "media/cheesy-harissa-naanizza-3-sketch.webp",
        "alt": "Build the naan pizzas",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Bake",
      "blocks": [
        "Top each naan with the fried onions and mushrooms and scatter over the Cheddar. Bake on the top shelf for 6–7 minutes until golden and bubbling."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the naan pizzas",
          "seconds": [
            360,
            420
          ]
        }
      ],
      "image": {
        "id": "cheesy-harissa-naanizza-4-sketch",
        "path": "media/cheesy-harissa-naanizza-4-sketch.webp",
        "alt": "Bake",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Slice the apple",
      "blocks": [
        "While the naans bake, quarter, core and thinly slice the apple."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "cheesy-harissa-naanizza-5-sketch",
        "path": "media/cheesy-harissa-naanizza-5-sketch.webp",
