  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the peppers",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Halve the peppers lengthways and remove the seeds. Put cut-side down on a small baking tray, drizzle with oil and season. Roast on the middle shelf for 18–20 minutes until soft and slightly charred."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the peppers",
          "seconds": [
            1080,
            1200
          ]
        }
      ],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-1-sketch",
        "path": "media/mozzarella-pepper-pesto-panini-1-sketch.webp",
        "alt": "Roast the peppers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Bake the herby fries",
      "blocks": [
        "Cut the unpeeled potatoes into 1 cm fries. Toss with oil, salt, pepper and mixed herbs. Spread in a single layer on one or more trays and bake on the top shelf for 25–30 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the fries",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-2-sketch",
        "path": "media/mozzarella-pepper-pesto-panini-2-sketch.webp",
        "alt": "Bake the herby fries",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the pesto and cheese",
      "blocks": [
        "Halve the ciabatta rolls and spread pesto on both cut sides. Grate the Cheddar.",
        "Put the grated Cheddar on the roll bases and season with pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-3-sketch",
        "path": "media/mozzarella-pepper-pesto-panini-3-sketch.webp",
        "alt": "Prepare the pesto and cheese",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Assemble the panini",
      "blocks": [
        "Put a roasted pepper half on each cheesy ciabatta base, close and press firmly."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-4-sketch",
        "path": "media/mozzarella-pepper-pesto-panini-4-sketch.webp",
        "alt": "Assemble the panini",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Toast the panini",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over medium-high. Add the panini and press down with a spatula or heavy pan. Toast for 2–4 minutes per side, pressing occasionally, until golden and the cheese has melted."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Toast each side",
          "seconds": [
            120,
            240
          ]
        }
      ],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-5-sketch",
        "path": "media/mozzarella-pepper-pesto-panini-5-sketch.webp",
        "alt": "Toast the panini",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Halve the panini diagonally. Serve with herby fries and rocket drizzled with balsamic glaze."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mozzarella-pepper-pesto-panini-6-sketch",
