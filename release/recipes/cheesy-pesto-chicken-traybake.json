    {
      "number": 5,
      "id": "step-5",
      "heading": "Roast the chicken and veg",
      "blocks": [
        "Roast the tray on the middle shelf for 16–18 minutes until the vegetables are tender and the chicken is cooked through."
      ],
      "notes": [],
