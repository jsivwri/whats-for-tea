      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Season the vegetables",
      "blocks": [
        "Put the pepper, onion and baby plum tomatoes on one side of a second large tray. Toss with a drizzle of oil, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "cheesy-pesto-chicken-traybake-3-sketch",
        "path": "media/cheesy-pesto-chicken-traybake-3-sketch.webp",
        "alt": "Season the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Coat the chicken with pesto",
      "blocks": [
        "Toss the chicken with pesto, salt and pepper. Lay it on the other side of the vegetable tray."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "cheesy-pesto-chicken-traybake-4-sketch",
        "path": "media/cheesy-pesto-chicken-traybake-4-sketch.webp",
