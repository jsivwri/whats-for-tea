  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Marinate the chicken",
      "blocks": [
        "If using the oven for the naans, heat it to 220°C / 200°C fan / gas mark 7. Peel and grate or press the garlic.",
        "Mix the garlic, chicken, chermoula spice mix, a drizzle of olive oil and {{marinade-spoonful}} each of zhoug and yoghurt. Use less zhoug for milder heat. Turn the chicken to coat it. Wash hands and equipment after handling raw chicken."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chermoula-chicken-loaded-naan-1-sketch",
        "path": "media/chermoula-chicken-loaded-naan-1-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      },
      "quantities": {
        "marinade-spoonful": {
          "2": "1 tbsp",
          "3": "1½ tbsp",
          "4": "2 tbsp"
        }
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Macerate the tomatoes",
      "blocks": [
        "Cut tomatoes into 1 cm chunks. Mix with {{sugar}} sugar and {{dressing-oil}} olive oil, season and set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chermoula-chicken-loaded-naan-2-sketch",
        "path": "media/chermoula-chicken-loaded-naan-2-sketch.webp",
        "alt": "Macerate the tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Fry the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan on medium-high. Fry the yoghurt-coated chicken for 8–10 minutes, until golden and cooked through with no pink in the middle. Taste and season if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "chermoula-chicken-loaded-naan-3-sketch",
        "path": "media/chermoula-chicken-loaded-naan-3-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the zhoug yoghurt",
      "blocks": [
        "Stir together the remaining zhoug paste and yoghurt in a small bowl."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chermoula-chicken-loaded-naan-4-sketch",
        "path": "media/chermoula-chicken-loaded-naan-4-sketch.webp",
        "alt": "Make the zhoug yoghurt",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Warm the naans",
      "blocks": [
        "Cut the naans in half widthways and toast until golden. If using the oven, sprinkle the naans with a little water and warm on a tray for 2–3 minutes.",
        "Toss the rocket with the dressed tomatoes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the naans in the oven",
          "seconds": [
            120,
