  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the potatoes and carrots",
      "blocks": [
        "Boil a kettle. Chop the unpeeled potatoes and carrots into rough bites."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-1-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-1-sketch.webp",
        "alt": "Prepare the potatoes and carrots",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Boil the vegetables",
      "blocks": [
        "Cover the chopped potatoes and carrots with boiled water in a saucepan. Bring back to a boil over high heat and cook for 10–12 minutes until fork-tender. Drain and return to the pan to steam dry."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the vegetables",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-2-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-2-sketch.webp",
        "alt": "Boil the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Brown the chicken",
      "blocks": [
        "Heat a little vegetable oil in a wide frying pan with a matching lid over medium-high. Fry the chicken breasts for 3 minutes per side until golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            180
          ]
        }
      ],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-3-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-3-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Mix the creamy stock",
      "blocks": [
        "Reboil half a kettle. Halve the cherry tomatoes. Dissolve the stock mix in {{stock-water}} boiling water and stir in the soft cheese."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-4-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-4-sketch.webp",
        "alt": "Mix the creamy stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer the chicken",
      "blocks": [
        "Peel and finely slice the garlic. Add it and the tomatoes to the golden chicken and cook for 1–2 minutes until beginning to soften. Pour in the creamy stock, cover and simmer for 10–12 minutes until the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the tomatoes and garlic",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the chicken",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-5-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-5-sketch.webp",
        "alt": "Simmer the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Make the harissa mash",
      "blocks": [
        "Return the drained potatoes and carrots to low heat. Add a knob of butter, a splash of milk, harissa to taste, salt and pepper. Mash until smooth; the carrot can retain a little texture."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-6-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-6-sketch.webp",
        "alt": "Make the harissa mash",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Add the spinach",
      "blocks": [
        "Stir washed spinach into the cooked chicken and cook for 3–4 minutes until wilted."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "chicken-creamy-tomato-harissa-mash-7-sketch",
        "path": "media/chicken-creamy-tomato-harissa-mash-7-sketch.webp",
        "alt": "Add the spinach",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Serve the chicken with the harissa mash and spoon over the creamy tomato sauce."
      ],
      "notes": [],
      "timers": [],
