    {
      "number": 2,
      "id": "step-2",
      "heading": "Prep the vegetables",
      "blocks": [
        "Halve, peel and finely chop the shallot. Trim the green beans and cut into thirds."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-green-beans-2-sketch",
