  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the rice",
      "blocks": [
        "Bring {{rice-water}} water, the basmati rice and {{rice-salt}} salt to a boil in a saucepan with a tight-fitting lid. Cover and reduce the heat to medium. Cook for 10 minutes, then take the pan off the heat and leave covered for another 10 minutes to steam."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
