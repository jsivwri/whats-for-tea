  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Toast the almonds",
      "blocks": [
        "Take the chicken out of the fridge, open the packet and let it air while you heat a large, dry, wide pan over medium heat.",
        "Toast the flaked almonds for 2–3 minutes until lightly golden. Watch closely so they don’t burn. Set aside and keep the pan."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Toast almonds",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-pilaf-1",
        "path": "media/chicken-korma-pilaf-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of toasted flaked almonds scattered in a light pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Season the chicken",
      "blocks": [
        "Meanwhile, mix the diced chicken in a bowl with half the turmeric and a generous pinch of salt. Save the other half of the turmeric for later."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-pilaf-2",
        "path": "media/chicken-korma-pilaf-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of diced chicken coated in turmeric in a shallow white bowl",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Prepare the aromatics",
      "blocks": [
        "Peel and finely dice the onion. Peel and finely chop or grate the garlic. Roughly chop the creamed coconut if needed."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-pilaf-3",
        "path": "media/chicken-korma-pilaf-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two separate piles of chopped onion and garlic on a wooden board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Brown the chicken",
      "blocks": [
        "Return the pan to high heat with a drizzle of vegetable oil. Add the turmeric chicken and cook for 3–4 minutes on each side, until lightly browned."
      ],
      "notes": [
        "Use two pans if you doubled the protein."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-pilaf-4",
        "path": "media/chicken-korma-pilaf-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of scattered browned chicken pieces in a light frying pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Add the spices",
      "blocks": [
        "Lower the heat to medium. Add the diced onion and a pinch of sugar. Cook for 4–5 minutes until slightly softened.",
        "Stir in a knob of butter, the garlic, ginger paste, curry powder and remaining turmeric. Cook for 1–2 minutes until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften onion",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Cook spices",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-pilaf-5",
        "path": "media/chicken-korma-pilaf-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chicken and softened onion in the same pan with golden spices",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Cook the pilaf",
      "blocks": [
        "Stir the basmati rice through the oil and spices. Pour in {{line-18}} cold water and add the chopped creamed coconut. Bring to the boil over high heat.",
        "Reduce to very low, cover and cook for 10–12 minutes until the water has been absorbed, the rice is done and the chicken is cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook pilaf",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-pilaf-6",
        "path": "media/chicken-korma-pilaf-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of golden basmati rice and diced chicken cooking in the pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Warm the peas",
      "blocks": [
        "When the rice and chicken are cooked, stir in the blanched peas, chicken stock mix and a pinch of salt.",
        "Cover and cook for 1–2 minutes until the peas are warmed through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm peas",
          "seconds": [
            60,
            120
          ]
        }
      ],
