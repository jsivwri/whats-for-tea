  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the potatoes",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 2 cm chunks. Toss with oil, salt and pepper and spread in a single layer on one or more trays. Set aside. Heat a little oil in a frying pan over medium-high."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-spring-rolls-1-sketch",
        "path": "media/chicken-korma-spring-rolls-1-sketch.webp",
        "alt": "Prepare the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the chicken",
      "blocks": [
        "Season the diced chicken and fry for 5–6 minutes until browned, turning occasionally. Peel and grate or press the garlic. Add the korma paste and half the garlic to the browned chicken and fry for 30 seconds."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-spring-rolls-2-sketch",
        "path": "media/chicken-korma-spring-rolls-2-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the filling and roast the potatoes",
      "blocks": [
        "Stir in the stock paste, honey and {{sauce-water}} water. Bring to a boil, then simmer for 3–4 minutes until the chicken is cooked through. Add {{butter}} butter and half the crème fraîche. Simmer for 1–2 minutes, season and take off the heat. Roast the potatoes on the top shelf for 25–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the chicken",
          "seconds": [
            180,
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Thicken the filling",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-3",
          "label": "Roast the potatoes",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-spring-rolls-3-sketch",
        "path": "media/chicken-korma-spring-rolls-3-sketch.webp",
        "alt": "Cook the filling and roast the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Roll the filo",
      "blocks": [
        "Cut each filo sheet crossways into four equal pieces. Layer two pieces and turn them so a corner points towards you. Put a heaped spoonful of filling about 5 cm from that corner. Roll towards the opposite corner, folding the sides in halfway, then finish rolling tightly. Repeat to make two spring rolls per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-spring-rolls-4-sketch",
        "path": "media/chicken-korma-spring-rolls-4-sketch.webp",
        "alt": "Roll the filo",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Bake the rolls and make the cucumber salad",
      "blocks": [
        "Lay the rolls seam-side down on a lined tray, brush with oil and bake on the middle shelf for 15–20 minutes until golden. Zest and quarter the lemon. Cut the cucumber into 1 cm half moons and toss with the remaining crème fraîche, a squeeze of lemon, {{dressing-sugar}} sugar, salt and pepper."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the spring rolls",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "chicken-korma-spring-rolls-5-sketch",
        "path": "media/chicken-korma-spring-rolls-5-sketch.webp",
        "alt": "Bake the rolls and make the cucumber salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Toss the baby leaves through the cucumber salad. Toss the potatoes with the lemon zest and remaining garlic. Serve the spring rolls with the potatoes, salad, mango chutney for dipping and any remaining lemon wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-korma-spring-rolls-6-sketch",
        "path": "media/chicken-korma-spring-rolls-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
