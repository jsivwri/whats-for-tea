  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Start the prep",
      "blocks": [
        "Boil a full kettle. Trim the carrot and slice into 1 cm rounds; peeling is optional. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-massaman-curry-1-sketch",
        "path": "media/chicken-massaman-curry-1-sketch.webp",
        "alt": "Start the prep",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the carrot",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over medium-high. Stir-fry the carrot for 2–3 minutes until it starts to soften."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the carrot",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "chicken-massaman-curry-2-sketch",
        "path": "media/chicken-massaman-curry-2-sketch.webp",
        "alt": "Fry the carrot",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the rice",
      "blocks": [
        "Pour the kettle water into a saucepan with {{rice-salt}} salt. Bring to the boil on high, add the jasmine rice and cook for 12–13 minutes. Drain, return to the pan and cover until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
            780
          ]
        }
      ],
      "image": {
        "id": "chicken-massaman-curry-3-sketch",
        "path": "media/chicken-massaman-curry-3-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Build the sauce",
      "blocks": [
        "Stir the garlic and massaman paste into the carrot and fry for 1 minute. Add the coconut milk and {{sauce-water}} water. Stir in the stock paste and peanut butter and bring to the boil."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "chicken-massaman-curry-4-sketch",
        "path": "media/chicken-massaman-curry-4-sketch.webp",
        "alt": "Build the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer the curry",
      "blocks": [
        "Stir in the chicken. Return to the boil, lower the heat and simmer for 10–12 minutes, until the sauce thickens and the chicken is cooked through. Zest and wedge the lime. In the last 2 minutes add the spinach a handful at a time until wilted and piping hot."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            600,
            720
          ]
        },
        {
          "id": "timer-2",
          "label": "Wilt the spinach",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "chicken-massaman-curry-5-sketch",
        "path": "media/chicken-massaman-curry-5-sketch.webp",
        "alt": "Simmer the curry",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Finish and serve",
      "blocks": [
        "Take the curry off the heat. Add the soy sauce and a squeeze of lime juice, with a splash of water if needed. Taste and adjust the salt, pepper and lime. Fluff the rice with the zest and serve in bowls with the curry and a lime wedge."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-massaman-curry-6-sketch",
        "path": "media/chicken-massaman-curry-6-sketch.webp",
        "alt": "Finish and serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
