  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the noodles",
      "blocks": [
        "Bring a saucepan of water with {{noodle-salt}} salt to a boil. Cook the noodles for 4 minutes. Drain, rinse under cold water and return to the pan off the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles",
          "seconds": [
            240
          ]
        }
      ],
      "image": {
        "id": "chicken-plum-stir-fry-1-sketch",
        "path": "media/chicken-plum-stir-fry-1-sketch.webp",
        "alt": "Cook the noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan or wok over medium-high. Season the chicken and fry for 4–5 minutes, stirring occasionally, until browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "chicken-plum-stir-fry-2-sketch",
        "path": "media/chicken-plum-stir-fry-2-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the plums and greens",
      "blocks": [
        "Halve and stone the plums, then cut each half into three wedges. Trim and thinly slice the bok choy crossways. Trim and thinly slice the spring onion. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-plum-stir-fry-3-sketch",
        "path": "media/chicken-plum-stir-fry-3-sketch.webp",
        "alt": "Prepare the plums and greens",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Stir-fry the plums",
      "blocks": [
        "Lower the heat to medium and add the plums and {{sugar}} sugar to the chicken. Stir-fry for 1–2 minutes until the plums start to colour. Add the garlic, ginger purée, half the spring onion and chilli flakes to taste. Stir-fry for 1 more minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the plums",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "chicken-plum-stir-fry-4-sketch",
        "path": "media/chicken-plum-stir-fry-4-sketch.webp",
        "alt": "Stir-fry the plums",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the noodles",
      "blocks": [
        "Add the bok choy and fry for 1–2 minutes until just softened. Stir in the hoisin, ketjap manis and {{sauce-water}} water. Drain and add the noodles, then toss for 1–2 minutes until piping hot and the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the bok choy",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Finish the stir-fry",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "chicken-plum-stir-fry-5-sketch",
        "path": "media/chicken-plum-stir-fry-5-sketch.webp",
        "alt": "Finish the noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide between bowls and scatter over the peanuts and remaining spring onion."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chicken-plum-stir-fry-6-sketch",
        "path": "media/chicken-plum-stir-fry-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
