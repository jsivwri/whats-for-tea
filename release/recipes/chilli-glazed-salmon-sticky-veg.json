  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get prepped",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Chop the unpeeled potatoes into 1 cm chunks. Peel and halve the onion and cut each half into 3 wedges.",
        "Toss the veg with oil, half the spice and herb blend, salt and pepper. Spread out in a single layer, using two trays if needed."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chilli-glazed-salmon-sticky-veg-1-sketch",
        "path": "media/chilli-glazed-salmon-sticky-veg-1-sketch.webp",
        "alt": "Get prepped",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Roast the veg",
      "blocks": [
        "Roast the veg on the middle shelf for 30–40 minutes, turning halfway. Wrap the unpeeled garlic in foil with a drizzle of oil. Roast the parcel for 10–12 minutes until soft."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the vegetables",
          "seconds": [
            1800,
            2400
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the garlic",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "chilli-glazed-salmon-sticky-veg-2-sketch",
        "path": "media/chilli-glazed-salmon-sticky-veg-2-sketch.webp",
        "alt": "Roast the veg",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake the salmon",
      "blocks": [
        "Lay the salmon skin-side down on a lined tray. Season with salt and pepper and sprinkle with the remaining spice blend. Roast on the top shelf for 10–15 minutes, until cooked through and opaque in the middle.",
        "Wash hands and equipment after handling raw fish."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the salmon",
          "seconds": [
            600,
            900
          ]
        }
      ],
      "image": {
        "id": "chilli-glazed-salmon-sticky-veg-3-sketch",
        "path": "media/chilli-glazed-salmon-sticky-veg-3-sketch.webp",
        "alt": "Bake the salmon",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Dress the cucumber",
      "blocks": [
        "Trim the cucumber and cut into 1 cm pieces. Toss with cider vinegar, {{dressing-sugar}} sugar, {{dressing-oil}} olive oil, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "chilli-glazed-salmon-sticky-veg-4-sketch",
        "path": "media/chilli-glazed-salmon-sticky-veg-4-sketch.webp",
        "alt": "Dress the cucumber",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the glaze and yoghurt",
      "blocks": [
        "Squeeze the cooled garlic out of its skin, mash with a fork and stir into the yoghurt. Season. Drizzle half the chilli jelly over the cooked salmon and toss the rest through the roasted veg.",
        "Toss the baby leaves through the cucumber dressing."
      ],
      "notes": [],
      "timers": [],
