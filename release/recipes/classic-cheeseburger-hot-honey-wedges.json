  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the wedges",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 2 cm wedges. Toss with oil, salt and pepper. Spread in one layer on one or more trays and roast on the top shelf for 25–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the wedges",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-1-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-1-sketch.webp",
        "alt": "Roast the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Shape the burgers",
      "blocks": [
        "Peel and grate or press the garlic. Mix it with the breadcrumbs, mixed herbs, {{crumb-salt}} salt and {{crumb-water}} water. Add the mince and pepper, mix well and shape into one 1 cm thick patty per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-2-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-2-sketch.webp",
        "alt": "Shape the burgers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake the burgers",
      "blocks": [
        "Bake the patties on a tray on the middle shelf for 12–15 minutes until cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the burgers",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-3-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-3-sketch.webp",
        "alt": "Bake the burgers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Melt the cheese and warm the buns",
      "blocks": [
        "Grate the Cheddar and halve the buns. Top the cooked burgers with cheese and return to the oven for 2–3 minutes until melted. Warm the buns at the same time."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Melt the cheese",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-4-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-4-sketch.webp",
        "alt": "Melt the cheese and warm the buns",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Glaze the wedges",
      "blocks": [
        "Toss the cooked wedges with chilli flakes to taste and honey. If the honey is stiff, warm its container in hot water for 1 minute. Return the wedges to the oven for 2–3 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Set the honey glaze",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-5-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-5-sketch.webp",
        "alt": "Glaze the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Assemble and serve",
      "blocks": [
        "Spread {{mayonnaise}} mayonnaise across the bun bases and spread the burger sauce on the lids. Add a cheeseburger and some baby leaves, close the buns and serve with the wedges and remaining leaves."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "classic-cheeseburger-hot-honey-wedges-6-sketch",
        "path": "media/classic-cheeseburger-hot-honey-wedges-6-sketch.webp",
        "alt": "Assemble and serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
