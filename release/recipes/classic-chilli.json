  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Chop the vegetables",
      "blocks": [
        "Boil a kettle. Peel and finely chop the onion. Deseed the sweet pointed peppers and cut them into thin strips. A teaspoon helps scrape out the seeds and pith."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "classic-chilli-1",
        "path": "media/classic-chilli-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two separate piles of chopped onion and red pepper on a wooden board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Soften the onions and peppers",
      "blocks": [
        "Heat a drizzle of olive oil in a large wide pan, preferably non-stick, over medium heat.",
        "Add the peppers and onions with a pinch of salt. Cook for 3–4 minutes until they begin to soften."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften vegetables",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "classic-chilli-2",
        "path": "media/classic-chilli-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of softened red pepper and translucent onion in a pale pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Cook the rice",
      "blocks": [
        "Meanwhile put the white long grain rice and {{rice-water}} cold water in a lidded saucepan. Bring to the boil over high heat.",
        "Turn the heat very low, cover and cook for 12–15 minutes until all the water has been absorbed and the rice is cooked.",
        "Take the pan off the heat and leave covered to steam until serving."
      ],
      "notes": [],
      "quantities": {
        "rice-water": {
          "2": "225 ml",
          "3": "300 ml",
          "4": "450 ml"
        }
      },
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook rice",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "classic-chilli-3",
        "path": "media/classic-chilli-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of rice in a saucepan with a metal lid partially covering it",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Mix the stock",
      "blocks": [
        "Dissolve the beef stock mix and tomato paste in {{stock-water}} boiled water. Drain and rinse the black beans."
      ],
      "notes": [],
      "quantities": {
        "stock-water": {
          "2": "250 ml",
          "3": "325 ml",
          "4": "425 ml"
        }
      },
      "timers": [],
      "image": {
        "id": "classic-chilli-4",
        "path": "media/classic-chilli-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small jug of red stock above a sieve of drained beans",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Brown the beef",
      "blocks": [
        "When the onion and pepper soften, turn the heat high. Add the mince, cumin, smoked paprika, oregano and chilli flakes.",
        "Break the mince up with a wooden spoon and cook for 3–4 minutes until browned."
      ],
      "notes": [
        "Skip the chilli flakes for a milder portion. If you doubled your protein, use two pans."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown mince",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "classic-chilli-5",
        "path": "media/classic-chilli-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of crumbled browned mince with red pepper strips in a pale pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Simmer the chilli",
      "blocks": [
        "Add the prepared stock and drained beans. Season with salt and pepper, then bring to the boil over high heat.",
        "Cook for 5–6 minutes more until the sauce is as thick as a bolognese and the mince is cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Thicken chilli",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "classic-chilli-6",
        "path": "media/classic-chilli-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of thick dark chilli with beans and peppers in the same pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Get the toppings ready",
      "blocks": [
        "Grate the cheddar and finely slice the trimmed spring onion. Fluff the rice with a fork."
      ],
      "notes": [
        "The card suggests stirring a knob of butter into the rice if you like."
      ],
      "timers": [],
      "image": {
        "id": "classic-chilli-7",
        "path": "media/classic-chilli-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two separate piles of grated cheddar and sliced spring onion on a board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve it up",
      "blocks": [
        "Spoon the chilli over the rice. Top with grated cheese, a dollop of natural yoghurt and sliced spring onion."
      ],
      "notes": [],
      "timers": [],
