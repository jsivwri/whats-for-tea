  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Mix the Cajun spices",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Mix the smoked paprika, cayenne to taste, ground coriander, oregano and cumin on a plate with a pinch of sugar and salt and plenty of black pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-1-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-1-sketch.webp",
        "alt": "Mix the Cajun spices",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Coat the chicken",
      "blocks": [
        "Press one side of each chicken breast into the spice mixture. Keep the remaining spices for the vegetables."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-2-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-2-sketch.webp",
        "alt": "Coat the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Brown and roast the chicken",
      "blocks": [
        "Heat vegetable oil in a large frying pan over medium-high. Fry the chicken spice-side down for 2–3 minutes until slightly charred. Transfer spice-side up to a tray and bake for 14–15 minutes until cooked through. Keep the frying pan."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the chicken",
          "seconds": [
            120,
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the chicken",
          "seconds": [
            840,
            900
          ]
        }
      ],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-3-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-3-sketch.webp",
        "alt": "Brown and roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Boil a kettle. Peel and finely slice the red onion and peel and chop or grate the garlic. Deseed the Romano pepper and cut into thin strips."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-4-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-4-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Cook the vegetables",
      "blocks": [
        "Fry the onion, garlic, pepper and remaining spice mix in a little oil in the reserved pan over medium heat for 8–10 minutes until starting to soften."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the vegetables",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-5-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-5-sketch.webp",
        "alt": "Cook the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Cook the linguine and mix the stock",
      "blocks": [
        "Boil the linguine in salted water for 8–10 minutes until just tender. Drain and reserve a cup of pasta water. Reboil half a kettle and dissolve the stock mix and soft cheese in {{stock-water}} boiling water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the linguine",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-6-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-6-sketch.webp",
        "alt": "Cook the linguine and mix the stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Finish the sauce",
      "blocks": [
        "Add the rice wine to the softened vegetables and cook for 30 seconds until evaporated. Add the creamy stock and cook for 2–3 minutes until thickened. Stir in the drained linguine and loosen with a splash of pasta water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Thicken the sauce",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "creamy-cajun-chicken-pepper-linguine-7-sketch",
        "path": "media/creamy-cajun-chicken-pepper-linguine-7-sketch.webp",
        "alt": "Finish the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Thinly slice the chicken and serve over the creamy pepper linguine. Finish with black pepper."
      ],
      "notes": [],
      "timers": [],
