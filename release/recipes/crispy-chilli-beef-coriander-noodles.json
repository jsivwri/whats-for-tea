        "alt": "Brown the mince",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Chop the spring onions and coriander",
      "blocks": [
        "Trim and roughly chop the spring onions. Finely chop the coriander, including the stalks, saving a few whole leaves for serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-3-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-3-sketch.webp",
        "alt": "Chop the spring onions and coriander",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Add the carrot",
      "blocks": [
        "Boil a kettle. Stir the grated carrot into the browned beef and fry for another 3 minutes until the mince starts to crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the carrot and beef",
          "seconds": [
            180
          ]
        }
      ],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-4-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-4-sketch.webp",
        "alt": "Add the carrot",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Cook the noodles",
      "blocks": [
        "Cover the fine egg noodles with boiling water in a saucepan. Return to the boil over high heat and cook for 1–2 minutes until tender. Drain, saving a cup of cooking water, then return the noodles to the pan off the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-5-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-5-sketch.webp",
        "alt": "Cook the noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Make the crispy chilli beef",
      "blocks": [
        "Add the garlic, ginger and chilli to taste to the crispy beef and fry for 1 minute. Stir in the chilli jam and half the soy sauce and fry for a further 4 minutes until browned and crispy."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Crisp the chilli beef",
          "seconds": [
            240
          ]
        }
      ],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-6-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-6-sketch.webp",
        "alt": "Make the crispy chilli beef",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Dress the coriander noodles",
      "blocks": [
        "Return the noodles to medium heat. Stir in the spring onions, remaining soy sauce, rice vinegar and toasted sesame oil. Loosen with a splash of cooking water if needed. Take off the heat and stir through the chopped coriander."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-7-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-7-sketch.webp",
        "alt": "Dress the coriander noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Spoon the crispy chilli beef over the noodles and top with the toasted sesame seeds and reserved coriander leaves."
      ],
      "notes": [],
      "timers": [],
