  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Trim, peel and grate the carrot. Peel and finely chop or grate the garlic and ginger. Peel and finely chop the shallot. Halve, deseed and finely chop the chilli."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-chilli-beef-coriander-noodles-1-sketch",
        "path": "media/crispy-chilli-beef-coriander-noodles-1-sketch.webp",
