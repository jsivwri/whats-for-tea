  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the rice",
      "blocks": [
        "Heat the oven to 200°C / 180°C fan / gas mark 6 and open the chicken packet. Bring rice and {{rice-water}} cold water to a boil, reduce to very low, cover and cook 12–15 minutes until the water is absorbed and the rice is tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "crispy-lemon-chicken-1",
        "path": "media/crispy-lemon-chicken-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of saucepan of white rice",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Bake the broccoli",
      "blocks": [
        "Let the cooked rice steam off the heat with its lid on. Halve the broccoli, place on foil with a splash of cold water and a large knob of butter, and seal the parcel. Bake it on a tray for 15 minutes or until tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the broccoli",
          "seconds": [
            900
          ]
        }
      ],
      "image": {
        "id": "crispy-lemon-chicken-2",
        "path": "media/crispy-lemon-chicken-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of sealed foil parcel of broccoli on baking tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Mix the lemon sauce",
      "blocks": [
        "Peel and finely chop or grate the garlic. Juice half the lemons, and reserve two slices per person. Mix the juice with honey, a sprinkle of cornflour, half the soy sauce and {{sauce-water}} cold water."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-lemon-chicken-3",
        "path": "media/crispy-lemon-chicken-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of lemon slices and bowl of orange lemon sauce",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Coat the chicken",
      "blocks": [
        "Mix the remaining cornflour with {{sugar}} sugar, five-spice and a generous grind of pepper. Toss the chicken strips until coated."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-lemon-chicken-4",
        "path": "media/crispy-lemon-chicken-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chicken strips coated in flour in mixing bowl",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Fry the chicken",
      "blocks": [
        "Heat a generous drizzle of vegetable oil in a wide pan over high heat. Add the coated chicken and remaining soy sauce. Cook 5–6 minutes per side until golden, crisp and cooked through with no pink meat. Transfer to a plate and keep the pan."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "crispy-lemon-chicken-5",
        "path": "media/crispy-lemon-chicken-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of crispy chicken strips frying",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Make the chilli rice",
      "blocks": [
        "Trim and finely slice the spring onions. Halve, deseed and finely chop the red chilli. Stir both through the rice, using less chilli if desired."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "crispy-lemon-chicken-6",
        "path": "media/crispy-lemon-chicken-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of white rice with spring onion and red chilli",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Reduce the sauce",
      "blocks": [
        "Return the pan to medium-low with a little oil. Cook the garlic for 1 minute, then add the lemon sauce and cook 2–3 minutes until thick and sticky."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Reduce the sauce · 1 min",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Reduce the sauce · 2–3 min",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "crispy-lemon-chicken-7",
        "path": "media/crispy-lemon-chicken-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of reduced glossy lemon sauce in pale pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve",
      "blocks": [
        "Put the chicken and broccoli over the chilli rice, drizzle the sauce over the chicken and finish with lemon slices and toasted sesame seeds."
      ],
      "notes": [],
      "timers": [],
