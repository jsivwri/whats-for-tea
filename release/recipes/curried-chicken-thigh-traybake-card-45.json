  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the potatoes",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Cut the unpeeled potatoes into 2 cm chunks.",
        "Toss the potatoes with oil, the white cumin seeds, salt and pepper. Spread in a single layer on a large baking tray, using a second tray if needed.",
        "Roast on the top shelf for 25–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potatoes",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "curried-chicken-thigh-traybake-1-sketch",
        "path": "media/curried-chicken-thigh-traybake-1-sketch.webp",
        "alt": "Roast the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prep the carrots",
      "blocks": [
        "While the potatoes roast, trim the unpeeled carrots and halve lengthways. Cut into batons about 1 cm wide and 5 cm long.",
        "Put the carrots on one side of another large tray and toss with oil, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "curried-chicken-thigh-traybake-2-sketch",
        "path": "media/curried-chicken-thigh-traybake-2-sketch.webp",
        "alt": "Prep the carrots",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Flavour the chicken",
      "blocks": [
        "Lay the chicken thighs flat on the other side of the carrot tray, using two trays if needed. Drizzle with oil, season with salt and pepper and spread the curry paste over the chicken.",
        "Wash hands and equipment after handling raw chicken and its packaging."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "curried-chicken-thigh-traybake-3-sketch",
        "path": "media/curried-chicken-thigh-traybake-3-sketch.webp",
        "alt": "Flavour the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Time to traybake",
      "blocks": [
        "Roast the carrots and chicken on the middle shelf for 20–25 minutes, until the carrots are tender and the chicken is cooked through with no pink in the middle. Turn the carrots halfway through.",
        "Mix the mango chutney with {{mayonnaise}} mayonnaise in a small bowl and set aside."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken and carrots",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
      "image": {
        "id": "curried-chicken-thigh-traybake-4-sketch",
        "path": "media/curried-chicken-thigh-traybake-4-sketch.webp",
        "alt": "Time to traybake",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Cook the beans",
      "blocks": [
        "Once everything is nearly ready, boil half a kettle and trim the green beans. Pour the boiled water into a saucepan with {{bean-salt}} salt and bring it back to the boil on high.",
        "Add the beans and cook for 4–6 minutes until just tender. Drain and return to the pan. Season with salt and pepper and toss in olive oil."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the beans",
          "seconds": [
            240,
            360
          ]
        }
      ],
      "image": {
        "id": "curried-chicken-thigh-traybake-5-sketch",
        "path": "media/curried-chicken-thigh-traybake-5-sketch.webp",
        "alt": "Cook the beans",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Serve the curried chicken and carrots, spooning over the tray juices if you like. Add the cumin roast potatoes, beans and mango chutney mayo for dipping."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "curried-chicken-thigh-traybake-6-sketch",
        "path": "media/curried-chicken-thigh-traybake-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
