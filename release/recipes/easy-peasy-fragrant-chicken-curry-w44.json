  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get frying",
      "blocks": [
        "Boil half a kettle. Trim the green beans and cut into thirds. Heat a drizzle of oil in a frying pan over medium-high.",
        "Fry the chicken and green beans for 5–6 minutes, then season with salt and pepper. Wash hands and utensils after handling raw meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry chicken and beans",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "easy-peasy-fragrant-chicken-curry-1-sketch",
        "path": "media/easy-peasy-fragrant-chicken-curry-1-sketch.webp",
        "alt": "Get frying",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Rice on",
      "blocks": [
        "Meanwhile, pour the boiled water into a saucepan with {{rice-salt}} salt and bring to the boil on high. Boil the rice for 12–13 minutes. Quarter the lime while it cooks."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
            780
          ]
        }
      ],
      "image": {
        "id": "easy-peasy-fragrant-chicken-curry-2-sketch",
        "path": "media/easy-peasy-fragrant-chicken-curry-2-sketch.webp",
        "alt": "Rice on",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Sauce time",
      "blocks": [
        "Stir tomato purée, ginger purée, Indonesian spice mix, coconut milk, stock paste and {{sugar}} sugar into the chicken and beans.",
        "Lower the heat and simmer for 3–4 minutes, until the chicken is cooked through with no pink in the middle. Squeeze in some lime juice, then taste and season."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "easy-peasy-fragrant-chicken-curry-3-sketch",
        "path": "media/easy-peasy-fragrant-chicken-curry-3-sketch.webp",
        "alt": "Sauce time",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Serve",
      "blocks": [
        "Drain the rice and divide it between bowls. Spoon over the curry and serve with the remaining lime quarters."
      ],
      "notes": [],
