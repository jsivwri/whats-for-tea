  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the rice",
      "blocks": [
        "Boil half a kettle. Pour the kettle water into a saucepan with {{rice-salt}} salt. Bring to the boil on high, add the basmati rice and cook for 12 minutes. Drain, return to the pan and cover until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720
          ]
        }
      ],
      "image": {
        "id": "family-tandoori-chicken-masala-1-sketch",
        "path": "media/family-tandoori-chicken-masala-1-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Brown the chicken",
      "blocks": [
        "Meanwhile, heat a drizzle of oil in a large frying pan over medium-high. Season the chicken and fry for 5–6 minutes until browned all over, turning occasionally."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "family-tandoori-chicken-masala-2-sketch",
        "path": "media/family-tandoori-chicken-masala-2-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Add the spices",
      "blocks": [
        "Peel and grate or press the garlic. Add it to the browned chicken with the tomato purée and tandoori masala mix. Stir and cook until fragrant, about 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "family-tandoori-chicken-masala-3-sketch",
        "path": "media/family-tandoori-chicken-masala-3-sketch.webp",
        "alt": "Add the spices",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Simmer",
      "blocks": [
        "Add the stock paste and {{curry-water}} water. Bring to a boil, then lower the heat and simmer gently for 3–4 minutes until the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the chicken",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "family-tandoori-chicken-masala-4-sketch",
        "path": "media/family-tandoori-chicken-masala-4-sketch.webp",
        "alt": "Simmer",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the sauce",
      "blocks": [
        "Stir in the crème fraîche, mango chutney and {{butter}} butter until the butter melts. Add the spinach a handful at a time and cook for 1–2 minutes until wilted and piping hot. Taste, season and take off the heat. Thin with a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "family-tandoori-chicken-masala-5-sketch",
        "path": "media/family-tandoori-chicken-masala-5-sketch.webp",
        "alt": "Finish the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the rice between bowls, spoon over the masala and finish with crispy onions."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "family-tandoori-chicken-masala-6-sketch",
        "path": "media/family-tandoori-chicken-masala-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
