  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Make the hasselback potatoes",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Place the potatoes between two wooden spoon handles and slice crossways every 3 mm, leaving the bases intact. Toss on a tray with oil, salt and pepper. Roast in one layer on the middle shelf for 35–40 minutes until golden and tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potatoes",
          "seconds": [
            2100,
            2400
          ]
        }
      ],
      "image": {
        "id": "fig-balsamic-red-wine-chicken-1-sketch",
        "path": "media/fig-balsamic-red-wine-chicken-1-sketch.webp",
        "alt": "Make the hasselback potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Marinate the chicken",
      "blocks": [
        "Peel and grate or press the garlic. Mix with the herbs, honey, {{marinade-oil}} olive oil, salt and pepper. Coat the chicken. If the honey is stiff, warm its container in hot water for 1 minute."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "fig-balsamic-red-wine-chicken-2-sketch",
        "path": "media/fig-balsamic-red-wine-chicken-2-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Roast the chicken",
      "blocks": [
        "Put the chicken on a lined tray and roast on the top shelf for 25–30 minutes until cooked through. Boil half a kettle, trim the beans and peel and finely chop the shallot."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "fig-balsamic-red-wine-chicken-3-sketch",
        "path": "media/fig-balsamic-red-wine-chicken-3-sketch.webp",
        "alt": "Roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the fig sauce",
      "blocks": [
        "Heat oil in a medium frying pan over medium-high. Fry the shallot for 3–4 minutes until soft. Add the balsamic vinegar and cook until nearly evaporated. Stir in the fig jam, stock paste and {{sauce-water}} water. Simmer for 4–5 minutes until thickened. Vigorously stir in {{butter}} butter and take off the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the shallot",
          "seconds": [
            180,
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the fig sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "fig-balsamic-red-wine-chicken-4-sketch",
        "path": "media/fig-balsamic-red-wine-chicken-4-sketch.webp",
        "alt": "Make the fig sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Cook the green beans",
      "blocks": [
        "With about 10 minutes left on the potatoes, bring the kettle water and {{bean-salt}} salt to a boil. Add the beans and boil for 4–6 minutes until just tender. Drain, return to the pan, toss with olive oil and seasoning and cover to keep warm."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the beans",
          "seconds": [
            240,
            360
          ]
        }
      ],
      "image": {
        "id": "fig-balsamic-red-wine-chicken-5-sketch",
        "path": "media/fig-balsamic-red-wine-chicken-5-sketch.webp",
        "alt": "Cook the green beans",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Rest the chicken loosely covered with foil for a couple of minutes. Reheat the sauce if needed. Thinly slice the chicken, spoon over the fig sauce and serve with the hasselbacks and beans."
      ],
      "notes": [],
      "timers": [],
