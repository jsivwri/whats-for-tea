  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the garlic",
      "blocks": [
        "Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "fragrant-chicken-coconut-curry-1-sketch",
        "path": "media/fragrant-chicken-coconut-curry-1-sketch.webp",
        "alt": "Prepare the garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the rice",
      "blocks": [
        "Melt {{butter}} butter over medium heat in a deep saucepan with a tight-fitting lid. Fry half the garlic for 1 minute, then stir in the rice for 1 minute to coat. Add {{rice-salt}} salt and {{rice-water}} water. Bring to the boil, cover and reduce the heat to medium. Cook for 10 minutes, then remove from the heat and steam, covered, for another 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "fragrant-chicken-coconut-curry-2-sketch",
        "path": "media/fragrant-chicken-coconut-curry-2-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Brown the chicken",
      "blocks": [
        "Meanwhile, heat a drizzle of oil in a large frying pan over medium-high heat. Season the chicken and fry for 5–6 minutes, turning occasionally, until browned all over."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "fragrant-chicken-coconut-curry-3-sketch",
        "path": "media/fragrant-chicken-coconut-curry-3-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Simmer the curry",
      "blocks": [
        "Add the ginger, garlic and lemongrass purée, the remaining garlic and Zanzibar curry powder to taste. Stir-fry for 1 minute. Add the coconut milk, stock paste and {{sugar}} sugar. Bring to a boil, then simmer gently for 8–10 minutes until the chicken is cooked through and the curry has thickened. Add a splash of water if it looks dry."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the curry",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "fragrant-chicken-coconut-curry-4-sketch",
        "path": "media/fragrant-chicken-coconut-curry-4-sketch.webp",
        "alt": "Simmer the curry",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the lime and spinach",
      "blocks": [
        "Zest and halve the lime. Fluff the rice with the zest. When the curry is cooked, add the spinach a handful at a time and cook for 1–2 minutes until wilted and piping hot. Stir in half the lime juice, then taste and add more seasoning or lime as needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "fragrant-chicken-coconut-curry-5-sketch",
        "path": "media/fragrant-chicken-coconut-curry-5-sketch.webp",
        "alt": "Add the lime and spinach",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the zesty rice between bowls and spoon the curry over it."
      ],
      "notes": [],
      "timers": [],
