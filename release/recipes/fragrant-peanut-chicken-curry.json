  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Fry the chicken",
      "blocks": [
        "Boil half a kettle and cut the lime into wedges. Heat a drizzle of oil in a large frying pan on medium-high. Fry the chicken for 8–10 minutes, season and cook through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "fragrant-peanut-chicken-curry-1-sketch",
        "path": "media/fragrant-peanut-chicken-curry-1-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the rice and vegetables",
      "blocks": [
        "Pour the kettle water into a saucepan with {{rice-salt}} salt. Bring to the boil on high, add the jasmine rice and cook for 10–12 minutes. Drain, return to the pan and cover until serving.",
        "Halve the baby corn lengthways. Add it to the chicken with the pea pods, ginger, garlic and lemongrass purée, Indonesian spice mix and peanut butter. Stir-fry for 2 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600,
            720
          ]
        },
        {
          "id": "timer-2",
          "label": "Stir-fry the vegetables",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "fragrant-peanut-chicken-curry-2-sketch",
        "path": "media/fragrant-peanut-chicken-curry-2-sketch.webp",
        "alt": "Cook the rice and vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Simmer the sauce",
      "blocks": [
        "Stir in the coconut milk, stock paste, {{sugar}} sugar and {{curry-water}} water. Bring to the boil and simmer for 2–3 minutes. Add a squeeze of lime juice."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "fragrant-peanut-chicken-curry-3-sketch",
        "path": "media/fragrant-peanut-chicken-curry-3-sketch.webp",
        "alt": "Simmer the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Serve",
      "blocks": [
        "Divide the rice among bowls, top with the curry and serve with the remaining lime wedges."
      ],
      "notes": [],
      "timers": [],
