        "width": 640,
        "height": 480,
        "alt": "Sketch of hand-cut chips on a tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Roast the vegetables",
      "blocks": [
        "Cut carrots into 1 cm by 5 cm batons. Toss with oil, salt and pepper and roast for 25–30 minutes, turning halfway. Halve thick broccoli stems lengthways. Add broccoli to the carrot tray with oil and seasoning for the last 10–12 minutes on the middle shelf."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the vegetables · 25–30 min",
          "seconds": [
            1500,
            1800
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the vegetables · 10–12 min",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "gammon-charred-pineapple-2",
        "path": "media/gammon-charred-pineapple-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of carrot batons and tenderstem broccoli on tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Char the pineapple",
      "blocks": [
        "Drain the rings, saving the juice. Heat oil in a frying pan over medium-high and cook the pineapple for 5–6 minutes, turning every couple of minutes until charred. Transfer to a bowl and cover."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the pineapple",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "gammon-charred-pineapple-3",
        "path": "media/gammon-charred-pineapple-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of charred pineapple rings in dark frying pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Fry the gammon",
      "blocks": [
        "Clean the pan, return it to medium-high and add oil. Season gammon with pepper and fry for 2 minutes each side until golden and no longer dark pink in the centre. Rest under foil. Wash hands and equipment after handling raw pork."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the gammon",
          "seconds": [
            120
          ]
        }
      ],
