  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Bake the chips",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Cut unpeeled potatoes into 1 cm chips. Toss with oil, salt and pepper and spread on a tray in a single layer. Bake on the top shelf for 25–30 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chips",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
