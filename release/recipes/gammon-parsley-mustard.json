  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and bring a large saucepan of water with {{potato-salt}} salt to a boil. Cut potatoes into 2 cm chunks, peeling if preferred. Finely chop parsley including the stalks. Peel and grate the garlic and trim the green beans."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "gammon-parsley-mustard-1",
        "path": "media/gammon-parsley-mustard-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped potatoes parsley garlic and green beans on board",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Make the mash",
      "blocks": [
        "Boil potatoes for 15–20 minutes until tender. Drain and return to the pan off the heat. Mash with a knob of butter and splash of milk if available. Stir through half the mustard, season and cover to keep warm."
      ],
      "notes": [
        "Add less mustard to the mash if you prefer."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the mash",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "gammon-parsley-mustard-2",
        "path": "media/gammon-parsley-mustard-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of smooth mash in saucepan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Roast the vegetables",
      "blocks": [
        "Toss beans with half the garlic, oil, salt and pepper. Seal in foil and roast on the middle shelf 20–25 minutes until tender. Add the peas to the tray for the last 2 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the vegetables",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
      "image": {
        "id": "gammon-parsley-mustard-3",
        "path": "media/gammon-parsley-mustard-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of foil parcel of green beans and peas on tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Fry the gammon",
      "blocks": [
        "Heat oil in a large pan over medium-high heat. Season gammon with pepper and fry 2 minutes each side until golden and no longer dark pink in the middle. Rest under foil. Wash hands and equipment after handling raw pork."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the gammon",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "gammon-parsley-mustard-4",
        "path": "media/gammon-parsley-mustard-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two seared gammon steaks on plate",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make the sauce",
      "blocks": [
        "Return the pan to medium heat and fry the remaining garlic for 30 seconds. Stir in crème fraîche, {{sauce-water}} water, stock paste and remaining mustard. Bring to a boil, then simmer 2–3 minutes until thick. Remove from the heat, add parsley and loosen with water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the sauce",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "gammon-parsley-mustard-5",
        "path": "media/gammon-parsley-mustard-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of creamy mustard sauce in dark pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve",
      "blocks": [
        "Spoon the parsley mustard sauce over the gammon and serve with mash and green vegetables."
      ],
