    {
      "id": "step-2",
      "number": 2,
      "heading": "Slice the aromatics",
      "blocks": [
        "Peel and finely slice the onion. Peel and finely chop or grate the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "gousto-chicken-tikka-masala-2",
        "path": "media/gousto-chicken-tikka-masala-2-sketch.webp",
