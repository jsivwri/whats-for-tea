  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the rice",
      "blocks": [
        "Open the chicken pack while preparing. Rinse the brown rice, bring to a boil in plenty of cold water, then cook over medium heat for 20–25 minutes until tender with a slight bite. Drain, return to the pot and cover until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
