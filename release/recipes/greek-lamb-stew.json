  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the vegetables and set out a hob-safe ovenproof casserole. If using a frying pan to start, transfer to an ovenproof dish before baking."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Heat the casserole",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7, boil the kettle and heat vegetable oil in the casserole over high heat."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "greek-lamb-stew-2",
        "path": "media/greek-lamb-stew-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pale casserole with oil",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Brown the lamb",
      "blocks": [
        "Add the mince and {{flour}} flour. Break the mince into large chunks and cook 1–2 minutes until lightly browned all over."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the lamb",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "greek-lamb-stew-3",
        "path": "media/greek-lamb-stew-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of browned lamb mince in casserole",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Add the vegetables",
      "blocks": [
        "Cut the potatoes into rough bite-sized pieces. Trim the aubergine and cut it to a similar size. Stir both into the mince."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "greek-lamb-stew-4",
        "path": "media/greek-lamb-stew-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of potato and aubergine added",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make the stew",
      "blocks": [
        "Add vinegar, {{sugar}} sugar, stock mix, tomato paste, dried basil and {{stew-water}} boiled water. Bring to a boil on high heat and season generously."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "greek-lamb-stew-5",
        "path": "media/greek-lamb-stew-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of aubergine and potato in seasoned stew liquid",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Bake",
      "blocks": [
        "Cover and bake 40–45 minutes, until the potatoes are tender and the lamb is cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake",
          "seconds": [
            2400,
            2700
          ]
        }
      ]
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Make the feta topping",
      "blocks": [
        "Strip and finely chop the mint leaves. Crumble the feta into a bowl and mix in the mint."
      ],
      "notes": [],
      "timers": [],
