  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the cranberry bulgur",
      "blocks": [
        "Bring {{bulgur-water}} water and {{bulgur-stock}} chicken stock paste to a boil. Add the bulgur, return to a boil and simmer for 1 minute. Stir in the cranberries, cover, take off the heat and leave for 12–15 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-1-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-1-sketch.webp",
        "alt": "Cook the cranberry bulgur",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      },
      "quantities": {
        "bulgur-stock": {
          "2": "15 g",
          "3": "20 g",
          "4": "30 g"
        }
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over medium-high. Season the diced chicken and fry for 8–10 minutes until golden and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-2-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-2-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Make the dressing",
      "blocks": [
        "Peel and grate or press the garlic. In a large bowl, whisk the red wine vinegar with {{dressing-oil}} olive oil, salt, pepper and a pinch of sugar if desired. Set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-3-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-3-sketch.webp",
        "alt": "Make the dressing",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the harissa sauce",
      "blocks": [
        "Stir the garlic, tomato purée and harissa to taste into the cooked chicken. Fry for 1 minute. Add {{sauce-water}} water, the remaining stock paste and an optional pinch of sugar. Bring to the boil, then simmer for 3–4 minutes until thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-4-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-4-sketch.webp",
        "alt": "Make the harissa sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the bulgur and salad",
      "blocks": [
        "Stir the spinach into the chicken a handful at a time until wilted and piping hot, 1–2 minutes. Fluff the bulgur and stir through half the dressing. Toss the baby leaves with the rest of the dressing just before serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-5-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-5-sketch.webp",
        "alt": "Finish the bulgur and salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the cranberry bulgur among bowls and spoon the chicken and spinach over it. Serve the dressed baby leaves alongside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "harissa-chicken-cranberry-bulgur-6-sketch",
        "path": "media/harissa-chicken-cranberry-bulgur-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
