  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables and herbs",
      "blocks": [
        "Trim the courgettes and cut into 2 cm chunks. Cut the tomatoes into 1 cm pieces. Pick and roughly chop the mint leaves. Roughly chop the dried cranberries."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "harissa-chicken-jewelled-bulgur-1-sketch",
        "path": "media/harissa-chicken-jewelled-bulgur-1-sketch.webp",
        "alt": "Prepare the vegetables and herbs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the bulgur",
      "blocks": [
        "Bring {{bulgur-water}} water and the chicken stock paste to a boil in a large saucepan. Stir in the bulgur, bring back to a boil and simmer for 1 minute. Cover, take off the heat and leave for 12–15 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-jewelled-bulgur-2-sketch",
        "path": "media/harissa-chicken-jewelled-bulgur-2-sketch.webp",
        "alt": "Cook the bulgur",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Char the courgette",
      "blocks": [
        "Heat a dry frying pan on high. Cook the courgette for 6–8 minutes until charred, turning every couple of minutes. Season and transfer to a bowl."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the courgette",
          "seconds": [
            360,
            480
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-jewelled-bulgur-3-sketch",
        "path": "media/harissa-chicken-jewelled-bulgur-3-sketch.webp",
        "alt": "Char the courgette",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Fry the chicken",
      "blocks": [
        "Return the pan to medium-high heat with a drizzle of oil. Season the diced chicken and fry for 8–10 minutes until golden and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "harissa-chicken-jewelled-bulgur-4-sketch",
        "path": "media/harissa-chicken-jewelled-bulgur-4-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Combine",
      "blocks": [
        "Take the cooked chicken off the heat and let it cool slightly. Stir in the harissa. Fluff the bulgur and mix through the courgette, tomatoes, cranberries and half the mint. Stir the remaining mint into the yoghurt and season."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "harissa-chicken-jewelled-bulgur-5-sketch",
        "path": "media/harissa-chicken-jewelled-bulgur-5-sketch.webp",
        "alt": "Combine",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
