  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the potatoes",
      "blocks": [
        "Heat the oven to 200°C. Cut the unpeeled potatoes into 2 cm chunks. Peel and halve the onions, then cut each half into quarters.",
        "Toss the potatoes and onions on a large baking tray with oil, salt, pepper and dried thyme. Roast on the top shelf for 25–35 minutes, until the potatoes are golden and the onions soft. Turn halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the vegetables",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
