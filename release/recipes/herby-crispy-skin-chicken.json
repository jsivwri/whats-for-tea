        "id": "herby-crispy-skin-chicken-1-sketch",
        "path": "media/herby-crispy-skin-chicken-1-sketch.webp",
        "alt": "Roast the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Finish the prep",
      "blocks": [
        "Peel and grate or press the garlic. Mix with the tomato purée, mango chutney and {{glaze-water}} water. Set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-crispy-skin-chicken-2-sketch",
        "path": "media/herby-crispy-skin-chicken-2-sketch.webp",
        "alt": "Finish the prep",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prep the chicken",
      "blocks": [
        "Finely chop the coriander, including the stalks. Mix it in a bowl with {{chicken-oil}} olive oil, salt and pepper. Turn the chicken in the mixture to coat it. Wash hands after handling raw meat."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-crispy-skin-chicken-3-sketch",
        "path": "media/herby-crispy-skin-chicken-3-sketch.webp",
        "alt": "Prep the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Cook the chicken",
      "blocks": [
        "Heat a dry frying pan on medium-high. Fry the chicken breasts skin-side down for 4–5 minutes until golden, then turn and cook for 2 minutes.",
        "Transfer to a baking tray skin-side up and roast on the middle shelf for 15–20 minutes, until cooked through with no pink in the middle."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Crisp the skin",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the chicken",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "herby-crispy-skin-chicken-4-sketch",
        "path": "media/herby-crispy-skin-chicken-4-sketch.webp",
        "alt": "Cook the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Cook the kale",
      "blocks": [
        "When the potatoes and onions are cooked, toss with the tomato and chutney mixture. Lay the kale on top, drizzle with a little oil and season. Roast for 4–5 minutes more, until the kale is crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Crisp the kale",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "herby-crispy-skin-chicken-5-sketch",
        "path": "media/herby-crispy-skin-chicken-5-sketch.webp",
        "alt": "Cook the kale",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Finish and serve",
      "blocks": [
        "Rest the cooked chicken on a board for a couple of minutes. Mix the potatoes, onions and kale on the tray and spoon onto plates. Thinly slice the chicken and serve on top."
      ],
