  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the courgette and garlic",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Trim and quarter the courgette lengthways, then cut into 1 cm chunks. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-lamb-meatballs-chermoula-1-sketch",
        "path": "media/herby-lamb-meatballs-chermoula-1-sketch.webp",
        "alt": "Prepare the courgette and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the rice",
      "blocks": [
        "Bring {{rice-water}} water, the rice and {{rice-salt}} salt to a boil in a saucepan with a tight lid. Reduce to medium, cover and cook for 10 minutes. Take off the heat and leave covered for another 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "herby-lamb-meatballs-chermoula-2-sketch",
        "path": "media/herby-lamb-meatballs-chermoula-2-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Shape the meatballs",
      "blocks": [
        "Mix the breadcrumbs with {{crumb-salt}} salt and {{crumb-water}} water, the mixed herbs and half the garlic. Add the mince, season with pepper and mix well. Roll into five even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-lamb-meatballs-chermoula-3-sketch",
        "path": "media/herby-lamb-meatballs-chermoula-3-sketch.webp",
        "alt": "Shape the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Bake the meatballs and char the courgette",
      "blocks": [
        "Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through. Meanwhile, heat a drizzle of oil in a frying pan over high heat. Cook the courgette for 6–8 minutes until charred, turning every couple of minutes. Season, set aside and wipe out the pan."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        },
        {
          "id": "timer-2",
          "label": "Char the courgette",
          "seconds": [
            360,
            480
          ]
        }
      ],
      "image": {
        "id": "herby-lamb-meatballs-chermoula-4-sketch",
        "path": "media/herby-lamb-meatballs-chermoula-4-sketch.webp",
        "alt": "Bake the meatballs and char the courgette",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the chermoula sauce",
      "blocks": [
        "Return the frying pan to medium-high with a drizzle of oil. Fry the chermoula and remaining garlic for 1 minute. Stir in the passata, stock paste, chilli jelly and {{sauce-water}} water. Bring to the boil and simmer for 4–5 minutes until thickened. Add the cooked meatballs and courgette. Season, stirring in a knob of butter or a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "herby-lamb-meatballs-chermoula-5-sketch",
        "path": "media/herby-lamb-meatballs-chermoula-5-sketch.webp",
        "alt": "Make the chermoula sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Fluff the rice and serve with the lamb meatballs and sauce. Finish with a drizzle of Greek style yoghurt."
      ],
      "notes": [],
      "timers": [],
