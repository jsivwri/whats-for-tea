  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the garlic and chilli",
      "blocks": [
        "Bring a large saucepan of water with {{pasta-salt}} salt to the boil. Halve, deseed and finely chop the chilli. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-meatballs-linguine-1-sketch",
        "path": "media/herby-meatballs-linguine-1-sketch.webp",
        "alt": "Prepare the garlic and chilli",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Shape the meatballs",
      "blocks": [
        "Mix the panko, Italian herbs, chilli to taste and {{crumb-water}} water. Add the beef, salt and pepper and mix well. Roll into four even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-meatballs-linguine-2-sketch",
        "path": "media/herby-meatballs-linguine-2-sketch.webp",
        "alt": "Shape the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Brown and simmer the meatballs",
      "blocks": [
        "Heat a drizzle of oil over medium-high. Fry the meatballs for 5–6 minutes until browned all over. Add the garlic, season and fry for 1 minute. Stir in {{sauce-water}} water, stock paste and chopped tomatoes. Cover with a lid or foil and simmer for 6–7 minutes until cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the meatballs",
          "seconds": [
            300,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the meatballs",
          "seconds": [
            360,
            420
          ]
        }
      ],
      "image": {
        "id": "herby-meatballs-linguine-3-sketch",
        "path": "media/herby-meatballs-linguine-3-sketch.webp",
        "alt": "Brown and simmer the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Cook the pasta",
      "blocks": [
        "Boil the linguine for 12 minutes until tender. Drain, return to the saucepan and toss with a little oil to prevent sticking."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the linguine",
          "seconds": [
            720
          ]
        }
      ],
      "image": {
        "id": "herby-meatballs-linguine-4-sketch",
        "path": "media/herby-meatballs-linguine-4-sketch.webp",
        "alt": "Cook the pasta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the dressing",
      "blocks": [
        "Whisk the balsamic vinegar with {{dressing-oil}} olive oil, salt and pepper. Set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "herby-meatballs-linguine-5-sketch",
        "path": "media/herby-meatballs-linguine-5-sketch.webp",
        "alt": "Make the dressing",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Toss the linguine and half the grated cheese through the meatballs. Season, divide between bowls and finish with the remaining cheese. Toss the rocket with the dressing just before serving."
      ],
      "notes": [],
      "timers": [],
