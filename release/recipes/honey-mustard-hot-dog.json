    {
      "id": "step-7",
      "number": 7,
      "heading": "Dress the salad",
      "blocks": [
        "Wash and dry the leaves. Combine vinegar, olive oil and pepper in a large bowl and gently toss the leaves through."
      ],
      "notes": [],
