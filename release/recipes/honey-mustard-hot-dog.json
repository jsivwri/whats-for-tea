  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Bake the chips",
      "blocks": [
        "Heat oven to 220°C / 200°C fan / gas mark 7. Cut unpeeled potatoes into chips, toss with vegetable oil, salt and pepper on a lined tray and bake 25 minutes until golden and crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
