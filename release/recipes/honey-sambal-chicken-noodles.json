    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the noodles and beans",
      "blocks": [
        "Boil the noodles and beans for 4 minutes until tender. Drain and rinse under cold water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles and beans",
          "seconds": [
            240
          ]
        }
