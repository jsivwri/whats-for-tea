  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the garlic, beans and peanuts",
      "blocks": [
        "Bring a large saucepan of water with {{noodle-salt}} salt to a boil. Peel and grate or press the garlic. Trim and halve the green beans. Crush the peanuts with a rolling pin."
      ],
      "notes": [],
      "timers": [],
