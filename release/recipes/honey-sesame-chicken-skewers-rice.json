  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Heat the grill and prepare the salad",
      "blocks": [
        "Heat the grill to medium-high. Soak the skewers in cold water. Cut the cucumber into batons and wash, dry and finely shred the lettuce."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-1-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-1-sketch.webp",
        "alt": "Heat the grill and prepare the salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Mix the sesame marinade",
      "blocks": [
        "Cut the chicken into bites. Stir together the soy sauce, honey and sesame seeds. For children, you can hold back the sesame seeds and sprinkle them on at serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-2-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-2-sketch.webp",
        "alt": "Mix the sesame marinade",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Marinate the chicken",
      "blocks": [
        "Turn the chicken pieces in the marinade until coated."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-3-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-3-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Thread the skewers",
      "blocks": [
        "Thread the marinated chicken onto the soaked skewers."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-4-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-4-sketch.webp",
        "alt": "Thread the skewers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Grill the chicken",
      "blocks": [
        "Lay the skewers on a foil-lined tray and turn up the foil edges to catch the juices. Pour the remaining marinade over the skewers. Grill for 14–15 minutes, turning halfway, until golden and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Grill the chicken skewers",
          "seconds": [
            840,
            900
          ]
        }
      ],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-5-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-5-sketch.webp",
        "alt": "Grill the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Cook the rice",
      "blocks": [
        "Put the rice and {{rice-water}} cold water into a saucepan with a lid. Bring to the boil over high heat, then reduce to very low, cover and cook for 12–15 minutes until the water is absorbed and the rice is tender. Take off the heat and leave covered to steam."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-6-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-6-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Make the dressing and mayonnaise",
      "blocks": [
        "Stir the rice vinegar and toasted sesame oil with a drizzle of olive oil, a pinch of sugar and a generous pinch of salt. When the chicken is cooked, stir the fully cooked tray juices into the mayonnaise, or keep some plain for serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "honey-sesame-chicken-skewers-rice-7-sketch",
        "path": "media/honey-sesame-chicken-skewers-rice-7-sketch.webp",
        "alt": "Make the dressing and mayonnaise",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Serve the chicken over the rice with the cucumber and lettuce alongside. Drizzle the chicken and rice with mayonnaise and the salad with the sesame dressing."
      ],
      "notes": [],
      "timers": [],
