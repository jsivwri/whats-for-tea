  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the chunks",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 2 cm chunks. Toss with oil, salt, pepper and sesame seeds. Spread in a single layer on one or more baking trays. Roast on the top shelf for 30–40 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chunks",
          "seconds": [
            1800,
            2400
          ]
        }
      ],
