  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Bake the rosemary chips",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 1 cm chips. Toss with oil, dried rosemary, salt and pepper. Spread in a single layer on one or more trays. Bake on the top shelf for 25–30 minutes until golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chips",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "hot-honey-spiced-chicken-thighs-1-sketch",
        "path": "media/hot-honey-spiced-chicken-thighs-1-sketch.webp",
        "alt": "Bake the rosemary chips",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Season the chicken",
      "blocks": [
        "Toss the chicken with the Central American spice mix, a drizzle of oil, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "hot-honey-spiced-chicken-thighs-2-sketch",
        "path": "media/hot-honey-spiced-chicken-thighs-2-sketch.webp",
        "alt": "Season the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Fry the chicken and mix the hot honey",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over medium-high. Lay the chicken flat and fry until browned, 3–4 minutes per side. Meanwhile, mix the honey and hot sauce. If the honey is stiff, warm its container in hot water for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry each side",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "hot-honey-spiced-chicken-thighs-3-sketch",
        "path": "media/hot-honey-spiced-chicken-thighs-3-sketch.webp",
        "alt": "Fry the chicken and mix the hot honey",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Bake the chicken",
      "blocks": [
        "Transfer the browned chicken to a foil-lined tray. Turn the chips and move them to the middle shelf. Bake the chicken on the top shelf for 12–15 minutes, until cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chicken",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "hot-honey-spiced-chicken-thighs-4-sketch",
        "path": "media/hot-honey-spiced-chicken-thighs-4-sketch.webp",
        "alt": "Bake the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the salad",
      "blocks": [
        "Trim and halve the baby gem lengthways, then slice it thinly. Cut the tomato into 1 cm chunks. Mix the vinegar with a drizzle of oil, a pinch of sugar if available, and salt and pepper. Toss in the tomato. Add the lettuce just before serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "hot-honey-spiced-chicken-thighs-5-sketch",
        "path": "media/hot-honey-spiced-chicken-thighs-5-sketch.webp",
        "alt": "Make the salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the chicken between plates and drizzle over the hot honey. Serve with the rosemary chips and salad."
      ],
      "notes": [],
      "timers": [],
