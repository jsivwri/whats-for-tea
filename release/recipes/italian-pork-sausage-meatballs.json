  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Boil the potatoes",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil a full kettle. Cut the potatoes into 2 cm chunks, peeling if desired. Fill a saucepan with boiled water and {{potato-salt}} salt. Boil the potatoes 15–18 minutes until a knife slips through easily."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the potatoes",
          "seconds": [
            900,
            1080
          ]
        }
      ],
      "image": {
        "id": "italian-pork-sausage-meatballs-1",
        "path": "media/italian-pork-sausage-meatballs-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pot of diced potatoes",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Make the meatballs",
      "blocks": [
        "Halve, deseed and thinly slice the pepper. Roll the sausage meat into five even meatballs per person. Bake on the top shelf for 10–12 minutes until browned and cooked through with no pink centre. Wash hands and equipment after handling raw meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the meatballs",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "italian-pork-sausage-meatballs-2",
        "path": "media/italian-pork-sausage-meatballs-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of raw pork and oregano meatballs on rectangular tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Fry the pepper",
      "blocks": [
        "Heat oil over medium-high and stir-fry the pepper 5–6 minutes until charred. Peel and grate the garlic. Lower the heat and fry the garlic with the pepper for 1 minute until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the pepper · 5–6 min",
          "seconds": [
            300,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the pepper · 1 min",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "italian-pork-sausage-meatballs-3",
        "path": "media/italian-pork-sausage-meatballs-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of strips of red pepper frying in black pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Make the sauce and mash",
      "blocks": [
        "Stir passata, herbs, red wine stock paste, {{sauce-sugar}} sugar and {{sauce-water}} water into the peppers. Bring to a boil, then simmer 4–5 minutes until slightly thickened. Drain and mash the potatoes off the heat, adding butter and milk if available. Season and cover."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the sauce and mash",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "italian-pork-sausage-meatballs-4",
        "path": "media/italian-pork-sausage-meatballs-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of mashed potatoes in small saucepan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Finish the sauce",
      "blocks": [
        "Wilt the spinach into the sauce a handful at a time for 1–2 minutes until piping hot. Stir in the cooked meatballs and half the hard cheese. Season and loosen with water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish the sauce",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "italian-pork-sausage-meatballs-5",
        "path": "media/italian-pork-sausage-meatballs-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of meatballs in tomato spinach sauce",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve",
      "blocks": [
        "Share the mash between bowls, top with the meatballs and sauce, and sprinkle with remaining cheese."
      ],
      "notes": [],
      "timers": [],
