  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the rice",
      "blocks": [
        "Take the steaks out of the fridge. Add {{rice-water}} water, rice and {{rice-salt}} salt to a tightly lidded saucepan. Bring to a boil, reduce to medium, cover and cook 10 minutes. Remove from the heat and leave covered for another 10 minutes or until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
