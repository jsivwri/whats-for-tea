  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the beans and garlic",
      "blocks": [
        "Trim the green beans and cut into thirds. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "korma-mango-chicken-couscous-1-sketch",
        "path": "media/korma-mango-chicken-couscous-1-sketch.webp",
        "alt": "Prepare the beans and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Char the beans",
      "blocks": [
        "Heat a little oil in a saucepan over medium-high. Stir-fry the green beans for 2–3 minutes until they begin to char and soften. Lower to medium, add the garlic and cook for 30 seconds."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the beans",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "korma-mango-chicken-couscous-2-sketch",
        "path": "media/korma-mango-chicken-couscous-2-sketch.webp",
        "alt": "Char the beans",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the couscous",
      "blocks": [
        "Add {{couscous-water}} water and the stock paste to the beans and bring to the boil. Take off the heat, stir in the couscous and cover tightly for 8–10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Steam the couscous",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "korma-mango-chicken-couscous-3-sketch",
        "path": "media/korma-mango-chicken-couscous-3-sketch.webp",
        "alt": "Cook the couscous",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Fry the chicken",
      "blocks": [
        "Heat a little oil in a large frying pan over medium-high. Season the diced chicken and fry for 8–10 minutes until golden and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "korma-mango-chicken-couscous-4-sketch",
        "path": "media/korma-mango-chicken-couscous-4-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the salsa and glaze",
      "blocks": [
        "Cut the tomatoes into 1 cm chunks and toss with olive oil, salt and pepper. Set aside. Stir the korma paste, mango chutney, half the yoghurt and {{sauce-water}} water into the cooked chicken. Bring to a boil and simmer for 2–3 minutes until slightly thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the glaze",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "korma-mango-chicken-couscous-5-sketch",
        "path": "media/korma-mango-chicken-couscous-5-sketch.webp",
        "alt": "Make the salsa and glaze",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the couscous and beans among bowls and top with the glazed chicken, tomato salsa and remaining yoghurt."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "korma-mango-chicken-couscous-6-sketch",
        "path": "media/korma-mango-chicken-couscous-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
