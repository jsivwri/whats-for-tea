  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Fry the onions",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Peel and grate or press the garlic. Peel and thinly slice the onion. Heat oil in a saucepan over medium heat, season the onion and fry for 10–12 minutes until golden. Stir in {{sugar}} sugar and cook for 1–2 minutes until caramelised."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the onion",
          "seconds": [
            600,
            720
          ]
        },
        {
          "id": "timer-2",
          "label": "Caramelise the onion",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "lamb-koftas-harissa-couscous-1-sketch",
        "path": "media/lamb-koftas-harissa-couscous-1-sketch.webp",
        "alt": "Fry the onions",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the koftas",
      "blocks": [
        "Mix the breadcrumbs, {{crumb-salt}} salt, {{crumb-water}} water and half the garlic. Add the lamb and pepper and mix well. Shape into four mini sausages per serving and flatten slightly. Bake on a tray on the top shelf for 12–15 minutes until browned and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the koftas",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "lamb-koftas-harissa-couscous-2-sketch",
        "path": "media/lamb-koftas-harissa-couscous-2-sketch.webp",
        "alt": "Make the koftas",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the couscous",
      "blocks": [
        "Boil a full kettle. Trim the beans and cut into thirds. Bring {{couscous-water}} boiling water and half the stock paste to a boil in the onion pan. Take off the heat, stir in the couscous, cover and leave for 8–10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Steam the couscous",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "lamb-koftas-harissa-couscous-3-sketch",
        "path": "media/lamb-koftas-harissa-couscous-3-sketch.webp",
        "alt": "Cook the couscous",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Start the sauce",
      "blocks": [
        "For the dressing, stir together the cider vinegar, a drizzle of oil and a pinch of sugar. Fry the tomato purée, green beans and remaining garlic in a little oil over medium heat for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics and beans",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "lamb-koftas-harissa-couscous-4-sketch",
        "path": "media/lamb-koftas-harissa-couscous-4-sketch.webp",
        "alt": "Start the sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer the harissa sauce",
      "blocks": [
        "Add {{sauce-water}} water and the remaining stock paste. Simmer for 4–5 minutes until the beans are tender and the sauce thickens. Stir in the harissa to taste and {{honey}} honey. Take off the heat and turn the koftas in the sauce."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the harissa sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "lamb-koftas-harissa-couscous-5-sketch",
        "path": "media/lamb-koftas-harissa-couscous-5-sketch.webp",
        "alt": "Simmer the harissa sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Fluff the couscous and spoon it into bowls. Top with koftas and sauce. Toss the leaves in the dressing and serve alongside."
      ],
      "notes": [],
      "timers": [],
