  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Roast the squash",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Take the steaks out of the fridge. Trim, halve and deseed the squash. Slice into 1 cm half-moons, peeling if desired. Toss with oil and seasoning, spread on a tray and roast on the top shelf for 25–30 minutes, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the squash",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "lamb-steaks-mint-salsa-verde-1",
        "path": "media/lamb-steaks-mint-salsa-verde-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of butternut squash cut into thin half-moons on board",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Make the salsa",
      "blocks": [
        "Strip and roughly chop the mint and halve the lime. Mix most of the mint with lime juice, {{salsa-sugar}} sugar, {{salsa-oil}} olive oil, half the green chilli paste and seasoning."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "lamb-steaks-mint-salsa-verde-2",
        "path": "media/lamb-steaks-mint-salsa-verde-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small bowl of green chilli and mint salsa",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Make the slaw",
      "blocks": [
        "Mix cabbage, yoghurt, {{slaw-sugar}} sugar, a squeeze of lime and remaining chilli paste. Season. At the halfway point, toss the squash with half the Brazilian spice mix and return to the oven for 12–15 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the slaw",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "lamb-steaks-mint-salsa-verde-3",
        "path": "media/lamb-steaks-mint-salsa-verde-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small bowl of red cabbage slaw",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Fry the lamb",
      "blocks": [
        "Heat oil in a large pan on high and season the steaks. Fry for 8–10 minutes total for medium rare, turning every 2 minutes. Adjust for thickness and preferred doneness."
      ],
      "notes": [
        "For a more well-done steak, cook for another 1–2 minutes on each side."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the lamb",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "lamb-steaks-mint-salsa-verde-4",
        "path": "media/lamb-steaks-mint-salsa-verde-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two lamb steaks in frying pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Season and rest",
      "blocks": [
        "Lower the heat, add remaining spice mix and turn the steaks in it for 1 minute. Rest under foil for a couple of minutes. Wash hands and equipment after handling raw meat. Drizzle the roasted squash with {{squash-honey}} honey and toss."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Season and rest",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "lamb-steaks-mint-salsa-verde-5",
        "path": "media/lamb-steaks-mint-salsa-verde-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of lamb steaks resting under foil",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve",
      "blocks": [
        "Slice the steaks widthways. Serve with squash and slaw, spoon salsa over the lamb and scatter crispy onions and remaining mint over the vegetables and slaw."
      ],
      "notes": [],
      "timers": [],
