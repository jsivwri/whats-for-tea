  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Make the meatballs",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Boil a full kettle. Peel and grate or press the garlic.",
        "Mix the breadcrumbs with {{crumb-salt}} salt and {{crumb-water}} water, a quarter of the chermoula and half the garlic. Add the mince, season with pepper and mix well. Roll into five even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "lebanese-baked-meatballs-couscous-1-sketch",
        "path": "media/lebanese-baked-meatballs-couscous-1-sketch.webp",
        "alt": "Make the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Bake the meatballs",
      "blocks": [
        "Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through. Meanwhile, trim and coarsely grate the unpeeled carrot."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "lebanese-baked-meatballs-couscous-2-sketch",
        "path": "media/lebanese-baked-meatballs-couscous-2-sketch.webp",
        "alt": "Bake the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the couscous",
      "blocks": [
        "Pour {{couscous-water}} boiling water over the couscous and stir in the chicken stock paste. Cover tightly and leave for 8–10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Steam the couscous",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "lebanese-baked-meatballs-couscous-3-sketch",
        "path": "media/lebanese-baked-meatballs-couscous-3-sketch.webp",
        "alt": "Cook the couscous",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the tomato sauce",
      "blocks": [
        "Heat a little oil in a large frying pan over medium-high. Fry the carrot, remaining chermoula to taste and remaining garlic for 1–2 minutes. Stir in the passata, beef stock paste, {{sugar}} sugar and {{sauce-water}} water. Simmer for 6–7 minutes until thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            360,
            420
          ]
        }
      ],
      "image": {
        "id": "lebanese-baked-meatballs-couscous-4-sketch",
        "path": "media/lebanese-baked-meatballs-couscous-4-sketch.webp",
        "alt": "Make the tomato sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the spinach and meatballs",
      "blocks": [
        "Chop the parsley, stalks included. Stir the sun-dried tomato paste into the thickened sauce. Add the spinach a handful at a time and cook for 1–2 minutes until wilted and piping hot. Add the cooked meatballs and season to taste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "lebanese-baked-meatballs-couscous-5-sketch",
        "path": "media/lebanese-baked-meatballs-couscous-5-sketch.webp",
        "alt": "Add the spinach and meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Fluff the couscous, stir through half the parsley and divide among bowls. Spoon over the meatballs and tomato sauce, and finish with the remaining parsley."
      ],
      "notes": [],
      "timers": [],
