  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the garlic",
      "blocks": [
        "Heat the oven to 220°C (200°C fan, gas 7). Bring a large saucepan of water with {{pasta-salt}} salt to a boil for the linguine. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "lovers-linguine-herby-meatballs-1-sketch",
        "path": "media/lovers-linguine-herby-meatballs-1-sketch.webp",
        "alt": "Prepare the garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Shape the meatballs",
      "blocks": [
        "Mix the breadcrumbs with {{crumb-salt}} salt and {{crumb-water}} water, the mixed herbs and half the garlic. Add the mince, season with pepper and mix well. Roll into five even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "lovers-linguine-herby-meatballs-2-sketch",
        "path": "media/lovers-linguine-herby-meatballs-2-sketch.webp",
        "alt": "Shape the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake and cook the pasta",
      "blocks": [
        "Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through.",
        "Boil the linguine for 12 minutes until tender. Drain, return to the saucepan and toss with a little oil to prevent sticking."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        },
        {
          "id": "timer-2",
          "label": "Cook the linguine",
          "seconds": [
            720
          ]
        }
      ],
      "image": {
        "id": "lovers-linguine-herby-meatballs-3-sketch",
        "path": "media/lovers-linguine-herby-meatballs-3-sketch.webp",
        "alt": "Bake and cook the pasta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the red wine sauce",
      "blocks": [
        "Heat a drizzle of oil in a frying pan over medium-high. Season the mushrooms and fry for 5–6 minutes until browned. Add the remaining garlic and fry for 30 seconds. Stir in the tomatoes, red wine stock paste, sun-dried tomato paste, {{sugar}} sugar and {{sauce-water}} water. Lower the heat and simmer for 5–6 minutes until thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the mushrooms",
          "seconds": [
            300,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "lovers-linguine-herby-meatballs-4-sketch",
        "path": "media/lovers-linguine-herby-meatballs-4-sketch.webp",
        "alt": "Make the red wine sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Combine",
      "blocks": [
        "Stir in the spinach a handful at a time and cook for 1–2 minutes until wilted and piping hot. Toss in the cooked meatballs and linguine for 1–2 minutes. Stir through the cheese and {{butter}} butter until melted. Taste and season, adding a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Toss with the sauce",
          "seconds": [
            60,
