  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the wedges",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Cut unpeeled sweet potatoes into 2 cm wedges. Toss on a baking tray with oil, salt and pepper. Spread in one layer, using two trays if needed.",
        "Roast on the middle shelf for 30–40 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the wedges",
          "seconds": [
            1800,
            2400
          ]
        }
      ],
