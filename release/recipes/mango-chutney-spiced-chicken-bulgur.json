  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Soften the onion and prep the carrots",
      "blocks": [
        "Preheat the oven to 180°C. Halve, peel and thinly slice the red onion. Heat a drizzle of oil and an optional knob of butter in a saucepan over medium-high. Fry the onion for 8–10 minutes, stirring regularly. Cut the trimmed carrots into 1 cm by 5 cm batons, toss with oil, salt and pepper on a tray and set aside."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the onion",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "mango-chutney-spiced-chicken-bulgur-1-sketch",
        "path": "media/mango-chutney-spiced-chicken-bulgur-1-sketch.webp",
        "alt": "Soften the onion and prep the carrots",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Roast the carrots and garlic",
      "blocks": [
        "Season the yoghurt. Pick and chop the mint leaves. Peel the garlic. Wrap one clove in foil with a drizzle of oil; grate the rest. Roast the carrots on the top shelf for 20–25 minutes, turning halfway and adding the garlic parcel for the last 10–12 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the carrots",
          "seconds": [
            1200,
            1500
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the garlic",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "mango-chutney-spiced-chicken-bulgur-2-sketch",
        "path": "media/mango-chutney-spiced-chicken-bulgur-2-sketch.webp",
        "alt": "Roast the carrots and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the cumin bulgur",
      "blocks": [
        "Add the grated garlic and cumin to the softened onion and fry for 1 minute. Add {{bulgur-water}} water and bring to a boil. Stir in the stock powder and bulgur, return to the boil and simmer for 1 minute. Cover, take off the heat and leave for 12–15 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "mango-chutney-spiced-chicken-bulgur-3-sketch",
        "path": "media/mango-chutney-spiced-chicken-bulgur-3-sketch.webp",
        "alt": "Cook the cumin bulgur",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Season the chicken",
      "blocks": [
        "Heat a dry frying pan over medium-high. Mix the pasanda seasoning with {{chicken-oil}} olive oil, salt and pepper, then coat the chicken."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mango-chutney-spiced-chicken-bulgur-4-sketch",
        "path": "media/mango-chutney-spiced-chicken-bulgur-4-sketch.webp",
        "alt": "Season the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Brown, roast and glaze the chicken",
      "blocks": [
        "Fry skin-side down for 4–5 minutes until golden, then turn and fry for 3–4 minutes. Put the chicken on the carrot tray and roast for 8–10 minutes until cooked through. Turn the cooked chicken in the mango chutney."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the skin",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the other side",
          "seconds": [
            180,
            240
          ]
        },
        {
          "id": "timer-3",
          "label": "Roast the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "mango-chutney-spiced-chicken-bulgur-5-sketch",
        "path": "media/mango-chutney-spiced-chicken-bulgur-5-sketch.webp",
        "alt": "Brown, roast and glaze the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Mash the roasted garlic and mix into the yoghurt. Stir half the mint into the bulgur and adjust the seasoning. Slice the chicken and serve on the bulgur with the carrots. Add any tray juices, the garlic yoghurt and the remaining mint."
      ],
      "notes": [],
      "timers": [],
