  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cut the chips",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Slice the unpeeled potatoes lengthways into 1 cm slices and cut into 1 cm chips."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "marinara-chicken-bake-w44-1",
