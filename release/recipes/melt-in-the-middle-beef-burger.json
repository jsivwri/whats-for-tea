  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the wedges",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 2 cm wedges. Toss with oil, salt and pepper. Spread in one layer on one or more trays and roast on the top shelf for 25–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the wedges",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "melt-in-the-middle-beef-burger-1-sketch",
        "path": "media/melt-in-the-middle-beef-burger-1-sketch.webp",
        "alt": "Roast the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prepare the cheese and garlic",
      "blocks": [
        "Cut the Cheddar into even chunks. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "melt-in-the-middle-beef-burger-2-sketch",
        "path": "media/melt-in-the-middle-beef-burger-2-sketch.webp",
        "alt": "Prepare the cheese and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Shape the burgers",
      "blocks": [
        "Mix the sun-dried tomato paste, garlic and breadcrumbs with the beef, salt and pepper. Form one patty per serving, about 2 cm thick, sealing a chunk of cheese inside each."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "melt-in-the-middle-beef-burger-3-sketch",
        "path": "media/melt-in-the-middle-beef-burger-3-sketch.webp",
        "alt": "Shape the burgers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Bake the burgers",
      "blocks": [
        "Bake the patties on a tray on the middle shelf for 12–15 minutes until cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the burgers",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "melt-in-the-middle-beef-burger-4-sketch",
        "path": "media/melt-in-the-middle-beef-burger-4-sketch.webp",
        "alt": "Bake the burgers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Warm the buns",
      "blocks": [
        "Halve the buns and warm them on a tray in the oven for 2–3 minutes while the wedges and burgers finish."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the buns",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "melt-in-the-middle-beef-burger-5-sketch",
        "path": "media/melt-in-the-middle-beef-burger-5-sketch.webp",
        "alt": "Warm the buns",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Spread {{mayonnaise}} mayonnaise across the bun bases and top with the burgers and some pea shoots. Spoon on any cheese that escaped onto the tray. Serve with the wedges and remaining pea shoots drizzled with balsamic glaze."
      ],
