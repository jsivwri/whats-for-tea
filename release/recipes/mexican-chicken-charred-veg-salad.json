  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the chicken",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Put the chicken on a tray and sprinkle with the Mexican spice mix, oil, salt and pepper. Roast on the top shelf for 25–30 minutes until cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-1-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-1-sketch.webp",
        "alt": "Roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the croutons",
      "blocks": [
        "Trim and halve the lettuce lengthways, then thinly slice. Deseed and thinly slice the bell pepper. Grate the cheese. Tear the ciabatta into 2 cm pieces and toss with oil, salt and pepper on a second tray. About 10 minutes before the chicken finishes, bake the croutons on the middle shelf for 8–10 minutes until golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the croutons",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-2-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-2-sketch.webp",
        "alt": "Make the croutons",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Char the vegetables",
      "blocks": [
        "Drain the sweetcorn. Heat a dry large frying pan over medium-high. Fry the sweetcorn and sliced pepper for 5–6 minutes until charred, stirring only a couple of times. Adjust the heat if needed, then take off the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the vegetables",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-3-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-3-sketch.webp",
        "alt": "Char the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the dressing",
      "blocks": [
        "Whisk the cider vinegar with {{dressing-sugar}} sugar, {{dressing-oil}} olive oil, salt and pepper in a large bowl."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-4-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-4-sketch.webp",
        "alt": "Make the dressing",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Toss the salad",
      "blocks": [
        "Slice the cooked chicken crossways into 2 cm pieces. Toss the lettuce, charred vegetables and croutons in the dressing."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-5-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-5-sketch.webp",
        "alt": "Toss the salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the salad among bowls and top with sliced chicken and grated Cheddar. Finish with {{mayonnaise}} mayonnaise in total."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "mexican-chicken-charred-veg-salad-6-sketch",
        "path": "media/mexican-chicken-charred-veg-salad-6-sketch.webp",
