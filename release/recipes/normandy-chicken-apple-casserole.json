  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get ready",
      "blocks": [
        "Set out a casserole safe for both the hob and oven. If needed, start in a wide frying pan and transfer to an ovenproof dish. Wash the produce."
      ],
      "notes": [],
      "timers": []
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Heat the oven and prepare the apple",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7) and boil half a kettle. Heat olive oil in the casserole over medium-high. Core and wedge the apple."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "normandy-chicken-apple-casserole-1-sketch",
        "path": "media/normandy-chicken-apple-casserole-1-sketch.webp",
        "alt": "Heat the oven and prepare the apple",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Slice the onion",
      "blocks": [
        "Peel the onion and cut into wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "normandy-chicken-apple-casserole-2-sketch",
        "path": "media/normandy-chicken-apple-casserole-2-sketch.webp",
        "alt": "Slice the onion",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Start the chicken",
      "blocks": [
        "Add the chicken and {{flour}} flour to the casserole and cook for 30 seconds. Crush the garlic cloves and remove the skins."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "normandy-chicken-apple-casserole-3-sketch",
        "path": "media/normandy-chicken-apple-casserole-3-sketch.webp",
        "alt": "Start the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the apple and stock",
      "blocks": [
        "Stir in the apple, onion and crushed garlic. Add the stock mix and {{stew-water}} boiling water."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "normandy-chicken-apple-casserole-4-sketch",
        "path": "media/normandy-chicken-apple-casserole-4-sketch.webp",
        "alt": "Add the apple and stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Bake the casserole",
      "blocks": [
        "Stir in the Chinese rice wine, mustard and soft cheese. Bring to the boil over high heat, then bake uncovered for 30–35 minutes until the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the casserole",
          "seconds": [
            1800,
            2100
          ]
        }
      ],
      "image": {
        "id": "normandy-chicken-apple-casserole-5-sketch",
        "path": "media/normandy-chicken-apple-casserole-5-sketch.webp",
        "alt": "Bake the casserole",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Roast the beans and warm the bread",
      "blocks": [
        "When the casserole is nearly done, put the green beans on one side of a baking tray with olive oil and a pinch of salt. Put the ciabatta on the other side. Bake for 5–7 minutes until the beans are tender with a bite and the bread is crusty."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the beans and warm the bread",
          "seconds": [
            300,
            420
          ]
        }
      ],
      "image": {
        "id": "normandy-chicken-apple-casserole-6-sketch",
        "path": "media/normandy-chicken-apple-casserole-6-sketch.webp",
        "alt": "Roast the beans and warm the bread",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Chop the chives and scatter them over the casserole. Season with pepper and serve with the green beans and crusty ciabatta. Butter the bread if you like."
      ],
      "notes": [],
      "timers": [],
