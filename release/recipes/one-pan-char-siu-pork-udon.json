  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the carrots and spring onions",
      "blocks": [
        "Trim and halve the unpeeled carrots lengthways, then slice crossways about ½ cm thick. Trim and thinly slice the spring onions, separating the white and green parts."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "one-pan-char-siu-pork-udon-1-sketch",
        "path": "media/one-pan-char-siu-pork-udon-1-sketch.webp",
        "alt": "Prepare the carrots and spring onions",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the mince and vegetables",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over high heat. Fry the mince, mushrooms, carrot and spring onion whites for 5–6 minutes until the mince browns and the vegetables soften. Break up the mince as it cooks, drain excess fat and season."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the mince and vegetables",
          "seconds": [
            300,
