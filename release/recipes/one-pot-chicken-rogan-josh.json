  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get ready",
      "blocks": [
        "Set out a casserole safe for both the hob and oven. If needed, start in a wide frying pan and transfer to an ovenproof dish. Wash the produce."
      ],
      "notes": [],
      "timers": []
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Heat the oven and casserole",
      "blocks": [
        "Preheat the oven to 200°C (180°C fan, gas 6). Boil half a kettle. Heat a drizzle of vegetable oil in the casserole over high heat."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "one-pot-chicken-rogan-josh-1-sketch",
        "path": "media/one-pot-chicken-rogan-josh-1-sketch.webp",
        "alt": "Heat the oven and casserole",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Add the onion and tomato",
      "blocks": [
        "Peel the onion and cut it and the fresh tomato into wedges. Add them to the casserole with a pinch of salt."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "one-pot-chicken-rogan-josh-2-sketch",
        "path": "media/one-pot-chicken-rogan-josh-2-sketch.webp",
        "alt": "Add the onion and tomato",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Crush the aromatics",
      "blocks": [
        "Crush the garlic cloves with the flat side of a knife and remove the skins. Lightly crush the cardamom pods open."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "one-pot-chicken-rogan-josh-3-sketch",
        "path": "media/one-pot-chicken-rogan-josh-3-sketch.webp",
        "alt": "Crush the aromatics",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the spices",
      "blocks": [
        "Stir in the garlic, cardamom, turmeric, ground coriander, curry powder and chilli flakes to taste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "one-pot-chicken-rogan-josh-4-sketch",
        "path": "media/one-pot-chicken-rogan-josh-4-sketch.webp",
        "alt": "Add the spices",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Bake the curry",
      "blocks": [
        "Add the stock mix listed for your serving size, chopped tomatoes, a pinch of sugar and {{sauce-water}} boiling water. Add the diced chicken breast and bring to the boil. Bake uncovered for 30–35 minutes until the chicken is cooked through and the sauce has thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the curry",
          "seconds": [
            1800,
            2100
          ]
        }
      ],
      "image": {
        "id": "one-pot-chicken-rogan-josh-5-sketch",
        "path": "media/one-pot-chicken-rogan-josh-5-sketch.webp",
        "alt": "Bake the curry",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Warm the naan",
      "blocks": [
        "When the curry is almost done, remove the cardamom pods. Warm the naan on a baking tray in the oven for 3–4 minutes. Use two trays if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the naan",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "one-pot-chicken-rogan-josh-6-sketch",
        "path": "media/one-pot-chicken-rogan-josh-6-sketch.webp",
        "alt": "Warm the naan",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Top the curry with natural yoghurt and serve with the warm naan."
      ],
      "notes": [],
      "timers": [],
