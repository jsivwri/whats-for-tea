  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get the equipment ready",
      "blocks": [
        "Set out an ovenproof casserole and lid that are also safe on the hob. If you don’t have one, use a wide pan on the hob, then transfer to an ovenproof dish and cover tightly with foil. Wash the produce."
      ],
      "notes": [],
      "timers": []
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Heat the oven and prepare the feta",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Boil a kettle and warm the casserole over medium heat. Place the feta on a large foil-lined baking tray."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-1-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-1-sketch.webp",
        "alt": "Heat the oven and prepare the feta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Add the tomatoes",
      "blocks": [
        "Halve half the cherry tomatoes. Add both the halved and whole tomatoes to the tray with the feta and drizzle with olive oil."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-2-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-2-sketch.webp",
        "alt": "Add the tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Season the feta",
      "blocks": [
        "Drizzle over the balsamic vinegar and sprinkle with chilli flakes to taste. Set the tray aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-3-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-3-sketch.webp",
        "alt": "Season the feta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the tomato stock",
      "blocks": [
        "Dissolve the vegetable stock mix and tomato paste in {{stock-water}} boiling water. Cut the Tenderstem broccoli into thirds."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-4-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-4-sketch.webp",
        "alt": "Make the tomato stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Bake the pasta",
      "blocks": [
        "Put the tomato stock, farfalle and broccoli into the casserole and bring to the boil over high heat. Push the pasta under the stock for even cooking. Cover and bake for 25–30 minutes until tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the pasta",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-5-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-5-sketch.webp",
        "alt": "Bake the pasta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Bake the feta and tomatoes",
      "blocks": [
        "Bake the feta and tomato tray alongside the pasta for about 25 minutes until softened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the feta and tomatoes",
          "seconds": [
            1500
          ]
        }
      ],
      "image": {
        "id": "oven-baked-feta-tenderstem-farfalle-6-sketch",
        "path": "media/oven-baked-feta-tenderstem-farfalle-6-sketch.webp",
        "alt": "Bake the feta and tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Finish and serve",
      "blocks": [
        "Stir the softened feta, tomatoes and tray juices into the pasta. Tear in the basil leaves, discarding the stalks. Season with salt and black pepper."
      ],
      "notes": [],
      "timers": [],
