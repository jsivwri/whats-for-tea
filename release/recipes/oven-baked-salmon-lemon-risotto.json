  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the shallot and lemon",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Boil a full kettle. Halve, peel and thinly slice the shallot. Zest and halve the lemon. Peel and grate or press the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-1-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-1-sketch.webp",
        "alt": "Prepare the shallot and lemon",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Start the risotto",
      "blocks": [
        "Heat a drizzle of oil in a wide ovenproof pan over medium heat. Fry the shallot for 4–5 minutes, then fry the garlic for 1 minute. Stir in the rice and cook for 1–2 minutes until the edges of the grains are translucent. If using a regular pan, transfer the rice to an ovenproof dish before baking."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the shallot",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Toast the rice",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-2-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-2-sketch.webp",
        "alt": "Start the risotto",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake the rice",
      "blocks": [
        "Stir in {{risotto-water}} boiling water and the vegetable stock paste. Return to the boil and cover with a lid or foil. Bake on the middle shelf for 25–30 minutes until the rice is tender and the water is absorbed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the risotto",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-3-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-3-sketch.webp",
        "alt": "Bake the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Roast the salmon",
      "blocks": [
        "Meanwhile, lay the fillets skin-side down on a lined baking tray and season. Roast on the top shelf for 10–15 minutes until opaque in the centre."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the salmon",
          "seconds": [
            600,
            900
          ]
        }
      ],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-4-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-4-sketch.webp",
        "alt": "Roast the salmon",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the greens",
      "blocks": [
        "With 5 minutes left, stir the peas and spinach into the risotto. Bake for the last 5 minutes until piping hot. Stir in the grated hard cheese, a knob of butter if available, a squeeze of lemon juice and half the zest. Taste and season, loosening with a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish cooking the greens",
          "seconds": [
            300
          ]
        }
      ],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-5-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-5-sketch.webp",
        "alt": "Add the greens",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Spoon into bowls, top with salmon and scatter over the remaining zest. Serve with lemon wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "oven-baked-salmon-lemon-risotto-6-sketch",
        "path": "media/oven-baked-salmon-lemon-risotto-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
