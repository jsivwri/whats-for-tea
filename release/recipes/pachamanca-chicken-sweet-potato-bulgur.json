  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the sweet potatoes and mint",
      "blocks": [
        "Halve the unpeeled sweet potatoes lengthways and slice into 1 cm half moons. Peel and grate or press the garlic. Pick and roughly chop the mint leaves."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-1-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-1-sketch.webp",
        "alt": "Prepare the sweet potatoes and mint",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Brown the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large saucepan over medium-high. Lay the chicken flat, season and fry for 4–5 minutes per side until browned. Add the sweet potato, chipotle paste to taste, oregano and garlic. Stir-fry for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-2-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-2-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Simmer the chicken",
      "blocks": [
        "Stir in the red wine vinegar, half the stock paste, half the mint, {{sugar}} sugar and {{sauce-water}} water. Bring to the boil and reduce to medium. Simmer for 20–25 minutes until the sauce thickens and the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the chicken",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-3-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-3-sketch.webp",
        "alt": "Simmer the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Cook the bulgur",
      "blocks": [
        "Bring {{bulgur-water}} water and the rest of the stock paste to a boil in a second saucepan. Stir in the bulgur, bring back to a boil and simmer for 1 minute. Cover, take off the heat and leave for 12–15 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-4-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-4-sketch.webp",
        "alt": "Cook the bulgur",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Wilt the spinach",
      "blocks": [
        "Stir the spinach into the chicken a handful at a time, cooking for 1–2 minutes until wilted and piping hot. Taste and season."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-5-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-5-sketch.webp",
        "alt": "Wilt the spinach",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the bulgur between bowls, top with the chicken and sauce, and scatter over the crumbled Greek style salad cheese and remaining mint."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pachamanca-chicken-sweet-potato-bulgur-6-sketch",
        "path": "media/pachamanca-chicken-sweet-potato-bulgur-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
