  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables and fry the onion",
      "blocks": [
        "Heat the oven to 240°C (220°C fan, gas 9). Deseed and thinly slice the pepper. Halve, peel and thinly slice the onion. Peel and grate or press the garlic. Trim and quarter the courgette lengthways, then slice it into 1 cm pieces. Fry the onion in a little oil in a saucepan over medium heat for 7–8 minutes until softened. If it browns too quickly, add a splash of water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the onion",
          "seconds": [
            420,
            480
          ]
        }
      ],
      "image": {
        "id": "paprika-chicken-spiced-rice-1-sketch",
        "path": "media/paprika-chicken-spiced-rice-1-sketch.webp",
        "alt": "Prepare the vegetables and fry the onion",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Marinate the chicken",
      "blocks": [
        "Combine the smoked paprika, garlic, {{marinade-oil}} olive oil, salt and pepper. Coat the chicken and set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "paprika-chicken-spiced-rice-2-sketch",
        "path": "media/paprika-chicken-spiced-rice-2-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the spiced rice",
      "blocks": [
        "Fry the Mexican spice mix with the onion for 30 seconds. Add {{rice-water}} water, the rice and stock paste. Bring to a boil, lower the heat to medium and cover. Cook for 10 minutes, then remove from the heat and leave covered for another 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "paprika-chicken-spiced-rice-3-sketch",
        "path": "media/paprika-chicken-spiced-rice-3-sketch.webp",
        "alt": "Cook the spiced rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Brown and roast the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over high heat. Brown the chicken for 5 minutes per side, then move to a large tray. Put the pepper and courgette alongside and toss with oil, salt and pepper. Roast on the top shelf for 10–12 minutes until the pepper is soft and the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the chicken and veg",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "paprika-chicken-spiced-rice-4-sketch",
        "path": "media/paprika-chicken-spiced-rice-4-sketch.webp",
        "alt": "Brown and roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Glaze the chicken and finish the rice",
      "blocks": [
        "Turn the cooked chicken in the red pepper chilli jelly and rest for a couple of minutes. Fluff the rice and stir through the sun-dried tomato paste. Season to taste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "paprika-chicken-spiced-rice-5-sketch",
        "path": "media/paprika-chicken-spiced-rice-5-sketch.webp",
        "alt": "Glaze the chicken and finish the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Slice the chicken crossways into 1 cm slices. Serve over the spiced rice with the roasted vegetables and any tray juices. Finish with {{mayonnaise}} mayonnaise in total."
      ],
      "notes": [],
      "timers": [],
