  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Fry the chicken",
      "blocks": [
        "Boil a full kettle. Heat a drizzle of oil in a large frying pan over medium-high and fry the chicken for 8–10 minutes until browned and cooked through. Meanwhile, peel and grate or press the garlic. Trim and thinly slice the spring onion. Deseed and finely chop the chilli."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-1-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-1-sketch.webp",
        "alt": "Fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Finish the prep",
      "blocks": [
        "Zest and wedge the lime. Cut the broccoli into florets and halve them. Deseed the pepper and slice into strips. Transfer the cooked chicken to a bowl and cover with foil. Keep the pan for the vegetables."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-2-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-2-sketch.webp",
        "alt": "Finish the prep",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the noodles",
      "blocks": [
        "Measure {{sauce-water}} boiling water into a jug for the sauce. Put the rest of the kettle water in a large saucepan over high heat. Add {{noodle-salt}} salt and the noodles, return to the boil and cook for 4 minutes. Drain and rinse under cold water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles",
          "seconds": [
            240
          ]
        }
      ],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-3-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-3-sketch.webp",
        "alt": "Cook the noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Stir-fry the vegetables",
      "blocks": [
        "Return the frying pan to high heat with a little more oil if needed. Fry the broccoli and pepper for 2–3 minutes. Stir in the garlic and up to half the chilli for 30 seconds, then add a splash of water, cover and cook for 1–3 minutes until tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Stir-fry the vegetables",
          "seconds": [
            120,
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam until tender",
          "seconds": [
            60,
            180
          ]
        }
      ],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-4-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-4-sketch.webp",
        "alt": "Stir-fry the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the peanut sauce",
      "blocks": [
        "Whisk the ketjap manis, soy sauce and peanut butter into the measured hot water. Add the chicken, noodles and sauce to the vegetables. Toss for 2–3 minutes until piping hot."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish the stir-fry",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-5-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-5-sketch.webp",
        "alt": "Add the peanut sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide between bowls. Garnish with lime zest, spring onion and any remaining chilli to taste. Serve with the lime wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peanut-chicken-broccoli-noodles-6-sketch",
        "path": "media/peanut-chicken-broccoli-noodles-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
