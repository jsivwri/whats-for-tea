  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the chips and garlic",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 1 cm chips and toss with oil, salt and pepper. Spread in one layer on one or more trays. Wrap the unpeeled garlic with a drizzle of oil in a small foil parcel and put it on the chip tray."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peri-peri-chicken-chips-1-sketch",
        "path": "media/peri-peri-chicken-chips-1-sketch.webp",
        "alt": "Prepare the chips and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Roast",
      "blocks": [
        "Roast the chips on the top shelf for 25–35 minutes until golden. Halfway through, remove the garlic parcel and turn the chips."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chips",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "peri-peri-chicken-chips-2-sketch",
        "path": "media/peri-peri-chicken-chips-2-sketch.webp",
        "alt": "Roast",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the salad",
      "blocks": [
        "Zest and halve the lemon. Mix a squeeze of juice with olive oil, salt, pepper and a pinch of sugar if available. Halve the baby plum tomatoes and stir them into the dressing. Taste and add more lemon if needed. Trim and halve the baby gem lengthways, then slice it thinly crossways. Keep it separate for now."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peri-peri-chicken-chips-3-sketch",
        "path": "media/peri-peri-chicken-chips-3-sketch.webp",
        "alt": "Prepare the salad",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Season the chicken",
      "blocks": [
        "Mix the peri peri seasoning, lemon zest, salt and pepper on a plate. Flatten each breast between sheets of baking paper to 1–2 cm thick and turn in the seasoning to coat."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peri-peri-chicken-chips-4-sketch",
        "path": "media/peri-peri-chicken-chips-4-sketch.webp",
        "alt": "Season the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Fry the chicken and make garlic mayo",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan over medium-high. Fry the chicken for 5–6 minutes per side until golden and cooked through. Cover loosely with foil and rest for a couple of minutes. Squeeze the cooled garlic out of its skin, mash and mix with the mayonnaise. Season to taste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry each side",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "peri-peri-chicken-chips-5-sketch",
        "path": "media/peri-peri-chicken-chips-5-sketch.webp",
        "alt": "Fry the chicken and make garlic mayo",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Toss the baby gem through the dressed tomatoes. Slice the chicken crossways into 2 cm slices. Serve with chips, salad, garlic mayo and any remaining lemon cut into wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "peri-peri-chicken-chips-6-sketch",
        "path": "media/peri-peri-chicken-chips-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
