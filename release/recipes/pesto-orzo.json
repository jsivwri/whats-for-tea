  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Fry the chicken",
      "blocks": [
        "Heat the oven to 240°C / 220°C fan / gas mark 9. Bring a large saucepan of water to the boil with {{orzo-salt}} salt for the orzo.",
        "Heat a drizzle of oil in a frying pan over high heat. Lay in the chicken and season with salt and pepper.",
        "Fry until golden, 3–4 minutes, then turn and fry for 1 minute more."
      ],
      "notes": [
        "A stronger smell when first opened can come from the packaging. Wash your hands and equipment after handling raw chicken and its packaging."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Sear chicken",
          "seconds": [
            180,
            240
          ]
        }
      ],
