  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the garlic ciabatta",
      "blocks": [
        "Peel and grate or press the garlic. Halve the ciabatta and place cut-side up on a tray. Spread half the garlic over it and drizzle with {{bread-oil}} olive oil. Bring a large saucepan of water with {{pasta-salt}} salt to the boil."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pizza-chorizo-pasta-bake-1-sketch",
        "path": "media/pizza-chorizo-pasta-bake-1-sketch.webp",
        "alt": "Prepare the garlic ciabatta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the pasta",
      "blocks": [
        "Boil the rigatoni for 12 minutes until tender. Drain, return to the saucepan and toss with a little oil to prevent sticking.",
        "Meanwhile, halve, peel and finely chop the onion. Tear half the chorizo into small pieces. Heat a drizzle of oil in a large frying pan over medium-high."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rigatoni",
          "seconds": [
            720
          ]
        }
      ],
      "image": {
        "id": "pizza-chorizo-pasta-bake-2-sketch",
        "path": "media/pizza-chorizo-pasta-bake-2-sketch.webp",
        "alt": "Cook the pasta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Make the chorizo sauce",
      "blocks": [
        "Fry the onion until soft, 4–5 minutes. Add the torn chorizo and remaining garlic and fry for 1 minute. Add the passata, sun-dried tomato paste, stock paste, mixed herbs, {{sugar}} sugar and {{sauce-water}} water. Bring to a boil and simmer for 4–5 minutes until thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the onion",
          "seconds": [
            240,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "pizza-chorizo-pasta-bake-3-sketch",
        "path": "media/pizza-chorizo-pasta-bake-3-sketch.webp",
        "alt": "Make the chorizo sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Add the spinach and cheese",
      "blocks": [
        "Preheat the grill to high. Drain and tear the mozzarella. Stir the spinach into the sauce a handful at a time until wilted and piping hot, 1–2 minutes. Add {{butter}} butter, the pasta and half the mozzarella. Stir until melted. Season and thin with a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "pizza-chorizo-pasta-bake-4-sketch",
        "path": "media/pizza-chorizo-pasta-bake-4-sketch.webp",
        "alt": "Add the spinach and cheese",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Grill the pasta and bread",
      "blocks": [
        "Transfer the pasta to an ovenproof dish. Top with the remaining mozzarella and chorizo slices. Grill alongside the garlic ciabatta for 5–6 minutes until the bread is golden and the pasta bubbles. Grill in separate batches if needed. Halve the garlic ciabatta diagonally."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Grill the pasta and bread",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "pizza-chorizo-pasta-bake-5-sketch",
        "path": "media/pizza-chorizo-pasta-bake-5-sketch.webp",
        "alt": "Grill the pasta and bread",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the pasta between bowls. Top with rocket and a drizzle of oil, and serve the garlic ciabatta alongside."
      ],
      "notes": [],
      "timers": [],
