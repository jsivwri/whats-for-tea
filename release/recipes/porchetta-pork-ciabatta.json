  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Roast the potatoes",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Halve the unpeeled potatoes, toss with oil and seasoning and roast in a single layer on the middle shelf for 30–35 minutes, turning halfway. Wrap unpeeled garlic with oil in foil and roast for 10–12 minutes until soft."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potatoes · 30–35 min",
          "seconds": [
            1800,
            2100
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the potatoes · 10–12 min",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "porchetta-pork-ciabatta-1",
        "path": "media/porchetta-pork-ciabatta-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of halved salad potatoes on tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Make the dressings",
      "blocks": [
        "Strip and roughly chop rosemary. Zest and wedge the lemon, and chop tomato into 1 cm chunks. Mix half the lemon juice with {{salad-sugar}} sugar and {{salad-oil}} olive oil. Cool and mash the roasted garlic. Mix half with {{garlic-mayo}} mayonnaise, lemon juice and seasoning."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "porchetta-pork-ciabatta-2",
        "path": "media/porchetta-pork-ciabatta-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of lemon and oil dressing in a bowl",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Fry and roast the pork",
      "blocks": [
        "Season steaks and coat with chilli flakes, lemon zest and half the rosemary. Fry in hot oil for 1–2 minutes each side until browned, then roast on the top shelf 5–6 minutes until cooked through with no pink centre. Rest under cover. Wash hands and equipment after handling raw meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry and roast the pork · 1–2 min",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry and roast the pork · 5–6 min",
          "seconds": [
            300,
            360
          ]
        }
      ],
