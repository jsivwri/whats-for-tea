  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Bring a large saucepan of water with {{potato-salt}} salt to a boil. Peel and grate or press the garlic. Quarter, core and grate the unpeeled apple. Halve, peel and thinly slice the red onion. Cut the potatoes into 2 cm chunks, peeling if desired."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-apple-meatballs-1-sketch",
        "path": "media/pork-apple-meatballs-1-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Shape and bake the meatballs",
      "blocks": [
        "Mix the breadcrumbs, grated apple, rosemary, {{crumb-salt}} salt and half the garlic. Add the pork mince, season with pepper and mix well. Shape into five even meatballs per serving. Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "pork-apple-meatballs-2-sketch",
        "path": "media/pork-apple-meatballs-2-sketch.webp",
        "alt": "Shape and bake the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the potatoes and cabbage",
      "blocks": [
        "Boil the potatoes for 15–20 minutes until tender. Meanwhile, heat a little oil in a large frying pan over medium heat. Stir-fry the cabbage and remaining garlic for 2 minutes. Season, add a splash of water, cover with a lid or foil and cook for 3–4 minutes until just tender. Transfer to a bowl and cover to keep warm."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the potatoes",
          "seconds": [
            900,
            1200
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam the cabbage",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "pork-apple-meatballs-3-sketch",
        "path": "media/pork-apple-meatballs-3-sketch.webp",
        "alt": "Cook the potatoes and cabbage",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Fry the onions and mash the potatoes",
      "blocks": [
        "Return the frying pan to medium heat with a drizzle of oil. Season the onion and fry for 8–10 minutes until golden, stirring occasionally. Drain the cooked potatoes and return them to the saucepan off the heat. Add a knob of butter and a splash of milk if available, mash until smooth and season. Cover to keep warm."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the onions",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "pork-apple-meatballs-4-sketch",
        "path": "media/pork-apple-meatballs-4-sketch.webp",
        "alt": "Fry the onions and mash the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the onion gravy",
      "blocks": [
        "Add the balsamic vinegar and {{onion-sugar}} sugar to the onion and cook for 1–2 minutes until caramelised. Stir in the red wine stock paste and {{gravy-water}} water. Bring to a boil and simmer for 5–6 minutes until reduced. Thin with a splash of water if needed, or stir in a knob of butter."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Caramelise the onion",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the gravy",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "pork-apple-meatballs-5-sketch",
        "path": "media/pork-apple-meatballs-5-sketch.webp",
        "alt": "Make the onion gravy",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Turn the cooked meatballs in the gravy and warm through for 1–2 minutes. Serve with the mash and cabbage."
      ],
      "notes": [],
      "timers": [
        {
