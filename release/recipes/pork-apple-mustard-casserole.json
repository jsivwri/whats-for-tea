  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the produce. If your casserole is not hob-safe, start in a wide pan and transfer to an ovenproof dish with a tight foil cover."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Brown the pork",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil the kettle. Heat vegetable oil in the casserole on high. Add diced pork and salt and cook 1–2 minutes, until it starts to brown."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the pork",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "pork-apple-mustard-casserole-2",
        "path": "media/pork-apple-mustard-casserole-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork shoulder cubes browning in casserole",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Chop the vegetables and apple",
      "blocks": [
        "Trim and roughly chop the carrots. Trim the leeks, cut into thick rounds and wash away grit. Core and dice the unpeeled apples. Cut the potatoes into large bite-sized pieces."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-apple-mustard-casserole-3",
        "path": "media/pork-apple-mustard-casserole-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped carrot leek apple and potato arranged on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Add the vegetables",
      "blocks": [
        "Stir the carrots, leek, apple, potato and dried sage into the pork and cook 1–2 minutes until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Add the vegetables",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "pork-apple-mustard-casserole-4",
        "path": "media/pork-apple-mustard-casserole-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork and vegetables in casserole before stock",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Bake the casserole",
      "blocks": [
        "Add {{flour}} flour and cook for 1 minute. Stir in the stock mix and {{stock-water}} boiled water. Bring to a boil over high heat, cover and bake for 55 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the casserole",
          "seconds": [
            3300
          ]
        }
      ],
      "image": {
        "id": "pork-apple-mustard-casserole-5",
        "path": "media/pork-apple-mustard-casserole-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of casserole of pork and vegetables in stock",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Wait while it cooks",
      "blocks": [
        "Use the covered cooking time to clear up or get the table ready."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Finish with mustard and cream",
      "blocks": [
        "Stir through the mustard, most of the crème fraîche and a generous pinch of salt. Bake uncovered for another 5 minutes, until the potatoes are tender and the pork is cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish with mustard and cream",
          "seconds": [
            300
          ]
        }
      ],
