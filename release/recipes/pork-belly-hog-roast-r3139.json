  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Score the pork",
      "blocks": [
        "Heat the oven to 200°C / 180°C fan / gas mark 6 and boil the kettle. Pat the pork dry, score the fat in a crosshatch down to the meat and rub salt into the cuts."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-belly-hog-roast-r3139-1",
        "path": "media/pork-belly-hog-roast-r3139-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of scored raw pork belly",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Sear and roast",
      "blocks": [
        "Heat a wide pan until very hot. Cook the pork fat-side down for 4 minutes until crisp, then 2 minutes on the other side. Transfer to a foil-lined tray and roast 40–45 minutes until cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Sear and roast · 4 min",
          "seconds": [
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Sear and roast · 2 min",
          "seconds": [
            120
          ]
        },
        {
          "id": "timer-3",
          "label": "Sear and roast · 40–45 min",
          "seconds": [
            2400,
            2700
          ]
        }
      ],
      "image": {
        "id": "pork-belly-hog-roast-r3139-2",
        "path": "media/pork-belly-hog-roast-r3139-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of seared pork belly on foil",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Make the stuffing",
      "blocks": [
        "Finely chop the peeled shallot. Melt a large knob of butter in {{stuffing-water}} boiled water. Stir in shallot, panko, sage, salt and pepper and leave to absorb."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-belly-hog-roast-r3139-3",
        "path": "media/pork-belly-hog-roast-r3139-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of bowl of sage breadcrumb stuffing",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Bake the chips and stuffing",
      "blocks": [
        "Cut unpeeled potatoes into thin chips. Toss with oil, salt and pepper on one side of a tray and spoon the stuffing onto the other. Bake 20–25 minutes until golden and crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chips and stuffing",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
      "image": {
        "id": "pork-belly-hog-roast-r3139-4",
        "path": "media/pork-belly-hog-roast-r3139-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chips and spoonfuls of stuffing on tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make the apple sauce",
      "blocks": [
        "Peel, core and chop the apples. Add to a lidded pan with {{apple-water}} cold water and {{apple-sugar}} sugar. Cook covered over medium heat for 10–15 minutes until soft. Add butter and mash smooth."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Make the apple sauce",
          "seconds": [
            600,
            900
          ]
        }
      ],
      "image": {
        "id": "pork-belly-hog-roast-r3139-5",
        "path": "media/pork-belly-hog-roast-r3139-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of apple sauce in small pot",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Make the carrot slaw",
      "blocks": [
        "Trim, peel and grate the carrots. Trim and finely slice the spring onions. Mix with half the white wine vinegar."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-belly-hog-roast-r3139-6",
        "path": "media/pork-belly-hog-roast-r3139-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of carrot and spring onion slaw in bowl",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Warm the rolls",
      "blocks": [
        "Halve the ciabattas and warm them in the oven for 3–4 minutes. When the pork is cooked, slice into rough bite-sized pieces."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the rolls",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "pork-belly-hog-roast-r3139-7",
        "path": "media/pork-belly-hog-roast-r3139-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped pork belly on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Assemble",
      "blocks": [
        "Fill the rolls with sliced pork and stuffing, add a spoonful of apple sauce and serve with chips and carrot slaw."
      ],
      "notes": [],
