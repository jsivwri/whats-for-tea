  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the vegetables. Use a hob-safe ovenproof casserole or start in a wide pan and transfer to an ovenproof dish."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Score the pork belly",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil a kettle. Pat the pork dry. With a sharp knife, score the fatty skin in a crosshatch down to the meat and rub salt into the cuts."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-belly-winter-pot-roast-2",
        "path": "media/pork-belly-winter-pot-roast-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork belly with scored fat",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Crisp the skin",
      "blocks": [
        "Heat vegetable oil in the casserole over high heat. Fry the belly fat-side down 4 minutes until coloured and crisp. Turn and cook 2 minutes on the other side. Remove the pork and keep the dish."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Crisp the skin · 4 min",
          "seconds": [
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Crisp the skin · 2 min",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "pork-belly-winter-pot-roast-3",
        "path": "media/pork-belly-winter-pot-roast-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of crispy pork belly in casserole",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Cut the unpeeled potatoes into bite-sized pieces. Trim carrots and parsnips and cut into quarters."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-belly-winter-pot-roast-4",
        "path": "media/pork-belly-winter-pot-roast-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped potatoes carrots and parsnip on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Roast the pork",
      "blocks": [
        "Reduce the heat to medium and add carrots, parsnip, sage, {{flour}} flour and stock mix. Stir in {{gravy-water}} boiled water and Henderson’s Relish and bring to a boil. Return the pork skin-side up and roast uncovered for 45 minutes until the vegetables are tender and the pork cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the pork",
          "seconds": [
            2700
          ]
        }
      ],
      "image": {
        "id": "pork-belly-winter-pot-roast-5",
        "path": "media/pork-belly-winter-pot-roast-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork belly with carrot and parsnip in gravy",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Roast the potatoes",
      "blocks": [
        "Toss potato chunks with olive oil and salt on a tray. Roast 40–45 minutes, turning halfway, until golden and crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potatoes",
          "seconds": [
            2400,
            2700
          ]
        }
      ],
