  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Prepare the aromatics",
      "blocks": [
        "Boil the kettle. Peel and finely chop the shallots. Peel and finely chop or grate the garlic."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-fennel-red-wine-ragu-1",
        "path": "media/pork-fennel-red-wine-ragu-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped shallot and garlic on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Brown the mince and mix the stock",
      "blocks": [
        "Heat vegetable oil in a wide pan over high heat. Add mince and salt and break it up for 3–4 minutes until it starts to brown. Dissolve beef stock mix, red wine paste and tomato paste in {{stock-water}} boiled water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the mince and mix the stock",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "pork-fennel-red-wine-ragu-2",
        "path": "media/pork-fennel-red-wine-ragu-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of glass jug of red wine stock",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Soften the shallot",
      "blocks": [
        "Reduce to medium-high. Cook the shallot in the mince for 2–3 minutes until soft, then stir in garlic and fennel seeds and cook 1 minute until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the shallot · 2–3 min",
          "seconds": [
            120,
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Soften the shallot · 1 min",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "pork-fennel-red-wine-ragu-3",
        "path": "media/pork-fennel-red-wine-ragu-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of browned pork mince in pan",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Cook the pasta",
      "blocks": [
        "Boil the tortiglioni in salted water for 7–9 minutes, or 10–12 minutes for wholewheat, until it has a slight bite. Drain and keep a cup of starchy water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the pasta · 7–9 min",
          "seconds": [
            420,
            540
          ]
        },
        {
          "id": "timer-2",
          "label": "Cook the pasta · 10–12 min",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "pork-fennel-red-wine-ragu-4",
        "path": "media/pork-fennel-red-wine-ragu-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of cooked tortiglioni in colander",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Simmer the ragù",
      "blocks": [
        "Add chopped tomatoes, red wine stock and a pinch of sugar. Bring to a boil, reduce to medium-high and cook 7–8 minutes until thickened and the mince is cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the ragù",
          "seconds": [
            420,
            480
          ]
        }
      ],
