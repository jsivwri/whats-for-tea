  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Start the chips",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Cut unpeeled potatoes into thin chips, toss with vegetable oil, salt and pepper on trays and bake for 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Start the chips",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "pork-greek-cheese-keftedes-1",
        "path": "media/pork-greek-cheese-keftedes-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of skin-on chips on tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Mix the mince",
      "blocks": [
        "Peel and grate the shallots. Combine with mince, panko, half the oregano, salt and pepper. Crumble in half the Greek cheese and mix well."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-2",
        "path": "media/pork-greek-cheese-keftedes-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork mince mixture in bowl",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Bake the keftedes",
      "blocks": [
        "Shape three meatballs per person. Add beside the chips after their first 10 minutes and bake for 15–20 minutes until cooked through with no pink meat. Work in batches if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the keftedes",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "pork-greek-cheese-keftedes-3",
        "path": "media/pork-greek-cheese-keftedes-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of shaped meatballs beside chips on tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Prepare cucumber and herbs",
      "blocks": [
        "Finely dice half the cucumber and grate the rest. Peel and finely chop or grate the garlic. Strip the mint leaves from the stalks and roughly chop."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-4",
        "path": "media/pork-greek-cheese-keftedes-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of diced and grated cucumber and chopped mint on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make the tzatziki",
      "blocks": [
        "Squeeze water out of the grated cucumber. Mix with mint, garlic, yoghurt and pepper. Use less garlic for a milder result."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-5",
        "path": "media/pork-greek-cheese-keftedes-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of bowl of cucumber yoghurt tzatziki",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Prep the salad",
      "blocks": [
        "Halve the olives, cube the remaining cheese and finely dice the tomatoes."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-6",
        "path": "media/pork-greek-cheese-keftedes-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of black olives Greek cheese and tomato on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Mix the salad",
      "blocks": [
        "Gently toss the olives, cheese and tomatoes with diced cucumber, remaining oregano, olive oil and black pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-7",
        "path": "media/pork-greek-cheese-keftedes-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped Greek salad",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve",
      "blocks": [
        "Serve the keftedes and chips with the Greek-style salad and tzatziki."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-greek-cheese-keftedes-8",
        "path": "media/pork-greek-cheese-keftedes-8-sketch.webp",
        "width": 640,
