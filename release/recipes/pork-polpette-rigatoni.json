  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Make the meatballs",
      "blocks": [
        "Heat the oven to 220°C (200°C fan, gas 7). Bring a large saucepan of water with {{pasta-salt}} salt to a boil for the rigatoni. Peel and grate or press the garlic.",
        "Mix the breadcrumbs with {{crumb-salt}} salt and {{crumb-water}} water, the mixed herbs and half the garlic. Add the mince, season with pepper and mix well. Roll into five even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-polpette-rigatoni-1-sketch",
        "path": "media/pork-polpette-rigatoni-1-sketch.webp",
        "alt": "Make the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Bake and cook the pasta",
      "blocks": [
        "Spread the meatballs out on a baking tray. Bake on the top shelf for 12–15 minutes until browned and cooked through.",
        "Boil the rigatoni for 12 minutes until tender. Drain, return to the saucepan and toss with a little oil to prevent sticking."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the meatballs",
          "seconds": [
            720,
            900
          ]
        },
        {
          "id": "timer-2",
          "label": "Cook the rigatoni",
          "seconds": [
            720
          ]
        }
      ],
      "image": {
        "id": "pork-polpette-rigatoni-2-sketch",
        "path": "media/pork-polpette-rigatoni-2-sketch.webp",
        "alt": "Bake and cook the pasta",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Simmer the tomato sauce",
      "blocks": [
        "Heat a drizzle of oil in a frying pan over medium-high. Fry the remaining garlic for 1 minute, then add the oregano, passata, red wine stock paste, {{sugar}} sugar and {{sauce-water}} water. Bring to the boil and simmer over medium heat for 4–5 minutes until slightly thickened."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the garlic",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "pork-polpette-rigatoni-3-sketch",
        "path": "media/pork-polpette-rigatoni-3-sketch.webp",
        "alt": "Simmer the tomato sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Add the spinach",
      "blocks": [
        "Stir in the spinach a handful at a time until wilted and piping hot, 1–2 minutes. Stir in {{butter}} butter until melted."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "pork-polpette-rigatoni-4-sketch",
        "path": "media/pork-polpette-rigatoni-4-sketch.webp",
        "alt": "Add the spinach",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Combine",
      "blocks": [
        "Toss the meatballs, pasta and grated cheese in the sauce. Taste and season, adding a splash of water if too thick."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "pork-polpette-rigatoni-5-sketch",
        "path": "media/pork-polpette-rigatoni-5-sketch.webp",
        "alt": "Combine",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
