  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Get ready",
      "blocks": [
        "Lay out the ingredients and equipment. Wash the tomatoes. Take the chicken out of the fridge and open the packet to let it air."
      ],
      "notes": [
        "Cooking times can vary with the pan and hob. Cook the chicken through."
      ],
      "timers": []
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Chop the tomatoes",
      "blocks": [
        "Boil half a kettle. Chop the tomatoes into large bite-sized pieces."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "quick-chicken-tikka-masala-1-sketch",
        "path": "media/quick-chicken-tikka-masala-1-sketch.webp",
        "alt": "Chop the tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Fry the chicken and tomatoes",
      "blocks": [
        "Heat a generous drizzle of vegetable oil in a large, wide-based pan with a matching lid over high heat. Add the chicken and chopped tomatoes with a pinch of salt. Cook 3–4 minutes until the tomato begins to soften."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken and tomatoes",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "quick-chicken-tikka-masala-2-sketch",
