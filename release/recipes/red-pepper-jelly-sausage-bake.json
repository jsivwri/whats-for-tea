  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the sweet potato wedges",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled sweet potatoes into 2 cm wedges. Toss with oil, Mexican spice mix, salt and pepper. Spread in one layer on one or more trays and roast on the top shelf for 25–35 minutes, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the sweet potato wedges",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "red-pepper-jelly-sausage-bake-1-sketch",
        "path": "media/red-pepper-jelly-sausage-bake-1-sketch.webp",
        "alt": "Roast the sweet potato wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Add the sausages",
      "blocks": [
        "When the wedges have roasted for 5 minutes, put the sausages beside them. Return to the oven for the remaining wedge cooking time. Turn halfway and roast until the sausages are golden and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the sausages",
          "seconds": [
            1200,
            1800
          ]
        }
      ],
      "image": {
        "id": "red-pepper-jelly-sausage-bake-2-sketch",
        "path": "media/red-pepper-jelly-sausage-bake-2-sketch.webp",
        "alt": "Add the sausages",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the lettuce and lime",
      "blocks": [
        "Trim the baby gem, separate the leaves and tear into bites. Cut the lime into wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "red-pepper-jelly-sausage-bake-3-sketch",
        "path": "media/red-pepper-jelly-sausage-bake-3-sketch.webp",
        "alt": "Prepare the lettuce and lime",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Make the dressing",
      "blocks": [
        "Mix a squeeze of lime juice with {{honey}} honey and {{dressing-oil}} olive oil. Season with salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "red-pepper-jelly-sausage-bake-4-sketch",
        "path": "media/red-pepper-jelly-sausage-bake-4-sketch.webp",
        "alt": "Make the dressing",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Toss the salad and glaze the sausages",
      "blocks": [
        "Toss the lettuce in the dressing just before serving. Turn the roasted sausages in the red pepper chilli jelly to glaze evenly."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "red-pepper-jelly-sausage-bake-5-sketch",
        "path": "media/red-pepper-jelly-sausage-bake-5-sketch.webp",
        "alt": "Toss the salad and glaze the sausages",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Serve the sausages with any glaze from the tray, sweet potato wedges, salad and remaining lime wedges. Scatter the peanuts over the salad and add mayonnaise for dipping."
      ],
      "notes": [],
      "timers": [],
