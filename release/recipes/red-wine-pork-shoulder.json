  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get ready",
      "blocks": [
        "Wash the vegetables. If the casserole cannot go on the hob, start in a wide pan and transfer to an ovenproof dish covered tightly with foil."
      ],
      "notes": [],
      "timers": []
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Brown the pork",
      "blocks": [
        "Heat the oven to 200°C / 180°C fan / gas mark 6 and boil the kettle. Heat vegetable oil in the casserole on high. Add diced pork and {{flour}} flour and cook for 2–3 minutes until lightly browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the pork",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "red-wine-pork-shoulder-2",
        "path": "media/red-wine-pork-shoulder-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork shoulder cubes browning",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Halve the potatoes. Trim, peel and slice carrots diagonally. Peel and cut the red onions into wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "red-wine-pork-shoulder-3",
        "path": "media/red-wine-pork-shoulder-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of potato halves carrot slices and red onion wedges on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Make the kale parcel",
      "blocks": [
        "Wash the kale, add to foil with a splash of cold water and a knob of butter and seal tightly. Make two parcels for three or more servings."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "red-wine-pork-shoulder-4",
        "path": "media/red-wine-pork-shoulder-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of sealed kale foil parcel",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Braise the pork",
      "blocks": [
        "Turn down to medium-high. Add onions, carrots, paprika, tomato paste and bay leaves. Add chicken stock mix, red wine paste and {{pork-water}} boiled water. Bring to a boil, cover and bake 55 minutes until thickened and the pork is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Braise the pork",
          "seconds": [
            3300
          ]
        }
      ],
      "image": {
        "id": "red-wine-pork-shoulder-5",
        "path": "media/red-wine-pork-shoulder-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork and vegetables in red wine stock",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Bake the potatoes",
      "blocks": [
        "Put the potatoes in a tightly sealed foil parcel with a splash of boiled water. Use two parcels for four or more. Bake on trays 55 minutes or until tender."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the potatoes",
          "seconds": [
            3300
          ]
        }
      ],
      "image": {
        "id": "red-wine-pork-shoulder-6",
        "path": "media/red-wine-pork-shoulder-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of potato foil parcel on tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Cook kale and crush potatoes",
      "blocks": [
        "After the pork has had 45 minutes, add the kale parcel to the potato tray and bake 10–12 minutes until tender. Transfer cooked potatoes to a heatproof bowl and lightly crush with roasted garlic paste, butter, salt and pepper."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook kale and crush potatoes",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "red-wine-pork-shoulder-7",
        "path": "media/red-wine-pork-shoulder-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two foil parcels on tray",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve",
      "blocks": [
        "Discard the bay leaves. Serve pork and red wine sauce with the crushed potatoes and buttery kale."
      ],
      "notes": [],
      "timers": [],
