  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the potatoes",
      "blocks": [
        "Bring a large saucepan of water with {{potato-salt}} salt to a boil and take the steaks out of the fridge. Halve the unpeeled potatoes. Boil over medium heat for 15–20 minutes until tender, then drain."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the potatoes",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "rump-steak-caesar-salad-1",
        "path": "media/rump-steak-caesar-salad-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two-handled pot of halved potatoes",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Prepare the salad",
      "blocks": [
        "Trim and tear the baby gem. Trim, halve and cut cucumber into 1 cm half-moons. Peel and grate the garlic. Zest and halve the lemon."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "rump-steak-caesar-salad-2",
        "path": "media/rump-steak-caesar-salad-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of lettuce cucumber and lemon on board",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Make the dressing",
      "blocks": [
        "Mix aioli, lemon juice, half the cheese, half the mustard, {{dressing-water}} water and {{dressing-honey}} honey. Season with salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "rump-steak-caesar-salad-3",
        "path": "media/rump-steak-caesar-salad-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small bowl of caesar dressing",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Season the potatoes",
      "blocks": [
        "Return drained potatoes to the pan and mix with lemon zest, garlic and a knob of butter if available. Season and cover to keep warm."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "rump-steak-caesar-salad-4",
        "path": "media/rump-steak-caesar-salad-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of garlic and lemon potatoes in saucepan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Fry the steaks",
      "blocks": [
        "Heat oil in a frying pan on high. Season the steaks and fry 6–8 minutes for medium rare, turning halfway, or longer for your preference. Rest on a board under foil for a couple of minutes. Wash hands and equipment after handling raw meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the steaks",
          "seconds": [
            360,
            480
          ]
        }
      ],
      "image": {
        "id": "rump-steak-caesar-salad-5",
        "path": "media/rump-steak-caesar-salad-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two rump steaks in black frying pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve",
      "blocks": [
        "Toss the lettuce and cucumber with the dressing. Serve with steak and garlic potatoes, scatter the remaining cheese over the salad and add a dollop of mustard alongside."
      ],
      "notes": [],
      "timers": [],
