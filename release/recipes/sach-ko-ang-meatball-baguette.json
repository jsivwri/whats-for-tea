  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Pickle the carrot",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Soak the bamboo skewers in cold water. Peel and grate or press the garlic. Trim and peel the carrots, then use a peeler to shave long ribbons. Toss with rice vinegar, {{pickle-sugar}} sugar and salt, and set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sach-ko-ang-meatball-baguette-1-sketch",
        "path": "media/sach-ko-ang-meatball-baguette-1-sketch.webp",
        "alt": "Pickle the carrot",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the meatballs",
      "blocks": [
        "Mix the garlic, soy sauce, ginger, garlic and lemongrass purée, breadcrumbs and {{crumb-water}} water. Add the beef and pork mince, season and mix well. Shape into six even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sach-ko-ang-meatball-baguette-2-sketch",
        "path": "media/sach-ko-ang-meatball-baguette-2-sketch.webp",
        "alt": "Make the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake the skewers",
      "blocks": [
        "Thread the meatballs onto two skewers per serving and put them on a tray. Bake on the top shelf for 12–15 minutes until browned and cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the skewers",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "sach-ko-ang-meatball-baguette-3-sketch",
        "path": "media/sach-ko-ang-meatball-baguette-3-sketch.webp",
        "alt": "Bake the skewers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Warm the baguette",
      "blocks": [
        "Bake the baguette on the middle shelf for 10–12 minutes until golden. Cool slightly. Crush the peanuts with a rolling pin."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm the baguette",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "sach-ko-ang-meatball-baguette-4-sketch",
        "path": "media/sach-ko-ang-meatball-baguette-4-sketch.webp",
        "alt": "Warm the baguette",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the salad and glaze the meatballs",
      "blocks": [
        "Turn the cooked meatballs in {{honey}} honey. Toss the baby leaves with the carrot pickle and a drizzle of oil. Cut the baguette into serving portions and split each open."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sach-ko-ang-meatball-baguette-5-sketch",
        "path": "media/sach-ko-ang-meatball-baguette-5-sketch.webp",
        "alt": "Finish the salad and glaze the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Spread {{mayonnaise}} mayonnaise across the baguette portions. Fill with the meatball skewers and a handful of salad. Close each baguette and slide out the skewers. Serve the remaining salad alongside and finish with crushed peanuts."
      ],
      "notes": [],
      "timers": [],
