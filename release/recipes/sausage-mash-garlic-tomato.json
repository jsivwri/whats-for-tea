  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Bake the sausages",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil the kettle. Roast sausages on a foil-lined tray for 20–25 minutes until cooked through."
      ],
      "notes": [],
