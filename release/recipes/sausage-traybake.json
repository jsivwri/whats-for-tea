        "width": 620,
        "height": 305,
        "alt": "Card photograph for step 2",
        "credit": "HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Bake the sausages",
      "blocks": [
        "Put the sausages on another tray. Bake on the middle shelf for 20–25 minutes until golden brown and cooked through, turning halfway."
      ],
      "notes": [
        "Wash hands and equipment after handling raw meat. The sausages are cooked when no longer pink in the middle."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake sausages",
          "seconds": [
            1200,
            1500
          ]
        }
      ],
