  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Soften {{butter}} butter at room temperature. Halve the potatoes crossways and quarter large ones. Wrap the unpeeled garlic with a drizzle of oil in foil. Halve the cucumber lengthways and thinly slice crossways. Roughly chop the dill, stalks included."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-1-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-1-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Roast and smash the potatoes",
      "blocks": [
        "Toss the potatoes with oil, salt and pepper. Spread cut-side down on a tray with the garlic parcel. Roast on the top shelf for 20 minutes, removing the garlic after 10 minutes. Lightly crush the roasted potato halves with the bottom of a bowl. Add more oil and roast on the middle shelf for 15–20 minutes until golden and crisp."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potato halves",
          "seconds": [
            1200
          ]
        },
        {
          "id": "timer-2",
          "label": "Crisp the smashed potatoes",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-2-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-2-sketch.webp",
        "alt": "Roast and smash the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Pickle the cucumber",
      "blocks": [
        "Mix the cider vinegar, {{pickle-sugar}} sugar, salt and pepper. Toss with the cucumber and half the dill and set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-3-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-3-sketch.webp",
        "alt": "Pickle the cucumber",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Roast the salmon",
      "blocks": [
        "Lay the salmon skin-side down on a lined tray. Season and drizzle with {{honey}} honey. When the smashed potatoes have cooked for 5 minutes, roast the salmon on the top shelf for 10–15 minutes until opaque in the centre."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the salmon",
          "seconds": [
            600,
            900
          ]
        }
      ],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-4-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-4-sketch.webp",
        "alt": "Roast the salmon",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the dill garlic butter",
      "blocks": [
        "Squeeze the cooled garlic out of its skin and mash it. Mix with the softened butter, remaining dill, salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-5-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-5-sketch.webp",
        "alt": "Make the dill garlic butter",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Toss the capers through the potatoes. Top the salmon with dill garlic butter and serve with the potatoes and cucumber pickle. Stir a drizzle of oil into the leftover pickling liquid and use it to dress the baby leaves. Serve {{mayonnaise}} mayonnaise in total for dipping."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "scandi-salmon-dill-garlic-butter-6-sketch",
        "path": "media/scandi-salmon-dill-garlic-butter-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
