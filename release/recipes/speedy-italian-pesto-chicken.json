  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the potatoes",
      "blocks": [
        "Bring a large saucepan of water with {{potato-salt}} salt to a boil. Cut the unpeeled potatoes into 2 cm chunks. Halve and deseed the pepper, then slice into thin strips.",
        "Boil the potatoes for 12–15 minutes until just tender, then drain."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Boil the potatoes",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "speedy-italian-pesto-chicken-1-sketch",
        "path": "media/speedy-italian-pesto-chicken-1-sketch.webp",
        "alt": "Cook the potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Brown the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large saucepan on medium-high. Add the diced chicken and sliced pepper, season and cook for 5–6 minutes until browned, turning occasionally. Wash hands and equipment after handling raw chicken."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken and pepper",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "speedy-italian-pesto-chicken-2-sketch",
        "path": "media/speedy-italian-pesto-chicken-2-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Sizzle and stir",
      "blocks": [
        "Peel and grate or press the garlic. Once the chicken is browned, stir in the garlic and cook for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the garlic",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "speedy-italian-pesto-chicken-3-sketch",
        "path": "media/speedy-italian-pesto-chicken-3-sketch.webp",
        "alt": "Sizzle and stir",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Bring on the flavour",
      "blocks": [
        "Stir in the passata, stock paste, sun-dried tomato paste, {{sauce-sugar}} sugar and {{sauce-water}} water. Bring to a boil, then simmer 4–5 minutes until slightly thickened and the chicken is cooked through with no pink in the middle."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the sauce",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "speedy-italian-pesto-chicken-4-sketch",
        "path": "media/speedy-italian-pesto-chicken-4-sketch.webp",
        "alt": "Bring on the flavour",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Hey pesto",
      "blocks": [
        "Wilt the spinach into the sauce a handful at a time for 1–2 minutes, until piping hot. Stir in the pesto, half the cheese and {{butter}} butter. Add the drained potatoes and stir to coat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "speedy-italian-pesto-chicken-5-sketch",
        "path": "media/speedy-italian-pesto-chicken-5-sketch.webp",
        "alt": "Hey pesto",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Finish and serve",
      "blocks": [
        "Taste and season the stew, adding a splash of water if needed. Divide between bowls and sprinkle over the remaining cheese."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "speedy-italian-pesto-chicken-6-sketch",
        "path": "media/speedy-italian-pesto-chicken-6-sketch.webp",
        "alt": "Finish and serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
