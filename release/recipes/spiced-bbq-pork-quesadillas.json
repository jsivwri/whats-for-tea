  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Fry the mince and pepper",
      "blocks": [
        "Preheat the oven to 240°C (220°C fan, gas 9). Deseed the pepper and cut into 1 cm chunks. Fry the mince and pepper in a little oil over medium-high for 5–6 minutes, breaking the mince up with a spoon."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the mince",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-1-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-1-sketch.webp",
        "alt": "Fry the mince and pepper",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prepare the garlic and cheese",
      "blocks": [
        "Peel and grate or press the garlic and grate the Cheddar. Once the mince is cooked through, drain any excess fat and season."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-2-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-2-sketch.webp",
        "alt": "Prepare the garlic and cheese",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Season the filling",
      "blocks": [
        "Stir in the garlic, tomato purée, Central American spice mix and {{sauce-water}} water. Cook briefly, stirring, then stir through the BBQ sauce. Season and take off the heat."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-3-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-3-sketch.webp",
        "alt": "Season the filling",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Assemble the quesadillas",
      "blocks": [
        "Lay the tortillas on a lightly oiled tray. Spoon filling onto half of each tortilla and top with cheese. Fold the other half over and press to close."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-4-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-4-sketch.webp",
        "alt": "Assemble the quesadillas",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Bake and dress the tomatoes",
      "blocks": [
        "Rub the quesadillas with a little oil and bake on the top shelf for 4–6 minutes until golden. Cut the tomatoes into 1 cm chunks and toss with {{dressing-sugar}} sugar, {{dressing-oil}} olive oil, salt and pepper."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the quesadillas",
          "seconds": [
            240,
            360
          ]
        }
      ],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-5-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-5-sketch.webp",
        "alt": "Bake and dress the tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Serve the quesadillas with the rocket tossed through the dressed tomatoes and {{mayonnaise}} mayonnaise in total for dipping."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-bbq-pork-quesadillas-6-sketch",
        "path": "media/spiced-bbq-pork-quesadillas-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
