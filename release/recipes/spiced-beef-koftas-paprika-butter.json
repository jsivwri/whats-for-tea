  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Bake the chips",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Cut the unpeeled potatoes into 1 cm chips. Toss with oil, salt and pepper, spread in one layer on one or more trays and bake on the middle shelf for 30–35 minutes, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the chips",
          "seconds": [
            1800,
            2100
          ]
        }
      ],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-1-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-1-sketch.webp",
        "alt": "Bake the chips",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the koftas",
      "blocks": [
        "Peel and grate {{kofta-garlic}} garlic for the mince. Combine it with the spice and herb blend, breadcrumbs, {{crumb-salt}} salt and {{crumb-water}} water. Add the beef, season with pepper, mix well and shape into four mini sausages per serving. Flatten slightly."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-2-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-2-sketch.webp",
        "alt": "Make the koftas",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      },
      "quantities": {
        "kofta-garlic": {
          "2": "1 clove",
          "3": "1 clove",
          "4": "1 clove"
        }
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Bake the koftas and garlic",
      "blocks": [
        "Seal the remaining unpeeled garlic with a drizzle of oil in a foil parcel. Put it on a tray beside the koftas. Bake on the top shelf for 12–15 minutes until the koftas are browned and cooked through. Set the garlic aside to cool."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Bake the koftas",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-3-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-3-sketch.webp",
        "alt": "Bake the koftas and garlic",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Dress the cucumber and make the yoghurt sauce",
      "blocks": [
        "Cut the cucumber into 1 cm pieces. Toss with the vinegar, {{dressing-sugar}} sugar, {{dressing-oil}} olive oil, salt and pepper. Squeeze the cooled roast garlic out of its skin, mash and stir into the yoghurt. Season to taste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-4-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-4-sketch.webp",
        "alt": "Dress the cucumber and make the yoghurt sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the paprika butter",
      "blocks": [
        "Warm the chilli jelly, smoked paprika and {{butter}} butter in a large frying pan over medium heat for 1 minute. Stir, add the cooked koftas and toss for 1–2 minutes until piping hot. Thin with a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Coat the koftas",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-5-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-5-sketch.webp",
        "alt": "Make the paprika butter",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Toss the rocket through the cucumber salad. Serve the koftas over the yoghurt with the paprika butter spooned over, and chips and salad alongside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-beef-koftas-paprika-butter-6-sketch",
        "path": "media/spiced-beef-koftas-paprika-butter-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
