  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Boil a full kettle. Deseed the pepper and cut into 2 cm chunks. Cut the broccoli into thirds and halve thick stems lengthways. Peel and grate or press the garlic. Fry the garlic in a little oil in a saucepan over medium-high for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the garlic",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "spiced-chicken-pepper-bulgur-1-sketch",
        "path": "media/spiced-chicken-pepper-bulgur-1-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the bulgur",
      "blocks": [
        "Add {{bulgur-water}} boiled water, bulgur and vegetable stock paste. Return to the boil and simmer for 1 minute. Cover, take off the heat and leave for 12–15 minutes. Meanwhile, heat oil in a large frying pan over high heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "spiced-chicken-pepper-bulgur-2-sketch",
        "path": "media/spiced-chicken-pepper-bulgur-2-sketch.webp",
        "alt": "Cook the bulgur",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Fry the chicken and pepper",
      "blocks": [
        "Add the diced chicken, pepper and chermoula to taste. Season and stir-fry for 8–10 minutes until the pepper has softened and the chicken is golden and cooked through. Lower the heat if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken and pepper",
          "seconds": [
            480,
            600
          ]
        }
      ],
      "image": {
        "id": "spiced-chicken-pepper-bulgur-3-sketch",
        "path": "media/spiced-chicken-pepper-bulgur-3-sketch.webp",
        "alt": "Fry the chicken and pepper",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Add the broccoli",
      "blocks": [
        "Stir-fry the broccoli with the chicken for 2–3 minutes. Add a splash of water, cover and cook for another 4–6 minutes until tender. Season to taste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the broccoli",
          "seconds": [
            120,
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam the broccoli",
          "seconds": [
            240,
            360
          ]
        }
      ],
      "image": {
        "id": "spiced-chicken-pepper-bulgur-4-sketch",
        "path": "media/spiced-chicken-pepper-bulgur-4-sketch.webp",
        "alt": "Add the broccoli",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Combine",
      "blocks": [
        "Fluff the bulgur, stir through harissa to taste and gently mix into the chicken and vegetables."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "spiced-chicken-pepper-bulgur-5-sketch",
        "path": "media/spiced-chicken-pepper-bulgur-5-sketch.webp",
        "alt": "Combine",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
