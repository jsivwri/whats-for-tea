  "steps": [
    {
      "heading": "Roast the cabbage",
      "blocks": [
        "Heat a large tray at 200°C / 180°C fan / gas mark 6. Trim 2 cm off the rounded top of each cabbage. Cut {{rounds}} rounds, 2–3 cm thick, and discard the woody cores.",
        "Brush both sides with {{oil-first}} olive oil in total and season with salt. Roast in a single layer on the hot tray on the middle shelf for 20 minutes."
      ],
      "notes": [],
