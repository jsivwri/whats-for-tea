        "id": "sticky-beef-broccoli-noodles-7-sketch",
        "path": "media/sticky-beef-broccoli-noodles-7-sketch.webp",
        "alt": "Toss everything together",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Divide between bowls and scatter over the remaining spring onions and toasted sesame seeds."
      ],
