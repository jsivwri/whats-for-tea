  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Chop the aromatics",
      "blocks": [
        "Peel the garlic and ginger. Halve and deseed the chilli. Finely chop the garlic, ginger and chilli to taste. Trim and finely slice the spring onions."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sticky-beef-broccoli-noodles-1-sketch",
        "path": "media/sticky-beef-broccoli-noodles-1-sketch.webp",
        "alt": "Chop the aromatics",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the aromatics",
      "blocks": [
        "Boil a kettle. Heat a generous drizzle of vegetable oil in a wide frying pan over medium-high. Fry the garlic, ginger and chilli for 1–2 minutes until fragrant."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the aromatics",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "sticky-beef-broccoli-noodles-2-sketch",
        "path": "media/sticky-beef-broccoli-noodles-2-sketch.webp",
        "alt": "Fry the aromatics",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Brown the beef",
      "blocks": [
        "Add the beef and {{five-spice}} five-spice mix. Fry for 4–5 minutes until the mince starts to brown, breaking it up with a wooden spoon."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the beef",
          "seconds": [
            240,
            300
          ]
        }
      ],
      "image": {
        "id": "sticky-beef-broccoli-noodles-3-sketch",
        "path": "media/sticky-beef-broccoli-noodles-3-sketch.webp",
        "alt": "Brown the beef",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Mix the sticky sauce",
      "blocks": [
        "Whisk the cornflour with {{sauce-water}} cold water, then stir in the hoisin, rice vinegar, soy sauce and {{sugar}} sugar."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sticky-beef-broccoli-noodles-4-sketch",
        "path": "media/sticky-beef-broccoli-noodles-4-sketch.webp",
        "alt": "Mix the sticky sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Prepare the broccoli",
      "blocks": [
        "Halve the Tenderstem broccoli."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sticky-beef-broccoli-noodles-5-sketch",
        "path": "media/sticky-beef-broccoli-noodles-5-sketch.webp",
        "alt": "Prepare the broccoli",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Boil the noodles and broccoli",
      "blocks": [
        "Cover the noodles and broccoli with boiling water in a saucepan. Bring back to the boil over high heat and cook for about 5 minutes until tender. Drain, saving a cup of the cooking water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles and broccoli",
          "seconds": [
            300
          ]
        }
      ],
      "image": {
        "id": "sticky-beef-broccoli-noodles-6-sketch",
        "path": "media/sticky-beef-broccoli-noodles-6-sketch.webp",
        "alt": "Boil the noodles and broccoli",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Toss everything together",
      "blocks": [
        "Pour the sticky sauce into the browned beef with half the spring onions. Cook for 3–4 minutes until the beef is cooked through, then add the drained noodles and broccoli and toss. Loosen with a splash of the cooking water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish cooking the beef",
          "seconds": [
            180,
            240
          ]
        }
      ],
