  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the bulgur",
      "blocks": [
        "Bring {{bulgur-water}} water and half the chicken stock paste to a boil. Stir in the bulgur, return to a boil and simmer 1 minute. Cover off the heat for 12–15 minutes or until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
