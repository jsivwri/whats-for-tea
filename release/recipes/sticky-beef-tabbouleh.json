    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Fry the beef",
      "blocks": [
        "Heat a dry frying pan over medium-high. Brown the mince for 5–6 minutes, breaking it up and draining any excess fat. Season and cook through until no pink remains. Wash hands and equipment after handling raw mince."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the beef",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "sticky-beef-tabbouleh-2",
        "path": "media/sticky-beef-tabbouleh-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of browned crumbled beef mince in black frying pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Halve the tomatoes. Trim and cut the cucumber into 1 cm pieces. Peel and grate the garlic. Quarter the prunes and roughly chop the parsley, including stalks."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sticky-beef-tabbouleh-3",
        "path": "media/sticky-beef-tabbouleh-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of chopped garlic tomatoes prunes parsley and cucumber on board",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Simmer the sauce",
      "blocks": [
        "Stir garlic, chermoula and tomato purée into the beef for 1 minute. Add pomegranate molasses, prunes, remaining stock paste, {{sauce-sugar}} sugar and {{sauce-water}} water. Bring to a boil, simmer 3–4 minutes until slightly reduced and season to taste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the sauce · 1 min",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the sauce · 3–4 min",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "sticky-beef-tabbouleh-4",
        "path": "media/sticky-beef-tabbouleh-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of sticky red spiced beef in pan",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Finish the tabbouleh",
      "blocks": [
        "Fluff up the bulgur with a fork and stir in tomatoes, cucumber and half the parsley. Taste and season."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sticky-beef-tabbouleh-5",
        "path": "media/sticky-beef-tabbouleh-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of cooked bulgur with tomato and cucumber",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Serve",
      "blocks": [
