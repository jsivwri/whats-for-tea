  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables and cashews",
      "blocks": [
        "Deseed and thinly slice the pepper. Cut the mangetout into thirds. Peel and grate the garlic and ginger. Toast the cashews in a dry frying pan over medium heat for 2–3 minutes, stirring regularly, then transfer to a bowl."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Toast the cashews",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-1-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-1-sketch.webp",
        "alt": "Prepare the vegetables and cashews",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the noodles",
      "blocks": [
        "Bring a saucepan of water with {{noodle-salt}} salt to a boil. Cook the noodles for 4 minutes, drain and rinse under cold water."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the noodles",
          "seconds": [
            240
          ]
        }
      ],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-2-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-2-sketch.webp",
        "alt": "Cook the noodles",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Stir-fry the chicken",
      "blocks": [
        "Return the frying pan to medium-high with a drizzle of oil. Fry the chicken and pepper for 8–10 minutes until the chicken is golden and cooked through and the pepper has softened. Stir in the garlic and ginger and fry for 1 minute."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the chicken and pepper",
          "seconds": [
            480,
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-3-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-3-sketch.webp",
        "alt": "Stir-fry the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Mix the hoisin glaze",
      "blocks": [
        "Stir together the hoisin, honey, soy sauce and {{sauce-water}} water. If the honey is too stiff, warm its container in a bowl of hot water for 1 minute."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-4-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-4-sketch.webp",
        "alt": "Mix the hoisin glaze",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Toss together",
      "blocks": [
        "Add the noodles, mangetout and glaze to the chicken. Toss for 2–3 minutes until piping hot and the sauce coats the noodles. Taste and adjust seasoning, adding a splash of water if needed."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Finish the stir-fry",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-5-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-5-sketch.webp",
        "alt": "Toss together",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Divide the noodles between bowls and scatter over the toasted cashews."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "stir-fried-hoisin-chicken-noodles-6-sketch",
        "path": "media/stir-fried-hoisin-chicken-noodles-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
