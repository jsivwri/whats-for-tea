  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Bake the salmon",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7 and boil a full kettle. Put the fillets skin-side down on a lined baking tray, drizzle with oil and season.",
        "Roast on the top shelf for 10–15 minutes, until opaque in the middle. Wash hands and equipment after handling raw fish."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the salmon",
          "seconds": [
            600,
            900
          ]
        }
      ],
