  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the sweet potato",
      "blocks": [
        "Heat the oven to 220°C. Cut the unpeeled sweet potatoes into 1 cm cubes. Toss with oil, salt and pepper and spread in a single layer on one or more baking trays. Roast on the top shelf for 18–20 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the sweet potato",
          "seconds": [
            1080,
            1200
          ]
        }
      ],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-1-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-1-sketch.webp",
        "alt": "Roast the sweet potato",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Brown the chicken",
      "blocks": [
        "Meanwhile, heat a drizzle of oil in a frying pan over medium-high. Season the chicken and stir-fry for 3–4 minutes until browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the chicken",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-2-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-2-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Prepare the aromatics",
      "blocks": [
        "Halve, peel and thinly slice the shallot. Peel and grate or press the garlic. Thinly slice half the chilli and finely chop the rest. Zest and halve the lime."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-3-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-3-sketch.webp",
        "alt": "Prepare the aromatics",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Cook the shallot",
      "blocks": [
        "Stir the shallot into the chicken and fry for 3–4 minutes until it starts to soften. Add the garlic, ginger purée, finely chopped chilli to taste and tomato purée. Fry for 1 minute, then stir in the coconut milk, {{stew-water}} water and stock paste."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Soften the shallot",
          "seconds": [
            180,
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the aromatics",
          "seconds": [
            60
          ]
        }
      ],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-4-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-4-sketch.webp",
        "alt": "Cook the shallot",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer and finish",
      "blocks": [
        "Bring to a boil and simmer for 3–4 minutes until slightly reduced and the chicken is cooked through. Add the spinach a handful at a time and cook for 1–2 minutes until wilted and piping hot. Take off the heat and stir in a squeeze of lime juice and half the soy sauce. Taste, add more lime or soy sauce if needed and stir in the roasted sweet potato."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the stew",
          "seconds": [
            180,
            240
          ]
        },
        {
          "id": "timer-2",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-5-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-5-sketch.webp",
        "alt": "Simmer and finish",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Spoon into bowls. Finish with lime zest and sliced chilli to taste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "sweet-potato-ginger-garlic-chicken-stew-6-sketch",
        "path": "media/sweet-potato-ginger-garlic-chicken-stew-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
