  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Marinate the chicken",
      "blocks": [
        "Preheat the oven to 220°C (200°C fan, gas 7). Peel and grate or press the garlic. Toss the chicken with the garlic, korma paste, half the yoghurt and salt. Set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "tandoori-chicken-traybake-1-sketch",
        "path": "media/tandoori-chicken-traybake-1-sketch.webp",
        "alt": "Marinate the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prepare the potatoes and pepper",
      "blocks": [
        "Cut the unpeeled potatoes into 2 cm chunks. Deseed the green pepper and cut into 2 cm pieces."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "tandoori-chicken-traybake-2-sketch",
        "path": "media/tandoori-chicken-traybake-2-sketch.webp",
        "alt": "Prepare the potatoes and pepper",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Roast the spiced potatoes",
      "blocks": [
        "Toss the potato chunks with oil, salt, pepper and tandoori masala. Spread in one layer on one or more trays and roast on the top shelf for 25–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the spiced potatoes",
          "seconds": [
            1500,
            2100
          ]
        }
      ],
      "image": {
        "id": "tandoori-chicken-traybake-3-sketch",
        "path": "media/tandoori-chicken-traybake-3-sketch.webp",
        "alt": "Roast the spiced potatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Roast the chicken and peppers",
      "blocks": [
        "Toss the green pepper with oil, salt and pepper on one side of a large tray. Lay the marinated chicken on the other side. Roast on the middle shelf for 16–18 minutes, turning halfway, until the chicken is cooked through and the pepper is golden."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken",
          "seconds": [
            960,
            1080
          ]
        }
      ],
      "image": {
        "id": "tandoori-chicken-traybake-4-sketch",
        "path": "media/tandoori-chicken-traybake-4-sketch.webp",
        "alt": "Roast the chicken and peppers",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Dress the tomatoes",
      "blocks": [
        "Halve the baby plum tomatoes, season and toss with {{dressing-oil}} olive oil."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "tandoori-chicken-traybake-5-sketch",
        "path": "media/tandoori-chicken-traybake-5-sketch.webp",
        "alt": "Dress the tomatoes",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Serve with the roasted peppers and spiced potatoes. Spoon over the dressed tomatoes and drizzle with the remaining yoghurt."
      ],
      "notes": [],
