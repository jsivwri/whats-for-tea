  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Get prepped",
      "blocks": [
        "Preheat the oven to 220°C / 200°C fan / gas mark 7. Chop the potatoes into 2 cm chunks without peeling. Halve any thick broccoli stems lengthways."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "teriyaki-chicken-traybake-1-sketch",
        "path": "media/teriyaki-chicken-traybake-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Get prepped",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Roast the potatoes",
      "blocks": [
        "Put the potatoes on a large baking tray. Drizzle with oil, season with salt and pepper and toss with the sesame seeds. Spread out in a single layer. Use two trays if needed.",
        "Roast on the middle shelf for 30–35 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the potatoes",
          "seconds": [
            1800,
            2100
          ]
        }
      ],
      "image": {
        "id": "teriyaki-chicken-traybake-2-sketch",
        "path": "media/teriyaki-chicken-traybake-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Roast the potatoes",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Spice up the chicken",
      "blocks": [
        "Meanwhile, lay the chicken on another baking tray. Sprinkle with the Thai style spice mix, drizzle with oil and season with salt and pepper."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "teriyaki-chicken-traybake-3-sketch",
        "path": "media/teriyaki-chicken-traybake-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Spice up the chicken",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Ready, steady, roast",
      "blocks": [
        "Roast the chicken on the top shelf for 25–30 minutes until cooked through and no longer pink in the middle."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "teriyaki-chicken-traybake-4-sketch",
        "path": "media/teriyaki-chicken-traybake-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Ready, steady, roast",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Broccoli time",
      "blocks": [
        "When the potatoes and chicken have 10–12 minutes left, add the broccoli and pea pods to the potato tray. Drizzle with oil, season and toss to coat. Spread everything out and roast for the remaining time."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the greens",
          "seconds": [
            600,
            720
          ]
        }
      ],
