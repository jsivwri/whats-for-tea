  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the brown rice",
      "blocks": [
        "Rinse the rice and cover with plenty of cold water. Bring to the boil, reduce to medium and cook for 15–20 minutes until tender with a slight bite. Drain, return to the pot and cover to keep warm."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the brown rice",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-1-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-1-sketch.webp",
        "alt": "Cook the brown rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prepare the aromatics",
      "blocks": [
        "Boil a kettle. Peel and roughly chop the shallot and garlic. Halve and deseed the chilli, then finely chop. Halve the lime and finely chop the coriander, keeping the leaves and stalks separate."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-2-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-2-sketch.webp",
        "alt": "Prepare the aromatics",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Make the Thai paste and coconut stock",
      "blocks": [
        "Pound the shallot, garlic, chilli to taste, coriander stalks and a pinch of salt to a paste in a mortar, or use a food processor. Dissolve the coconut cream in {{stock-water}} boiling water and add the soy sauce."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-3-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-3-sketch.webp",
        "alt": "Make the Thai paste and coconut stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Brown the chicken",
      "blocks": [
        "Heat {{chicken-oil}} vegetable oil in a wide frying pan over medium-high. Fry the chicken for 3 minutes per side until browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            180
          ]
        }
      ],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-4-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-4-sketch.webp",
        "alt": "Brown the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer in coconut stock",
      "blocks": [
        "Stir the Thai paste into the chicken and fry for 2–3 minutes until fragrant. Reduce to medium, add the coconut stock and cook for 10–12 minutes until the chicken is cooked through and the sauce thickens. Squeeze in the juice from half the limes and cut the rest into wedges."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry the paste",
          "seconds": [
            120,
            180
          ]
        },
        {
          "id": "timer-2",
          "label": "Simmer the chicken",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-5-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-5-sketch.webp",
        "alt": "Simmer in coconut stock",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Prepare the greens",
      "blocks": [
        "Deseed and thinly slice the pepper. Halve the mangetout lengthways. Peel and finely chop or grate the ginger."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-6-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-6-sketch.webp",
        "alt": "Prepare the greens",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 7,
      "id": "step-7",
      "heading": "Stir-fry the ginger greens",
      "blocks": [
        "Heat {{greens-oil}} vegetable oil in a second wide frying pan over high heat. Add the pepper, kale, mangetout and a pinch of salt and fry for 4–6 minutes. Add the ginger and fry for another 1–2 minutes until the greens are tender with a slight bite."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Stir-fry the greens",
          "seconds": [
            240,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Fry the ginger",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "thai-chicken-ginger-greens-brown-rice-7-sketch",
        "path": "media/thai-chicken-ginger-greens-brown-rice-7-sketch.webp",
        "alt": "Stir-fry the ginger greens",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 8,
      "id": "step-8",
      "heading": "Serve",
      "blocks": [
        "Thinly slice the chicken and serve with brown rice and ginger greens. Spoon over the Thai sauce and finish with coriander leaves and lime wedges."
      ],
      "notes": [],
      "timers": [],
