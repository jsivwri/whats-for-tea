  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Season the pork",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Pat the pork dry, score the skin down to the meat in a crosshatch and rub salt into the cuts. Season the rest of the pork with five-spice."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-crispy-pork-belly-1",
        "path": "media/thai-crispy-pork-belly-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of scored raw pork belly",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Sear the pork",
      "blocks": [
        "Heat a wide pan on high. Sear the pork skin-side down 5 minutes until crisp, then cook 2 minutes on the other side. Place skin-side up on two stacked sheets of foil."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Sear the pork · 5 min",
          "seconds": [
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Sear the pork · 2 min",
          "seconds": [
            120
          ]
        }
      ],
      "image": {
        "id": "thai-crispy-pork-belly-2",
        "path": "media/thai-crispy-pork-belly-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of seared pork belly on foil",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Roast in foil",
      "blocks": [
        "Loosely fold the foil up around the pork, leaving the skin exposed. Put it on a tray, pour {{pork-water}} cold water around the pork and roast for 45 minutes until crisp, tender and cooked through with no pink meat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast in foil",
          "seconds": [
            2700
          ]
        }
      ],
      "image": {
        "id": "thai-crispy-pork-belly-3",
        "path": "media/thai-crispy-pork-belly-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of pork belly in open foil parcel",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Prepare the vegetables",
      "blocks": [
        "Peel the carrots, then peel them into ribbons. Finely chop the peeled shallots, slice the spring onions and finely chop the coriander including its stalks."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-crispy-pork-belly-4",
        "path": "media/thai-crispy-pork-belly-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of carrot ribbons shallot spring onion and coriander on board",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Make dressing and salad",
      "blocks": [
        "Mix chilli flakes, soy sauce, fish sauce, half the lime juice, shallot, spring onion and {{dressing-sugar}} sugar for the nam jim jaew. Toss carrot ribbons with most of the coriander and the remaining lime juice."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-crispy-pork-belly-5",
        "path": "media/thai-crispy-pork-belly-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of bowl of dark nam jim jaew and bowl of carrot ribbons",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Rinse and boil the rice",
      "blocks": [
        "When the pork has 25 minutes left, rinse sushi rice under cold running water for 30 seconds and drain. Bring to a boil in a lidded pan with {{rice-water}} cold water and a small pinch of salt."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-crispy-pork-belly-6",
        "path": "media/thai-crispy-pork-belly-6-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of white sushi rice in pot",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-7",
      "number": 7,
      "heading": "Cook and rest the rice",
      "blocks": [
        "Reduce to a gentle simmer, cover and cook 15 minutes. Remove from the heat and leave covered for another 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook and rest the rice · 15 min",
          "seconds": [
            900
          ]
        },
        {
          "id": "timer-2",
          "label": "Cook and rest the rice · 10 min",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "thai-crispy-pork-belly-7",
        "path": "media/thai-crispy-pork-belly-7-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of rice saucepan with lid",
        "credit": "Illustration based on the Gousto recipe card"
      }
    },
    {
      "id": "step-8",
      "number": 8,
      "heading": "Serve",
      "blocks": [
        "Slice the crispy pork and serve over sticky rice with carrot salad. Spoon over the nam jim jaew and finish with the remaining coriander."
      ],
      "notes": [],
      "timers": [],
