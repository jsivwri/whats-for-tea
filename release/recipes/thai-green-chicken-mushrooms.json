  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the rice",
      "blocks": [
        "Boil half a kettle. Pour {{rice-water}} boiled water into a large saucepan with {{rice-salt}} salt and heat on high. Add the rice and cook for 12–13 minutes.",
        "Drain in a sieve, return to the pan and cover until ready to serve."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
