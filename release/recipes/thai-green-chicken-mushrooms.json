      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Fry the mushrooms",
      "blocks": [
        "Heat a drizzle of oil in another large saucepan over medium-high heat. Add the mushrooms, season and cook for 3–4 minutes until lightly browned."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the mushrooms",
          "seconds": [
            180,
            240
          ]
