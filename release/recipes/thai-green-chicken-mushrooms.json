    {
      "number": 3,
      "id": "step-3",
      "heading": "Lime time",
      "blocks": [
        "Cut the lime into wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-green-chicken-mushrooms-3-sketch",
        "path": "media/thai-green-chicken-mushrooms-3-sketch.webp",
        "alt": "Lime time",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Curry up",
      "blocks": [
        "Stir the chicken, coconut milk, Thai spice blend, green curry paste, chicken stock paste and {{sugar}} sugar into the browned mushrooms. Use less spice blend if you prefer a milder curry.",
        "Bring to a boil, lower the heat and simmer for 10–12 minutes, until the chicken is cooked through with no pink in the middle. Wash hands and equipment after handling raw chicken and its packaging."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "thai-green-chicken-mushrooms-4-sketch",
        "path": "media/thai-green-chicken-mushrooms-4-sketch.webp",
        "alt": "Curry up",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Finish the curry",
      "blocks": [
        "Squeeze in half the lime juice. Taste and season, and add a splash of water if needed."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-green-chicken-mushrooms-5-sketch",
