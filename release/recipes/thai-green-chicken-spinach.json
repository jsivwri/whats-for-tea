  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Cook the rice",
      "blocks": [
        "Boil half a kettle. Pour the kettle water into a saucepan with {{rice-salt}} salt. Bring to the boil on high, add the jasmine rice and cook for 12–13 minutes. Drain, return to the pan and cover until serving."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            720,
            780
          ]
        }
      ],
      "image": {
        "id": "thai-green-chicken-spinach-1-sketch",
        "path": "media/thai-green-chicken-spinach-1-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Make the curry sauce",
      "blocks": [
        "Peel and grate or press the garlic. Heat a drizzle of oil in a large saucepan over medium-high. Stir-fry the garlic and Thai green paste for 30 seconds. Stir in the coconut milk and vegetable stock paste."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-green-chicken-spinach-2-sketch",
        "path": "media/thai-green-chicken-spinach-2-sketch.webp",
        "alt": "Make the curry sauce",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Cook the chicken",
      "blocks": [
        "Add the chicken and bring to a boil. Reduce the heat and simmer for 10–12 minutes, until the sauce has thickened and the chicken is cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the chicken",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "thai-green-chicken-spinach-3-sketch",
        "path": "media/thai-green-chicken-spinach-3-sketch.webp",
        "alt": "Cook the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Prepare the lime",
      "blocks": [
        "Meanwhile, zest and halve the lime."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-green-chicken-spinach-4-sketch",
        "path": "media/thai-green-chicken-spinach-4-sketch.webp",
        "alt": "Prepare the lime",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Add the spinach",
      "blocks": [
        "Add the spinach a handful at a time. Cook for 1–2 minutes until wilted and piping hot. Add some lime juice and thin with a splash of water if needed. Taste and adjust the seasoning and lime, then remove from the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Wilt the spinach",
          "seconds": [
            60,
            120
          ]
        }
      ],
      "image": {
        "id": "thai-green-chicken-spinach-5-sketch",
        "path": "media/thai-green-chicken-spinach-5-sketch.webp",
        "alt": "Add the spinach",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Fluff the rice with the lime zest. Divide among bowls, spoon over the curry and finish with chilli flakes to taste. Serve with the remaining lime cut into wedges."
      ],
      "notes": [],
      "timers": [],
