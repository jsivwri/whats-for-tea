  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Peel and thinly slice the shallot. Trim the carrot and slice into 1 cm rounds. Cut the courgette into 2 cm chunks and thinly slice the spring onion. Zest and halve the lime. Dry-fry the courgette over high heat for 6–8 minutes, turning every 2 minutes, then set aside."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Char the courgette",
          "seconds": [
            360,
            480
          ]
        }
      ],
      "image": {
        "id": "thai-yellow-beef-meatballs-1-sketch",
        "path": "media/thai-yellow-beef-meatballs-1-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Cook the rice",
      "blocks": [
        "Mix {{rice-water}} cold water, the rice and {{rice-salt}} salt in a saucepan with a tight-fitting lid. Cover and bring to a boil over medium-high. Turn the heat to its lowest setting and cook for 10 minutes. Take off the heat and leave covered for another 10 minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam off the heat",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "thai-yellow-beef-meatballs-2-sketch",
        "path": "media/thai-yellow-beef-meatballs-2-sketch.webp",
        "alt": "Cook the rice",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Shape the meatballs",
      "blocks": [
        "Mix the panko with {{crumb-water}} water, lime zest and Thai spice blend to taste. Add the beef, season and mix well. Shape into five even meatballs per serving."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thai-yellow-beef-meatballs-3-sketch",
        "path": "media/thai-yellow-beef-meatballs-3-sketch.webp",
        "alt": "Shape the meatballs",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Brown the meatballs and fry the vegetables",
      "blocks": [
        "Return the frying pan to medium-high with a little oil. Fry the meatballs for 5–6 minutes, turning every 2 minutes, then set aside. Add a drizzle of oil if needed and fry the carrot and shallot, stirring frequently, for 5–6 minutes until soft."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown the meatballs",
          "seconds": [
            300,
            360
          ]
        },
        {
          "id": "timer-2",
          "label": "Soften the vegetables",
          "seconds": [
            300,
            360
          ]
        }
      ],
      "image": {
        "id": "thai-yellow-beef-meatballs-4-sketch",
        "path": "media/thai-yellow-beef-meatballs-4-sketch.webp",
        "alt": "Brown the meatballs and fry the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Simmer the curry",
      "blocks": [
        "Stir in the yellow curry paste and fry for 1 minute. Return the meatballs and add the coconut milk, {{curry-water}} water and stock paste. Season, bring to the boil and simmer for 6–7 minutes until the sauce thickens and the meatballs are cooked through."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            360,
            420
          ]
        }
      ],
      "image": {
        "id": "thai-yellow-beef-meatballs-5-sketch",
        "path": "media/thai-yellow-beef-meatballs-5-sketch.webp",
        "alt": "Simmer the curry",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Finish and serve",
      "blocks": [
        "Stir in the courgette and heat for 1 minute. Thin with a splash of water if needed. Take off the heat, stir in half the lime juice and adjust the seasoning and lime to taste. Serve over fluffed jasmine rice and scatter over the spring onions."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Heat the courgette",
          "seconds": [
            60
          ]
        }
      ],
