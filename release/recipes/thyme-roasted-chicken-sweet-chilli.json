  "steps": [
    {
      "number": 1,
      "id": "step-1",
      "heading": "Roast the wedges",
      "blocks": [
        "Preheat the oven to 200°C. Cut the unpeeled potatoes into 2 cm wedges. Toss with oil, salt, pepper. Spread in a single layer on one or more baking trays. Roast on the middle shelf for 30–40 minutes until golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the wedges",
          "seconds": [
            1800,
            2400
          ]
        }
      ],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-1-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-1-sketch.webp",
        "alt": "Roast the wedges",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 2,
      "id": "step-2",
      "heading": "Prepare the vegetables",
      "blocks": [
        "Peel and wedge the red onion. Trim and halve the unpeeled carrots lengthways, then cut into 1 cm by 5 cm batons. Deseed the pepper and slice it into 1 cm strips. Roughly chop the parsley, including its stalks."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-2-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-2-sketch.webp",
        "alt": "Prepare the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 3,
      "id": "step-3",
      "heading": "Marinate the chicken and roast the vegetables",
      "blocks": [
        "Mix the chicken with {{marinade-oil}} olive oil, half the dried thyme, salt and pepper. Set aside. Toss the onion, carrots and peppers on a tray with oil, the remaining thyme, salt and pepper. Roast on the top shelf for 25–30 minutes until soft and golden, turning halfway."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the vegetables",
          "seconds": [
            1500,
            1800
          ]
        }
      ],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-3-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-3-sketch.webp",
        "alt": "Marinate the chicken and roast the vegetables",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 4,
      "id": "step-4",
      "heading": "Brown and roast the chicken",
      "blocks": [
        "While the vegetables roast, brown the chicken in a little oil over medium-high for 3–5 minutes per side. After the vegetables have roasted for 10 minutes, put the chicken on top and roast for the remaining 15–20 minutes until cooked through. Transfer the cooked chicken to a board and rest loosely covered with foil. Keep the frying pan for the glaze."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            180,
            300
          ]
        },
        {
          "id": "timer-2",
          "label": "Roast the chicken",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-4-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-4-sketch.webp",
        "alt": "Brown and roast the chicken",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 5,
      "id": "step-5",
      "heading": "Make the glaze",
      "blocks": [
        "Return the frying pan to medium heat. Add {{glaze-water}} water and the stock paste, bring to the boil, then simmer for 1–2 minutes. Stir in the sweet chilli sauce and simmer for 3–4 minutes until glossy and thickened. Take off the heat."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the stock",
          "seconds": [
            60,
            120
          ]
        },
        {
          "id": "timer-2",
          "label": "Thicken the glaze",
          "seconds": [
            180,
            240
          ]
        }
      ],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-5-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-5-sketch.webp",
        "alt": "Make the glaze",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    },
    {
      "number": 6,
      "id": "step-6",
      "heading": "Serve",
      "blocks": [
        "Cut each breast into five slices. Toss the wedges and roasted vegetables with the parsley, then serve with the chicken. Reheat the glaze with a splash of water if needed and spoon over."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "thyme-roasted-chicken-sweet-chilli-6-sketch",
        "path": "media/thyme-roasted-chicken-sweet-chilli-6-sketch.webp",
        "alt": "Serve",
        "width": 640,
        "height": 480,
        "credit": "Illustration based on the printed recipe card"
      }
    }
  ],
