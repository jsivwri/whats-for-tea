  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Start prepping",
      "blocks": [
        "Preheat the oven to 220°C / 200°C fan / gas mark 7. Halve the baby plum tomatoes and toss with {{sugar}} sugar and {{olive-oil-dressing}} olive oil. Season and set aside.",
        "Peel and grate or press the garlic. Halve and peel the red onion and cut each half into 5 wedges."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "turkish-spiced-chicken-bulgur-1-sketch",
        "path": "media/turkish-spiced-chicken-bulgur-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Start prepping",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Sear the chicken",
      "blocks": [
        "Heat a drizzle of oil in a large frying pan on medium-high heat. Season the chicken and brown for 5 minutes on each side.",
        "Move the chicken to a baking tray with the onion. Add the spice and herb blend, a drizzle of oil, {{honey}} honey and half the garlic. Toss to coat. Wash hands and equipment after handling raw chicken."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Brown each side",
          "seconds": [
            300
          ]
        }
      ],
      "image": {
        "id": "turkish-spiced-chicken-bulgur-2-sketch",
        "path": "media/turkish-spiced-chicken-bulgur-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sear the chicken",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Time to roast",
      "blocks": [
        "Roast the chicken and onion on the top shelf for 10–12 minutes until the chicken is cooked through and the onion is tender. Cover with foil and rest for a couple of minutes."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Roast the chicken and onion",
          "seconds": [
            600,
            720
          ]
        }
      ],
      "image": {
        "id": "turkish-spiced-chicken-bulgur-3-sketch",
        "path": "media/turkish-spiced-chicken-bulgur-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Time to roast",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Bulgur time",
      "blocks": [
        "Meanwhile, heat a drizzle of oil in a large saucepan over medium heat. Stir-fry the tomato purée and remaining garlic for 30 seconds.",
        "Add {{bulgur-water}} water and the stock paste and bring to the boil. Stir in the bulgur, return to the boil and simmer for 1 minute. Cover, remove from the heat and leave for 12–15 minutes or until ready to serve."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the bulgur",
          "seconds": [
            60
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam the bulgur",
          "seconds": [
            720,
            900
          ]
        }
      ],
      "image": {
        "id": "turkish-spiced-chicken-bulgur-4-sketch",
        "path": "media/turkish-spiced-chicken-bulgur-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Bulgur time",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Add the parsley",
      "blocks": [
        "Chop the parsley, stalks and all. Stir half into the cooked bulgur and season if needed."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "turkish-spiced-chicken-bulgur-5-sketch",
        "path": "media/turkish-spiced-chicken-bulgur-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Add the parsley",
        "credit": "Illustration based on the HelloFresh card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Finish and serve",
      "blocks": [
        "Slice the chicken 1 cm thick. Divide the bulgur between bowls, spoon over the dressed tomatoes and juices, then add the chicken and roasted onion. Drizzle over the yoghurt and scatter with the remaining parsley."
      ],
      "notes": [],
      "timers": [],
