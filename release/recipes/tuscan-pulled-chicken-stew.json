  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Fry chicken and onion",
      "blocks": [
        "Heat the oven to 220°C / 200°C fan / gas mark 7. Halve, peel and thinly slice the onion. Halve tomatoes and cut chicken thighs in half widthways. Stir-fry chicken and onion in oil in a wide ovenproof pan over medium heat for 6–8 minutes until browned and softened. Wash hands and equipment after handling raw chicken."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Fry chicken and onion",
          "seconds": [
            360,
            480
          ]
        }
      ],
