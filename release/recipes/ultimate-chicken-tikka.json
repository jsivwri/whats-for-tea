  "steps": [
    {
      "id": "step-1",
      "number": 1,
      "heading": "Cook the rice",
      "blocks": [
        "If you’ll warm the naans in the oven, preheat it to 220°C / 200°C fan / gas mark 7.",
        "Pour {{line-19}} water into a medium saucepan with a tight lid. Stir in the rice and {{rice-salt}} salt and bring to the boil. Turn the heat to medium and cover.",
        "Cook for 10 minutes. Remove from the heat and leave covered for another 10 minutes, or until serving, to finish steaming."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook rice",
          "seconds": [
            600
          ]
        },
        {
          "id": "timer-2",
          "label": "Steam rice",
          "seconds": [
            600
          ]
        }
      ],
      "image": {
        "id": "ultimate-chicken-tikka-1",
        "path": "media/ultimate-chicken-tikka-1-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small round saucepan of cooked white rice with handle angled lower left",
        "credit": "Illustration based on the HelloFresh recipe card"
      },
      "quantities": {
        "rice-salt": {
          "2": "¼ tsp",
          "3": "¼ tsp",
          "4": "¼ tsp"
        }
      }
    },
    {
      "id": "step-2",
      "number": 2,
      "heading": "Prep the vegetables",
      "blocks": [
        "Meanwhile, take {{line-20}} butter out of the fridge. Peel and grate or press the garlic.",
        "Trim the cucumber and cut into 1 cm pieces. Chop the tomato into 1 cm pieces and cut the lemon into wedges.",
        "Combine {{line-15}} sugar, {{line-16}} olive oil and a squeeze of lemon in a bowl. Season with salt and pepper, toss in the cucumber and tomato, and set aside."
      ],
      "notes": [],
      "timers": [],
      "image": {
        "id": "ultimate-chicken-tikka-2",
        "path": "media/ultimate-chicken-tikka-2-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of bowl of diced cucumber and tomato salad",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-3",
      "number": 3,
      "heading": "Build the flavour",
      "blocks": [
        "Heat a drizzle of oil in a large pan over medium-high heat. Add the tikka masala paste, tomato purée and half the garlic. Stir for 2–3 minutes.",
        "Add the chicken, {{line-17}} sugar and {{line-18}} water. Bring to the boil, lower the heat and season with salt and pepper."
      ],
      "notes": [
        "A stronger smell when first opened can come from the chicken packaging."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Cook the paste",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "ultimate-chicken-tikka-3",
        "path": "media/ultimate-chicken-tikka-3-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of frying pan with diced chicken in a red curry sauce",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-4",
      "number": 4,
      "heading": "Simmer and make the raita",
      "blocks": [
        "Cover and simmer for 15–20 minutes until the sauce thickens and the chicken is cooked through with no pink in the middle.",
        "Meanwhile pick the mint leaves, discard the stalks and roughly chop the leaves. Mix the mint with the yoghurt and season with salt and pepper."
      ],
      "notes": [
        "Wash hands and equipment after handling raw chicken or its packaging."
      ],
      "timers": [
        {
          "id": "timer-1",
          "label": "Simmer the curry",
          "seconds": [
            900,
            1200
          ]
        }
      ],
      "image": {
        "id": "ultimate-chicken-tikka-4",
        "path": "media/ultimate-chicken-tikka-4-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of small round bowl of white raita flecked with chopped green mint",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-5",
      "number": 5,
      "heading": "Toast the naans",
      "blocks": [
        "A few minutes before serving, halve the naans widthways and toast until golden.",
        "If using the oven, place them on a baking tray, sprinkle with a little water and warm through for 2–3 minutes.",
        "Spread the warm naans with {{line-20}} butter and the remaining garlic. Season with salt."
      ],
      "notes": [],
      "timers": [
        {
          "id": "timer-1",
          "label": "Warm naans in oven",
          "seconds": [
            120,
            180
          ]
        }
      ],
      "image": {
        "id": "ultimate-chicken-tikka-5",
        "path": "media/ultimate-chicken-tikka-5-sketch.webp",
        "width": 640,
        "height": 480,
        "alt": "Sketch of two oval naans next to each other on a rectangular baking tray",
        "credit": "Illustration based on the HelloFresh recipe card"
      }
    },
    {
      "id": "step-6",
      "number": 6,
      "heading": "Finish and serve",
      "blocks": [
        "Stir crème fraîche into the curry, bring it to the boil and remove from the heat. Taste and adjust the seasoning.",
        "Fluff the rice with a fork and divide between bowls. Top with chicken tikka and flaked almonds.",
        "Serve the tomato and cucumber salad, mint raita, mango chutney and garlic naans on the side."
      ],
      "notes": [],
      "timers": [],
